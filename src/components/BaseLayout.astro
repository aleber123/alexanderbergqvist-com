---
import '../styles/global.css';
import SEO from './SEO.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Analytics from './Analytics.astro';
import StickyAppCta from './StickyAppCta.astro';
import { getCollection, getEntry } from 'astro:content';
import { appSectionForPath, appStoreIdFromUrl } from '../lib/app-section';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  keywords?: string[];
  noindex?: boolean;
  /** Explicit Smart App Banner id. Optional: pages under an app section
   *  (/<app>/…, /<lang>/<app>/…, mapped /verktyg/ calculators, /f/) get
   *  it derived centrally from the pathname — see lib/app-section.ts. */
  appStoreId?: string;
  /** Override the app this page belongs to (slug). Normally derived
   *  from the pathname. */
  app?: string;
  /** BCP-47 language code for the `<html lang>` attribute. Defaults to
   *  Swedish since most pages are sv. Localized pages pass 'en-US',
   *  'de-DE', etc. to keep screen readers + search engines aligned. */
  htmlLang?: string;
  /** Whether to render hreflang alternates pointing at the same page
   *  in other locales. The localized [lang]/* pages turn this on with
   *  their alternates map. */
  hreflangAlternates?: Record<string, string>;
}

const { htmlLang = 'sv', hreflangAlternates, app: appOverride, ...props } = Astro.props;

/* Which app does this page belong to? Derived centrally so the Smart
   App Banner and the sticky mobile CTA appear on every app-section page
   exactly once, without each page having to remember a prop. */
const section = appSectionForPath(Astro.url.pathname);
const appSlug = appOverride ?? section?.app;
let appEntry = appSlug ? await getEntry('apps', appSlug) : undefined;
if (!appEntry && props.appStoreId) {
  appEntry = (await getCollection('apps')).find(
    (a) => appStoreIdFromUrl(a.data.appStoreUrl) === props.appStoreId,
  );
}
const appIsLive = appEntry?.data.status === 'live' && !!appEntry?.data.appStoreUrl;
const smartBannerId =
  props.appStoreId ?? (appIsLive ? appStoreIdFromUrl(appEntry!.data.appStoreUrl) : undefined);
const pageLang = section?.lang ?? 'sv';

/* Display face — Instrument Serif (SIL OFL), headings only. Body copy
   stays in the system stack, so all 163 MDX articles keep rendering
   instantly and there is no FOIT on the content that carries the SEO.

   `?url` makes Vite emit each woff2 to /_astro/<name>.<hash>.woff2, the
   only path Vercel serves `immutable`. Self-hosted rather than
   fonts.googleapis.com: that is a render-blocking request to a third
   origin returning CSS that requests a fourth origin, and Chrome has
   partitioned the HTTP cache by top-level site since 2020 — "someone
   else already downloaded it" has been false for six years.

   unicode-range splits mean the Latin-Ext file is fetched only for
   Polish and the italic only where italic display type is used (the
   homepage hero). Latin is the one preloaded file. */
const latin = (await import('../fonts/instrument-serif-latin.woff2?url')).default;
const latinExt = (await import('../fonts/instrument-serif-latin-ext.woff2?url')).default;
const italic = (await import('../fonts/instrument-serif-italic-latin.woff2?url')).default;

// font-display: swap, never `block` (or the default `auto`, which is
// block in Chrome): LCP is a text node on every page archetype here and
// LCP cannot fire on text that hasn't painted. Never `optional` either —
// on a cold cache the browser abandons the face for that page load, so
// first-time search visitors would see the unbranded version while a
// warm local cache shows the branded one.
const fontFaces = `
@font-face{font-family:"Instrument Serif";font-style:normal;font-weight:400;font-display:swap;src:url(${latin}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Instrument Serif";font-style:normal;font-weight:400;font-display:swap;src:url(${latinExt}) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:"Instrument Serif";font-style:italic;font-weight:400;font-display:swap;src:url(${italic}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
`.trim();
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Above <Analytics /> on purpose: gtag is ~130 KB async in head, and
        while the preload is Highest priority the parser still discovers
        in document order. Font first. Only the Latin roman is preloaded;
        Latin-Ext and italic load on demand via unicode-range. */}
    <link rel="preload" href={latin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    {/* htmlLang was destructured here and never forwarded, so SEO.astro
        fell back to Swedish for og:locale, inLanguage and hreflang on
        every translated page. */}
    <script is:inline>
      // Before first paint, so iOS-only CTAs never flash on Android.
      if (/Android/i.test(navigator.userAgent)) document.documentElement.classList.add('is-android');
    </script>
    <SEO
      {...props}
      appStoreId={smartBannerId}
      hreflangAlternates={hreflangAlternates}
      locale={htmlLang.includes('-') ? htmlLang : 'sv-SE'}
    />
    <Analytics />
  </head>
  <body class="min-h-screen flex flex-col">
    <script is:inline define:vars={{ pageLang: htmlLang.split('-')[0] }}>
      // Remember which lang this user actually browsed in. The Vercel
      // edge redirect from `/` to `/<lang>/` only fires when this
      // cookie is missing — so once set (here, on any page load), we
      // never auto-redirect them again. Lets manual lang choices stick.
      document.cookie = `preferred_lang=${pageLang}; path=/; max-age=${60 * 60 * 24 * 365}; samesite=lax`;
    </script>
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    {appIsLive && appEntry && (
      <StickyAppCta
        app={appEntry.id}
        name={appEntry.data.name}
        tagline={appEntry.data.tagline}
        icon={appEntry.data.icon}
        appStoreUrl={appEntry.data.appStoreUrl!}
        lang={pageLang}
      />
    )}
  </body>
</html>
