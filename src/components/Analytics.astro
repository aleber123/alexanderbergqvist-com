---
/**
 * Vercel Web Analytics (cookieless) + App Store click events.
 *
 * Replaced Google Analytics 4 on 2026-09-30: GA set cookies and loaded
 * without consent, which IMY has found non-compliant. Vercel Web
 * Analytics sets no cookies and stores no personal data — visitors are
 * counted with a hash of the request that rotates daily, and only
 * aggregated numbers are shown — so no consent banner is needed.
 *
 * The script is served first-party from /_vercel/insights/script.js
 * once Web Analytics is enabled for the project in the Vercel dashboard
 * (Project → Analytics → Enable). Until then the request 404s and
 * nothing is tracked; the page is unaffected.
 *
 * Page views are automatic. On top of that every click on an App Store
 * link sends a custom event:
 *
 *   app_store_click { app, position, page }
 *
 *   app      — app slug (e.g. 'tidrapport'), from the numeric App Store id
 *   position — data-cta-position on the link (hero/inline/body/footer/
 *              sticky/result/qr/banner), falling back to the `ct` prefix
 *              stamped by src/lib/appstore.ts
 *   page     — location.pathname
 *
 * Custom events are only recorded on Vercel Pro/Enterprise. On Hobby the
 * call is a harmless no-op and page views still work.
 *
 * Rollback note: the old GA4 property was read from PUBLIC_GA_ID; the
 * previous implementation is in git history (commit 87e6fda).
 */
import { getCollection } from 'astro:content';
import { appStoreIdFromUrl } from '../lib/app-section';

const enabled = import.meta.env.PROD;

// Numeric App Store id → app slug, so events carry a readable app name.
const apps = await getCollection('apps');
const appById: Record<string, string> = {};
for (const a of apps) {
  const id = appStoreIdFromUrl(a.data.appStoreUrl);
  if (id) appById[id] = a.id;
}
---

{enabled && (
  <>
    <script is:inline>
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
    <script is:inline define:vars={{ appById }}>
      var POSITIONS = ['hero', 'inline', 'body', 'footer', 'sticky', 'result', 'qr', 'banner'];
      document.addEventListener(
        'click',
        function (e) {
          var a = e.target instanceof Element ? e.target.closest('a[href]') : null;
          if (!a) return;
          try {
            var url = new URL(a.href);
            if (url.hostname.indexOf('apps.apple.com') === -1) return;
            var id = (url.pathname.match(/\/id(\d+)/) || [])[1] || '';
            var ctPrefix = (url.searchParams.get('ct') || '').split('_')[0];
            var position =
              a.getAttribute('data-cta-position') ||
              (POSITIONS.indexOf(ctPrefix) !== -1 ? ctPrefix : 'unknown');
            window.va('event', {
              name: 'app_store_click',
              data: {
                app: appById[id] || id || 'unknown',
                position: position,
                page: window.location.pathname,
              },
            });
          } catch (err) {}
        },
        { capture: true },
      );
    </script>
  </>
)}
