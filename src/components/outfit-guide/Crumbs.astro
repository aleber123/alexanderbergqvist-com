---
/** Editorial breadcrumbs + BreadcrumbList JSON-LD. Last item = current page. */
interface Crumb {
  name: string;
  url?: string;
}
interface Props {
  trail: Crumb[];
}
const { trail } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    ...(c.url ? { item: new URL(c.url, Astro.site).href } : {}),
  })),
};
---

<nav class="og-crumbs og-wrap" aria-label="Breadcrumb">
  <ol>
    {trail.map((c) => (
      <li>{c.url ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
