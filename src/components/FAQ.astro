---
/**
 * FAQ block — renders both visible accordion AND FAQPage JSON-LD
 * schema for rich snippets in Google. Crucial for ranking long-tail
 * Q&A queries.
 */
interface QA {
  q: string;
  a: string;
}
interface Props {
  title?: string;
  items: QA[];
}

const { title = 'Vanliga frågor', items } = Astro.props;
const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: i.a,
    },
  })),
};
---

<section class="my-10">
  <h2 class="text-2xl font-black mb-6">{title}</h2>
  <div class="space-y-3">
    {items.map((qa) => (
      <details class="rounded-xl border border-slate-200 bg-white p-5 group">
        <summary
          class="cursor-pointer font-bold text-slate-900 list-none flex items-start justify-between gap-4"
        >
          <span>{qa.q}</span>
          <svg
            class="w-5 h-5 flex-shrink-0 text-slate-400 transition-transform group-open:rotate-180"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            />
          </svg>
        </summary>
        <div class="mt-3 text-slate-700 leading-relaxed" set:html={qa.a} />
      </details>
    ))}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(ldJson)} />
