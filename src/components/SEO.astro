---
/**
 * Centralized <head> meta — every page should use this through BaseLayout.
 * Includes OpenGraph, Twitter, canonical, and JSON-LD where relevant.
 */
interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  keywords?: string[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  image = '/og-default.png',
  type = 'website',
  publishedAt,
  updatedAt,
  keywords = [],
  noindex = false,
} = Astro.props;

const siteName = 'Alexander Bergqvist';
const fullTitle = title === siteName ? title : `${title} – ${siteName}`;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<link rel="canonical" href={url} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={imageUrl} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="sv_SE" />
{publishedAt && (
  <meta property="article:published_time" content={publishedAt.toISOString()} />
)}
{updatedAt && (
  <meta property="article:modified_time" content={updatedAt.toISOString()} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<meta name="theme-color" content="#0f172a" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
