---
import { getCollection } from 'astro:content';
const apps = (await getCollection('apps')).sort(
  (a, b) => a.data.order - b.data.order
);
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface-2 mt-20">
  <div class="max-w-6xl mx-auto px-6 py-12 grid grid-cols-1 md:grid-cols-4 gap-8 text-sm">
    <div class="md:col-span-2">
      <div class="font-black text-lg">Alexander Bergqvist</div>
      <p class="text-ink-2 mt-2 max-w-md">
        Indie iOS-utvecklare från Sverige. Bygger appar som löser konkreta
        vardagsproblem — från VAB-koll till snusfri-räkning.
      </p>
    </div>
    <div>
      <div class="font-bold mb-3">Appar</div>
      <ul class="space-y-2 text-ink-2">
        {apps.map((a) => (
          <li>
            <a href={`/${a.id}/`} class="hover:text-ink">{a.data.name}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <div class="font-bold mb-3">Mer</div>
      <ul class="space-y-2 text-ink-2">
        <li><a href="/blog/" class="hover:text-ink">Blog</a></li>
        <li><a href="/om/" class="hover:text-ink">Om mig</a></li>
        <li>
          <a href="mailto:alexander.bergqvist@gmail.com" class="hover:text-ink">Kontakt</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line py-4 text-center text-xs text-ink-3">
    © {year} Alexander Bergqvist
  </div>
</footer>
