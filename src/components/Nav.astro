---
import { LOCALES, t, type Locale } from '../i18n/locales';

/* Swedish pages live at the root and keep the Swedish menu. Localized
   pages (/en/, /de/, …) only have a home page with the app list and the
   app pages themselves, so their menu links there plus back to Swedish. */
interface Props {
  lang?: string;
}
const path = Astro.url.pathname;
// The first path segment decides (also covers /<lang>/ home pages,
// which have no app section); the prop is the fallback.
const { lang = 'sv' } = Astro.props;
const isLocale = (l: string): l is Locale => (LOCALES as readonly string[]).includes(l);
const seg = path.split('/')[1] ?? '';
const locale = isLocale(seg) ? seg : isLocale(lang) ? lang : undefined;
const isActive = (prefix: string) =>
  prefix === '/' ? path === '/' : path.startsWith(prefix);
---

<header class="border-b border-line bg-surface/90 backdrop-blur-md sticky top-0 z-40">
  <div
    class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3"
  >
    <a
      href={locale ? `/${locale}/` : '/'}
      class="font-black text-[15px] sm:text-base tracking-tight whitespace-nowrap text-ink hover:text-ink-2 transition"
    >
      Alexander Bergqvist
    </a>
    {locale ? (
    <nav class="flex items-center gap-3 sm:gap-8 text-[13px] sm:text-sm font-bold tracking-tight whitespace-nowrap">
      <a href={`/${locale}/#apps`} class="text-ink-3 hover:text-ink transition">
        {t(locale).ui.appsTitle}
      </a>
      <a href="/" hreflang="sv" lang="sv" class="text-ink-3 hover:text-ink transition">
        Svenska
      </a>
    </nav>
    ) : (
    <nav class="flex items-center gap-3 sm:gap-8 text-[13px] sm:text-sm font-bold tracking-tight whitespace-nowrap">
      <a
        href="/appar/"
        class={isActive('/appar')
          ? 'text-ink'
          : 'text-ink-3 hover:text-ink transition'}
      >
        Appar
      </a>
      <a
        href="/verktyg/"
        class={isActive('/verktyg')
          ? 'text-ink'
          : 'text-ink-3 hover:text-ink transition'}
      >
        Räknare
      </a>
      <a
        href="/blog/"
        class={isActive('/blog')
          ? 'text-ink'
          : 'text-ink-3 hover:text-ink transition'}
      >
        Skriver
      </a>
      {/* Hidden below 400px so the header stays on one line on phones
          (the footer links "Om mig" too). */}
      <a
        href="/om/"
        class={`hidden min-[400px]:inline ${isActive('/om')
          ? 'text-ink'
          : 'text-ink-3 hover:text-ink transition'}`}
      >
        Om
      </a>
    </nav>
    )}
  </div>
</header>
