---
const path = Astro.url.pathname;
const isActive = (prefix: string) =>
  prefix === '/' ? path === '/' : path.startsWith(prefix);
---

<header class="border-b border-line bg-surface/90 backdrop-blur-md sticky top-0 z-40">
  <div
    class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3"
  >
    <a
      href="/"
      class="font-black text-[15px] sm:text-base tracking-tight whitespace-nowrap text-ink hover:text-ink-2 transition"
    >
      Alexander Bergqvist
    </a>
    <nav class="flex items-center gap-3 sm:gap-8 text-[13px] sm:text-sm font-bold tracking-tight whitespace-nowrap">
      <a
        href="/appar/"
        class={isActive('/appar')
          ? 'text-ink'
          : 'text-ink-3 hover:text-ink transition'}
      >
        Appar
      </a>
      <a
        href="/verktyg/"
        class={isActive('/verktyg')
          ? 'text-ink'
          : 'text-ink-3 hover:text-ink transition'}
      >
        Räknare
      </a>
      <a
        href="/blog/"
        class={isActive('/blog')
          ? 'text-ink'
          : 'text-ink-3 hover:text-ink transition'}
      >
        Skriver
      </a>
      {/* Hidden below 400px so the header stays on one line on phones
          (the footer links "Om mig" too). */}
      <a
        href="/om/"
        class={`hidden min-[400px]:inline ${isActive('/om')
          ? 'text-ink'
          : 'text-ink-3 hover:text-ink transition'}`}
      >
        Om
      </a>
    </nav>
  </div>
</header>
