---
/**
 * App Store download button. Auto-tags every URL with Apple's
 * `pt` (provider token) + `ct` (campaign) query params so we get
 * per-source-page attribution in App Store Connect → App Analytics
 * → Sources → Web Referrers.
 *
 * The pt is a constant label for our web property. The ct is
 * derived from the current pathname (or overridden via prop) so
 * each landing page gets its own campaign bucket in ASC.
 *
 * GA4 outbound-click tracking lives in Analytics.astro and fires
 * client-side — separate concern, doesn't depend on these tags.
 */
interface Props {
  url?: string;
  status?: 'live' | 'soon' | 'beta';
  variant?: 'dark' | 'light';
  /** Override the auto-derived campaign tag (ct). Useful when the
   *  badge appears on a dynamically-routed page where we want a
   *  more meaningful campaign name than the raw slug. */
  campaign?: string;
}

const { url, status = 'live', variant = 'dark', campaign } = Astro.props;
const isLight = variant === 'light';
const disabled = status !== 'live' || !url;

// Constant for ALL App Store links across alex.com — Apple groups
// installs by `pt` in ASC, so keeping it constant makes the "web"
// channel visible as a single source. Per Apple, max 40 chars.
const PROVIDER_TOKEN = 'alexbergqvist-com';

/** Sluggify a pathname into a campaign tag Apple accepts:
 *    /fodelsedagar/aldersrakna/ → fodelsedagar_aldersrakna
 *    /                          → home
 *  Apple's ct field is at most 40 chars; we truncate from the end
 *  so the most-specific segment is preserved. */
function pathToCampaign(pathname: string): string {
  const cleaned = pathname.replace(/^\/+|\/+$/g, '').replace(/[^a-zA-Z0-9-]+/g, '_');
  if (!cleaned) return 'home';
  return cleaned.length > 40 ? cleaned.slice(-40) : cleaned;
}

function withAttribution(rawUrl: string): string {
  try {
    const u = new URL(rawUrl);
    if (!u.hostname.includes('apps.apple.com')) return rawUrl;
    // Don't double-tag if caller already set their own.
    if (!u.searchParams.has('pt')) u.searchParams.set('pt', PROVIDER_TOKEN);
    if (!u.searchParams.has('ct')) {
      const ct = campaign ?? pathToCampaign(Astro.url.pathname);
      u.searchParams.set('ct', ct);
    }
    // `mt=8` is Apple's legacy "this is an app" marker — some attribution
    // tools still look for it. Cheap to include.
    if (!u.searchParams.has('mt')) u.searchParams.set('mt', '8');
    return u.toString();
  } catch {
    return rawUrl;
  }
}

const taggedUrl = url ? withAttribution(url) : undefined;
---

{
  disabled ? (
    <span
      class={`inline-flex items-center gap-2 rounded-xl px-4 py-3 font-bold text-sm cursor-not-allowed ${
        isLight
          ? 'bg-white/20 text-white/80'
          : 'bg-slate-200 text-slate-500'
      }`}
    >
      <svg viewBox="0 0 384 512" class="w-4 h-4 fill-current">
        <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
      </svg>
      Kommer snart
    </span>
  ) : (
    <a
      href={taggedUrl}
      class={`inline-flex items-center gap-3 rounded-xl px-5 py-3 font-bold text-sm transition hover:scale-[1.02] ${
        isLight
          ? 'bg-white text-slate-900 hover:bg-slate-100'
          : 'bg-slate-900 text-white hover:bg-slate-800'
      }`}
    >
      <svg viewBox="0 0 384 512" class="w-5 h-5 fill-current">
        <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
      </svg>
      <span class="flex flex-col items-start leading-tight">
        <span class="text-[10px] font-medium opacity-80">Ladda ner i</span>
        <span class="text-base font-bold">App Store</span>
      </span>
    </a>
  )
}
