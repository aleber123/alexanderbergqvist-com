---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import AppCard from '../components/AppCard.astro';

const apps = (await getCollection('apps')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Alexander Bergqvist"
  description="Indie iOS-utvecklare från Sverige. Bygger appar som löser konkreta vardagsproblem — från VAB-koll till snusfri-räkning. Här hittar du alla mina appar och fria verktyg."
  keywords={[
    'iOS appar',
    'svenska appar',
    'indie utvecklare',
    'snusfri kalkylator',
    'surdeg recept',
    'tidrapport app',
    'vab koll',
  ]}
>
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-24">
    <div class="max-w-3xl">
      <span
        class="inline-block text-xs font-black uppercase tracking-widest text-slate-500 mb-4"
        >Indie iOS-utvecklare · Sverige</span
      >
      <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-[1.05]">
        Jag bygger appar som löser
        <span class="bg-gradient-to-r from-blue-600 to-violet-600 bg-clip-text text-transparent">
          riktiga vardagsproblem.
        </span>
      </h1>
      <p class="mt-6 text-lg md:text-xl text-slate-600 leading-relaxed">
        Från VAB-dagar och tidrapport till surdeg och snusfri-räkning — här är
        appar och fria verktyg som faktiskt används av människor i Sverige varje
        dag.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/appar/"
          class="rounded-xl bg-slate-900 text-white px-5 py-3 font-bold text-sm hover:bg-slate-700"
          >Se alla appar</a
        >
        <a
          href="/snusfri-resa/kalkylator/"
          class="rounded-xl border border-slate-300 px-5 py-3 font-bold text-sm hover:border-slate-500"
          >Räkna sparade snus-kr →</a
        >
      </div>
    </div>
  </section>

  <section class="bg-slate-50 border-y border-slate-200 py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-end justify-between mb-8">
        <h2 class="text-2xl md:text-3xl font-black">Apparna</h2>
        <a
          href="/appar/"
          class="text-sm font-bold text-slate-700 hover:text-slate-900"
          >Alla {apps.length} →</a
        >
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {apps.slice(0, 6).map((app) => <AppCard app={app} />)}
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <div>
        <h2 class="text-2xl md:text-3xl font-black mb-4">Fria verktyg</h2>
        <p class="text-slate-600 text-lg leading-relaxed">
          Räknare och kalkylatorer som fungerar direkt i webbläsaren — utan
          inloggning eller appinstall. Bra för dig som vill ha snabba svar.
        </p>
      </div>
      <div class="space-y-3">
        <a
          href="/snusfri-resa/kalkylator/"
          class="block rounded-2xl border border-slate-200 p-5 hover:border-slate-300 hover:shadow-lg transition"
        >
          <div class="font-bold">Snusfri-kalkylator</div>
          <div class="text-sm text-slate-600 mt-1">
            Hur mycket sparar du på att sluta snusa? Räkna ut exakt belopp per
            dag, månad och år.
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
