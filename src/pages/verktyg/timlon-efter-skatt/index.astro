---
import VerktygLayout from '../../../components/VerktygLayout.astro';

const inputCls =
  'w-full rounded-xl border border-line-strong bg-surface px-4 py-3 text-lg font-bold aria-[invalid=true]:border-ink aria-[invalid=true]:border-2';

const faq = [
  {
    q: 'Hur mycket får jag ut efter skatt på min timlön?',
    a: 'Multiplicera timlönen med antal timmar per månad, lägg till eventuell semesterersättning (12 %) och dra av skatten. Med 180 kr i timmen och 160 timmar blir bruttolönen 28 800 kr. Med 12 % semesterersättning och 32 % kommunalskatt blir det cirka 26 000 kr efter skatt, eller runt 163 kr per arbetad timme.',
  },
  {
    q: 'Varför skiljer sig nettolönen från mitt lönebesked?',
    a: 'Räknaren använder samma regler som Skatteverkets skattetabeller för 2026 (grundavdrag, jobbskatteavdrag, statlig skatt, begravnings- och public service-avgift), men räknar som om du tjänar lika mycket varje månad hela året. Varierar dina timmar, eller betalar du kyrkoavgift eller har jämkning, blir avdraget på lönebeskedet annorlunda. Skattetabellerna avrundar dessutom lönen i steg om 100–200 kr.',
  },
  {
    q: 'Vad är min kommunalskatt?',
    a: 'Kommunalskatten (kommun + region) ligger mellan ungefär 29 och 35 procent beroende på var du är folkbokförd, med ett snitt runt 32 procent. Du hittar din exakta skattesats på ditt lönebesked eller hos Skatteverket.',
  },
  {
    q: 'Ska semesterersättningen räknas med i timlönen?',
    a: 'Om du är timanställd och inte tar ut betald semester får du oftast minst 12 % semesterersättning ovanpå lönen. Den beskattas som vanlig lön. Är du månadsanställd med betald semester ska du stänga av valet.',
  },
  {
    q: 'Vad är jobbskatteavdraget?',
    a: 'En skattereduktion för alla som har arbetsinkomst. Den minskar den kommunala skatten och är störst för låga och medelhöga inkomster – med 32 % kommunalskatt och 30 000 kr i månaden ungefär 3 200 kr i månaden. Den ingår automatiskt i skattetabellerna och i den här räknaren.',
  },
  {
    q: 'När betalar man statlig skatt 2026?',
    a: 'När den beskattningsbara inkomsten är över 643 000 kr om året. Med grundavdraget motsvarar det en lön på ungefär 55 000 kr i månaden. Statlig skatt är 20 % på den del som ligger över gränsen och räknas med här.',
  },
];
---

<VerktygLayout
  title="Timlön efter skatt – räkna ut din nettolön per timme"
  description="Räkna timlön efter skatt 2026: timlön × timmar, semesterersättning 12 %, kommunalskatt, grundavdrag och jobbskatteavdrag. Se nettolön per månad och per timme."
  keywords={['timlön efter skatt', 'räkna timlön efter skatt', 'nettolön timlön', 'timlön netto', 'lön efter skatt timanställd']}
  h1="Timlön efter skatt"
  intro="Fyll i timlön, timmar per månad och kommunalskatt – så ser du vad du får ut efter skatt 2026."
  crumb="Timlön efter skatt"
  faq={faq}
  app="tidrapport"
  ctaTitle="Koll på varje timme med Tidrapportera"
  ctaText="Som timanställd är lönen bara så rätt som dina timmar. Tidrapportera loggar arbetspass med ett tryck och summerar veckan och månaden – så att du kan jämföra med lönebeskedet. Inget konto."
  disclaimer="Uppskattning för 2026 för dig under 66 år, räknad som om du tjänar lika mycket varje månad hela året. Följer Skatteverkets beräkningsregler för skattetabellerna, men ditt faktiska skatteavdrag kan skilja sig, t.ex. vid varierande inkomst, jämkning eller sidoinkomster."
>
  <form
    id="skatt-form"
    class="mt-6 rounded-2xl border border-line bg-surface p-4 sm:p-6 md:p-8"
    novalidate
    onsubmit="return false"
  >
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-bold mb-2" for="timlon">Timlön (kr, brutto)</label>
        <input id="timlon" type="text" inputmode="decimal" autocomplete="off" value="180" aria-describedby="timlon-fel" class={inputCls} />
        <p id="timlon-fel" hidden class="mt-1 text-sm font-bold text-ink">⚠ Skriv ett tal, t.ex. 185,50</p>
      </div>
      <div>
        <label class="block text-sm font-bold mb-2" for="timmar">Timmar per månad</label>
        <input id="timmar" type="text" inputmode="decimal" autocomplete="off" value="160" aria-describedby="timmar-fel" class={inputCls} />
        <p id="timmar-fel" hidden class="mt-1 text-sm font-bold text-ink">⚠ Skriv ett tal, t.ex. 120</p>
      </div>
      <div>
        <label class="block text-sm font-bold mb-2" for="skatt">Kommunalskatt (%)</label>
        <input id="skatt" type="text" inputmode="decimal" autocomplete="off" value="32" aria-describedby="skatt-hint skatt-fel" class={inputCls} />
        <p id="skatt-hint" class="mt-1 text-xs text-ink-3">Kommun + region, ca 29–35 %.</p>
        <p id="skatt-fel" hidden class="mt-1 text-sm font-bold text-ink">⚠ Skriv ett tal, t.ex. 32,4</p>
      </div>
      <div>
        <label class="block text-sm font-bold mb-2" for="kyrka">Kyrkoavgift (%)</label>
        <input id="kyrka" type="text" inputmode="decimal" autocomplete="off" value="0" aria-describedby="kyrka-hint kyrka-fel" class={inputCls} />
        <p id="kyrka-hint" class="mt-1 text-xs text-ink-3">0 om du inte är medlem. Ofta ca 1 %.</p>
        <p id="kyrka-fel" hidden class="mt-1 text-sm font-bold text-ink">⚠ Skriv ett tal, t.ex. 1,03</p>
      </div>
      <div class="col-span-2">
        <label class="flex items-start gap-3 cursor-pointer" for="semester">
          <input id="semester" type="checkbox" checked class="mt-1 w-5 h-5 flex-shrink-0 accent-ink" />
          <span class="text-sm font-bold">
            Lägg till semesterersättning 12 %
            <span class="block font-normal text-xs text-ink-3">För timanställda utan betald semester</span>
          </span>
        </label>
      </div>
    </div>
  </form>

  <section aria-labelledby="skatt-resultat" class="mt-6">
    <h2 id="skatt-resultat" class="sr-only">Resultat</h2>
    <div aria-live="polite" aria-atomic="true">
      <dl class="grid grid-cols-2 gap-3">
        <div class="rounded-2xl bg-surface-2 border border-line p-4">
          <dt class="text-xs font-black uppercase tracking-widest text-ink-3">Bruttolön</dt>
          <dd class="mt-1 text-xl font-black" data-out="brutto">–</dd>
        </div>
        <div class="rounded-2xl bg-surface-2 border border-line p-4">
          <dt class="text-xs font-black uppercase tracking-widest text-ink-3">Semester&shy;ersättning</dt>
          <dd class="mt-1 text-xl font-black" data-out="semester">–</dd>
        </div>
        <div class="rounded-2xl bg-surface-2 border border-line p-4">
          <dt class="text-xs font-black uppercase tracking-widest text-ink-3">Skatt / mån</dt>
          <dd class="mt-1 text-xl font-black" data-out="skatt">–</dd>
          <dd class="text-xs text-ink-3" data-out="skattprocent"></dd>
        </div>
        <div class="rounded-2xl bg-surface-2 border border-line p-4">
          <dt class="text-xs font-black uppercase tracking-widest text-ink-3">Varav jobbskatte&shy;avdrag</dt>
          <dd class="mt-1 text-xl font-black" data-out="jsa">–</dd>
          <dd class="text-xs text-ink-3">sänker skatten / mån</dd>
        </div>
        <div class="col-span-2 rounded-2xl bg-ink text-on-ink p-5">
          <dt class="text-xs font-black uppercase tracking-widest text-on-ink-2">Efter skatt per månad (ca)</dt>
          <dd class="mt-1 text-3xl font-black" data-out="netto">–</dd>
          <dd class="text-sm text-on-ink-2" data-out="nettotimme"></dd>
        </div>
      </dl>
      <details class="mt-3 rounded-xl border border-line p-4 text-sm text-ink-2">
        <summary class="cursor-pointer font-bold text-ink">Så blev skatten (per år)</summary>
        <dl class="mt-3 grid grid-cols-[1fr_auto] gap-x-4 gap-y-1" data-out="specifikation"></dl>
      </details>
    </div>
  </section>

  <Fragment slot="forklaring">
    <h2>Så räknar vi</h2>
    <ol>
      <li><strong>Bruttolön</strong> = timlön × timmar per månad, plus 12 % semesterersättning om du kryssat i valet.</li>
      <li><strong>Årsinkomst</strong> = månadens lön × 12.</li>
      <li><strong>Grundavdrag</strong> dras från årsinkomsten. Det ger den beskattningsbara inkomsten.</li>
      <li>
        <strong>Kommunalskatt</strong> (din skattesats) plus begravningsavgift
        (0,292 %) och eventuell kyrkoavgift på den beskattningsbara inkomsten.
        Över 643 000 kr tillkommer 20 % <strong>statlig skatt</strong>.
      </li>
      <li>
        <strong>Jobbskatteavdrag</strong> och skattereduktion för
        förvärvsinkomst (högst 1 500 kr/år) dras av från den kommunala skatten.
      </li>
      <li><strong>Public service-avgift</strong>: 1 % av den beskattningsbara inkomsten, högst 1 184 kr/år.</li>
      <li>Skatten per år ÷ 12 dras från bruttolönen.</li>
    </ol>
    <p>
      <strong>Exempel:</strong> 180 kr × 160 timmar = 28 800 kr. Med 12 %
      semesterersättning blir det 32 256 kr i månaden, alltså cirka
      387 000 kr om året. Grundavdraget blir 25 300 kr och
      jobbskatteavdraget cirka 41 900 kr. Med 32 % kommunalskatt blir
      skatten ungefär 6 210 kr i månaden, och kvar blir cirka
      <strong>26 040 kr</strong> – drygt 162 kr per arbetad timme.
    </p>
    <p>
      Reglerna och beloppen för 2026 (prisbasbelopp 59 200 kr,
      skiktgräns 643 000 kr) kommer från Skatteverkets tekniska
      beskrivning av skattetabellerna för inkomstår 2026 (SKV 433).
      Vi har kontrollerat räknaren mot Skatteverkets månadstabell 33 för
      2026: för löner mellan 3 000 och 80 000 kr i månaden skiljer det
      högst någon krona.
    </p>
    <h2>Det här ingår inte</h2>
    <p>
      Räknaren gäller dig som är under 66 år vid årets början och har
      lön som enda inkomst. Pension, sidoinkomster, avdrag du gör i
      deklarationen och jämkning ingår inte. Tjänar du olika mycket olika
      månader blir skatteavdraget på lönebeskedet annorlunda, även om
      årsskatten blir ungefär densamma.
    </p>
  </Fragment>
</VerktygLayout>

<script>
  import { readInput, flagInvalid, kr, kr2, num } from '../../../lib/sv-number';
  import { arsskatt } from '../../../lib/skatt-2026';

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const form = document.getElementById('skatt-form') as HTMLFormElement;
  const timlonEl = $('timlon');
  const timmarEl = $('timmar');
  const skattEl = $('skatt');
  const kyrkaEl = $('kyrka');
  const semEl = $('semester');
  const out = (k: string) => document.querySelector(`[data-out="${k}"]`) as HTMLElement;

  function row(label: string, value: string) {
    const dt = document.createElement('dt');
    dt.textContent = label;
    const dd = document.createElement('dd');
    dd.className = 'text-right font-bold text-ink tabular-nums';
    dd.textContent = value;
    return [dt, dd];
  }

  function compute() {
    [timlonEl, timmarEl, skattEl, kyrkaEl].forEach(flagInvalid);
    const timlon = readInput(timlonEl);
    const timmar = readInput(timmarEl);
    const kommunal = Math.min(100, readInput(skattEl, 32)) / 100;
    const kyrka = Math.min(10, readInput(kyrkaEl, 0)) / 100;
    const brutto = timlon * timmar;
    const semester = semEl.checked ? brutto * 0.12 : 0;
    const total = brutto + semester;
    const s = arsskatt(total * 12, kommunal, kyrka);
    const skattManad = s.total / 12;
    const netto = total - skattManad;

    out('brutto').textContent = kr(brutto);
    out('semester').textContent = semEl.checked ? kr(semester) : '0 kr (avstängd)';
    out('skatt').textContent = kr(skattManad);
    out('skattprocent').textContent =
      total > 0 ? `${num(Math.round((skattManad / total) * 1000) / 10)} % av lönen` : '';
    out('jsa').textContent = kr(s.jobbskatteavdrag / 12);
    out('netto').textContent = kr(netto);
    out('nettotimme').textContent =
      timmar > 0 ? `≈ ${kr2(netto / timmar)} per arbetad timme` : 'Fyll i antal timmar';

    const spec = out('specifikation');
    spec.replaceChildren(
      ...row('Årsinkomst', kr(s.ffi)),
      ...row('− Grundavdrag', kr(s.grundavdrag)),
      ...row('= Beskattningsbar inkomst', kr(s.beskattningsbar)),
      ...row(`Kommunalskatt ${num(kommunal * 100)} %`, kr(s.kommunal)),
      ...row('Begravnings- och kyrkoavgift', kr(s.avgifter)),
      ...row('Statlig skatt', kr(s.statlig)),
      ...row('− Jobbskatteavdrag', kr(s.jobbskatteavdrag)),
      ...row('− Skattereduktion förvärvsinkomst', kr(s.forvarvsreduktion)),
      ...row('Public service-avgift', kr(s.publicService)),
      ...row('= Skatt per år', kr(s.total)),
    );
  }

  form.addEventListener('input', compute);
  form.addEventListener('change', compute);
  compute();
</script>
