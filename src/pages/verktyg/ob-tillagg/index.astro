---
import VerktygLayout from '../../../components/VerktygLayout.astro';

/* Presets.
   Handels is the only preset tied to a real agreement, because its OB
   structure and percentages are published by the union itself and were
   verified (september 2026) at https://www.handels.se/fakta-och-rad/lon-ob/ob-tillagg/
   — Detaljhandelsavtalet (butik), whose 2025–2027 agreement kept OB
   unchanged (https://www.handels.se/avtalsrorelse/avtal-butik-lager-e-handel/).
   The two other presets are deliberately NOT attributed to any union or
   agreement: their numbers are invented examples and say so. Do not add
   agreement-named presets without an authoritative source for the exact
   amounts and their validity period. */
const GENERIC_HINTS = {
  kvall: 'vardag kväll',
  natt: 'vardag natt',
  helg: 'lördag/söndag',
  storhelg: 't.ex. jul, midsommar',
};
const presets = {
  handels: {
    label: 'Handels – Detaljhandelsavtalet, butik',
    badge: 'Enligt Handels (Detaljhandelsavtalet 2025–2027, butik).',
    note: 'OB räknas i procent av timlönen. Gäller butik; lager och andra avtal kan ha andra regler, och ditt företag kan ha lokala avvikelser.',
    source: { label: 'Källa: handels.se – OB-tillägg', url: 'https://www.handels.se/fakta-och-rad/lon-ob/ob-tillagg/' },
    hints: {
      kvall: 'mån–fre 18.15–20.00',
      natt: 'mån–fre efter 20.00',
      helg: 'lördag efter 12.00, söndag',
      storhelg: 'helgdagar; jul-, nyårs-, påsk- och midsommarafton efter 12.00',
    },
    rows: { kvall: ['pct', 50], natt: ['pct', 70], helg: ['pct', 100], storhelg: ['pct', 100] },
  },
  exempelProcent: {
    label: 'Exempel: procent av timlön',
    badge: 'Påhittade exempelvärden – inte från något avtal.',
    note: 'Byt ut procentsatserna mot dem som står i ditt kollektivavtal eller anställningsavtal.',
    source: null,
    hints: GENERIC_HINTS,
    rows: { kvall: ['pct', 25], natt: ['pct', 50], helg: ['pct', 75], storhelg: ['pct', 100] },
  },
  exempelKronor: {
    label: 'Exempel: kronor per timme',
    badge: 'Påhittade exempelvärden – inte från något avtal.',
    note: 'Många avtal anger OB som fasta kronor per timme som räknas upp varje år. Byt ut beloppen mot dem i ditt avtal eller på ditt lönebesked.',
    source: null,
    hints: GENERIC_HINTS,
    rows: { kvall: ['kr', 25], natt: ['kr', 50], helg: ['kr', 60], storhelg: ['kr', 120] },
  },
  eget: {
    label: 'Eget – fyll i själv',
    badge: 'Dina egna värden.',
    note: 'Fyll i procent av timlönen eller kronor per timme för varje kategori, precis som det står i ditt avtal.',
    source: null,
    hints: GENERIC_HINTS,
    rows: null,
  },
} as const;

const categories = [
  { id: 'kvall', name: 'Kväll', hours: '10' },
  { id: 'natt', name: 'Natt', hours: '0' },
  { id: 'helg', name: 'Helg', hours: '8' },
  { id: 'storhelg', name: 'Storhelg', hours: '0' },
] as const;

const initial = presets.handels;

const faq = [
  {
    q: 'Hur räknar man ut OB-tillägg?',
    a: 'Antingen som procent av timlönen eller som ett fast belopp per timme – det beror på ditt kollektivavtal. Procent: timlön × procentsats × antal OB-timmar. Fast belopp: kronor per timme × antal OB-timmar. OB-tillägget betalas utöver din vanliga lön för de timmarna.',
  },
  {
    q: 'Vad räknas som storhelg?',
    a: 'Vanligtvis påsk, midsommar, jul och nyår, men exakt vilka dagar och klockslag som räknas som storhelg står i ditt kollektivavtal. Storhelg ger nästan alltid den högsta OB-nivån.',
  },
  {
    q: 'Har jag rätt till OB om jag inte har kollektivavtal?',
    a: 'Nej, inte automatiskt. OB-tillägg regleras i kollektivavtal eller i ditt anställningsavtal – det finns ingen lag som ger rätt till OB. Saknar arbetsplatsen kollektivavtal gäller det som står i ditt avtal med arbetsgivaren.',
  },
  {
    q: 'Är OB-tillägget skattepliktigt?',
    a: 'Ja. OB-tillägg är lön och beskattas som vanlig lön. Det är också semesterlönegrundande och räknas in i din sjukpenninggrundande inkomst (SGI).',
  },
  {
    q: 'Varför stämmer inte räknaren med mitt lönebesked?',
    a: 'Avtalen har ofta flera OB-nivåer inom samma kategori (t.ex. olika procent före och efter kl. 20), och beloppen räknas upp varje år. Dela upp timmarna efter de klockslag som gäller i ditt avtal och skriv in avtalets egna procentsatser eller belopp för bästa resultat.',
  },
];
---

<VerktygLayout
  title="OB-tillägg räknare 2026 – räkna ut ditt OB"
  description="Gratis OB-räknare: fyll i timlön och timmar på kväll, natt, helg och storhelg. Räkna OB i procent eller kr/timme – med Handels OB-procent för butik förinställt."
  keywords={['ob-tillägg räknare', 'räkna ob', 'ob tillägg 2026', 'ob handels', 'ob butik', 'storhelg ob']}
  h1="OB-tillägg räknare 2026"
  intro="Fyll i timlön och hur många timmar du jobbat på obekväm arbetstid – räknaren visar ditt OB direkt."
  crumb="OB-tillägg"
  faq={faq}
  app="tidrapport"
  ctaTitle="Logga dina OB-timmar i Tidrapportera"
  ctaText="Tidrapportera håller koll på dina arbetspass, så att du ser hur många kvälls-, natt- och helgtimmar du faktiskt jobbat innan lönebeskedet kommer. Export till PDF/CSV. Inget konto."
  disclaimer="Räknaren ger en uppskattning. Kontrollera alltid ditt kollektivavtal – OB-nivåer skiljer sig mellan avtal, arbetsgivare och år. Handels-förinställningen följer förbundets egna uppgifter för butik; exempel-förinställningarna är påhittade värden. Resultatet ersätter inte ditt lönebesked."
>
  <form
    id="ob-form"
    data-presets={JSON.stringify(presets)}
    class="mt-6 rounded-2xl border border-line bg-surface p-4 sm:p-6 md:p-8"
    novalidate
    onsubmit="return false"
  >
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-bold mb-2" for="timlon">Timlön (kr)</label>
        <input
          id="timlon"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          value="180"
          aria-describedby="timlon-fel"
          class="w-full rounded-xl border border-line-strong bg-surface px-4 py-3 text-lg font-bold aria-[invalid=true]:border-ink aria-[invalid=true]:border-2"
        />
        <p id="timlon-fel" hidden class="mt-1 text-sm font-bold text-ink">⚠ Skriv ett tal, t.ex. 185,50</p>
      </div>
      <div>
        <label class="block text-sm font-bold mb-2" for="preset">Avtal (förinställning)</label>
        <select
          id="preset"
          aria-describedby="preset-note"
          class="w-full rounded-xl border border-line-strong bg-surface px-4 py-3 text-base font-bold"
        >
          {Object.entries(presets).map(([key, p]) => (
            <option value={key} selected={key === 'handels'}>{p.label}</option>
          ))}
        </select>
      </div>
    </div>
    <p id="preset-note" class="mt-3 text-sm text-ink-2">
      <strong class="text-ink" data-preset-badge>{initial.badge}</strong>
      {' '}<span data-preset-note>{initial.note}</span>
      {' '}<a
        data-preset-source
        href={initial.source.url}
        class="text-accent underline underline-offset-4"
        rel="noopener"
      >{initial.source.label}</a>
    </p>

    <fieldset class="mt-6">
      <legend class="text-sm font-bold">Timmar och OB-nivå per kategori</legend>
      <div class="mt-3 space-y-4">
        {categories.map((c) => {
          const [unit, value] = initial.rows[c.id];
          return (
            <div class="rounded-xl border border-line p-3 sm:p-4">
              <div class="font-bold text-ink">
                {c.name} <span class="font-normal text-sm text-ink-3">(<span data-hint={c.id}>{initial.hints[c.id]}</span>)</span>
              </div>
              <div class="mt-2 grid grid-cols-3 gap-2 sm:gap-3">
                <div>
                  <label class="block text-xs font-bold text-ink-2 mb-1" for={`h-${c.id}`}>
                    Timmar
                  </label>
                  <input
                    id={`h-${c.id}`}
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    value={c.hours}
                    aria-describedby={`h-${c.id}-fel`}
                    class="w-full rounded-lg border border-line-strong bg-surface px-3 py-2 font-bold aria-[invalid=true]:border-ink aria-[invalid=true]:border-2"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold text-ink-2 mb-1" for={`v-${c.id}`}>
                    OB-nivå
                  </label>
                  <input
                    id={`v-${c.id}`}
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    value={String(value)}
                    aria-describedby={`v-${c.id}-fel`}
                    class="w-full rounded-lg border border-line-strong bg-surface px-3 py-2 font-bold aria-[invalid=true]:border-ink aria-[invalid=true]:border-2"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold text-ink-2 mb-1" for={`u-${c.id}`}>
                    Enhet<span class="sr-only"> – procent av timlönen eller kronor per timme</span>
                  </label>
                  <select
                    id={`u-${c.id}`}
                    class="w-full rounded-lg border border-line-strong bg-surface px-2 py-2 font-bold"
                  >
                    <option value="pct" selected={unit === 'pct'}>%</option>
                    <option value="kr" selected={unit === 'kr'}>kr/tim</option>
                  </select>
                </div>
              </div>
              <p id={`h-${c.id}-fel`} hidden class="mt-1 text-sm font-bold text-ink">⚠ Timmar måste vara ett tal</p>
              <p id={`v-${c.id}-fel`} hidden class="mt-1 text-sm font-bold text-ink">⚠ OB-nivån måste vara ett tal</p>
            </div>
          );
        })}
      </div>
    </fieldset>
  </form>

  <section aria-labelledby="ob-resultat" class="mt-6">
    <h2 id="ob-resultat" class="sr-only">Resultat</h2>
    <div aria-live="polite" aria-atomic="true">
      <dl class="grid grid-cols-2 gap-3">
        {categories.map((c) => (
          <div class="rounded-2xl bg-surface-2 border border-line p-4">
            <dt class="text-xs font-black uppercase tracking-widest text-ink-3">OB {c.name.toLowerCase()}</dt>
            <dd class="mt-1 text-xl font-black text-ink" data-out={c.id}>–</dd>
            <dd class="text-xs text-ink-3" data-out-detail={c.id}></dd>
          </div>
        ))}
        <div class="col-span-2 rounded-2xl bg-ink text-on-ink p-5">
          <dt class="text-xs font-black uppercase tracking-widest text-on-ink-2">Totalt OB-tillägg (före skatt)</dt>
          <dd class="mt-1 text-3xl font-black" data-out="total">–</dd>
          <dd class="text-sm text-on-ink-2" data-out="totaldetail"></dd>
        </div>
      </dl>
    </div>
  </section>

  <Fragment slot="forklaring">
    <h2>Så räknas OB-tillägg</h2>
    <p>
      OB står för <em>obekväm arbetstid</em> – arbete på kvällar, nätter,
      helger och storhelger. Ersättningen står i ditt kollektivavtal och
      anges på ett av två sätt:
    </p>
    <ul>
      <li>
        <strong>Procent av timlönen.</strong> OB = timlön × procentsats ×
        timmar. Med 180 kr i timlön och 50 % OB i 10 timmar blir det
        180 × 0,50 × 10 = <strong>900 kr</strong>.
      </li>
      <li>
        <strong>Fast belopp per timme.</strong> OB = kronor per timme ×
        timmar. Med 55 kr/timme i 8 nattimmar blir det 55 × 8 =
        <strong>440 kr</strong>.
      </li>
    </ul>
    <p>
      Många avtal använder i stället fasta kronbelopp som räknas upp
      varje avtalsperiod. Välj då <em>Exempel: kronor per timme</em> och
      skriv in beloppen från ditt eget avtal eller lönebesked – exempelvärdena
      är påhittade och kommer inte från något avtal.
    </p>
    <h2>OB i butik enligt Handels</h2>
    <p>
      Enligt Handelsanställdas förbund ger Detaljhandelsavtalet för butik
      <strong>50 %</strong> OB måndag–fredag 18.15–20.00,
      <strong>70 %</strong> efter 20.00, och <strong>100 %</strong> på
      lördagar efter 12.00, söndagar och helgdagar. På jul-, nyårs-,
      påsk- och midsommarafton är det 100 % efter 12.00. OB-reglerna
      behölls oförändrade i avtalet för 2025–2027. Källa:
      <a href="https://www.handels.se/fakta-och-rad/lon-ob/ob-tillagg/" rel="noopener">handels.se – OB-tillägg</a>
      och <a href="https://www.handels.se/avtalsrorelse/avtal-butik-lager-e-handel/" rel="noopener">handels.se – Avtal butik, lager, e-handel</a>
      (hämtade september 2026). Lager, e-handel och andra avtal kan ha
      andra regler.
    </p>
    <h2>Tips: dela upp timmarna efter klockslag</h2>
    <p>
      Många avtal har flera nivåer inom samma kategori, till exempel en
      lägre nivå tidig kväll och en högre sen kväll. Välj då
      <em>Eget</em> och lägg in varje nivå för sig, eller räkna i två
      omgångar. Ju närmare avtalets indelning du kommer, desto bättre
      stämmer resultatet med lönebeskedet.
    </p>
  </Fragment>
</VerktygLayout>

<script>
  import { readInput, flagInvalid, kr, kr2, num } from '../../../lib/sv-number';

  type Unit = 'pct' | 'kr';
  const form = document.getElementById('ob-form') as HTMLFormElement;
  // Single source: the frontmatter presets, serialised onto the form.
  type Preset = {
    badge: string;
    note: string;
    source: { label: string; url: string } | null;
    hints: Record<string, string>;
    rows: Record<string, [Unit, number]> | null;
  };
  const PRESETS: Record<string, Preset> =
    JSON.parse(form.dataset.presets ?? '{}');
  const CATS = ['kvall', 'natt', 'helg', 'storhelg'];
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const timlonEl = $<HTMLInputElement>('timlon');
  const presetEl = $<HTMLSelectElement>('preset');
  const noteEl = document.querySelector('[data-preset-note]')!;
  const badgeEl = document.querySelector('[data-preset-badge]')!;
  const sourceEl = document.querySelector('[data-preset-source]') as HTMLAnchorElement;

  function showInfo(p: Preset) {
    badgeEl.textContent = p.badge;
    noteEl.textContent = p.note;
    sourceEl.hidden = !p.source;
    if (p.source) {
      sourceEl.href = p.source.url;
      sourceEl.textContent = p.source.label;
    }
  }
  const out = (k: string) => document.querySelector(`[data-out="${k}"]`)!;
  const detail = (k: string) => document.querySelector(`[data-out-detail="${k}"]`)!;

  function applyPreset(key: string) {
    const p = PRESETS[key];
    if (!p) return;
    showInfo(p);
    // "Eget" keeps whatever is in the fields — it's a starting point.
    if (!p.rows) return;
    for (const c of CATS) {
      document.querySelector(`[data-hint="${c}"]`)!.textContent = p.hints[c];
      const [unit, value] = p.rows[c];
      $<HTMLSelectElement>(`u-${c}`).value = unit;
      $<HTMLInputElement>(`v-${c}`).value = String(value).replace('.', ',');
    }
  }

  function compute() {
    flagInvalid(timlonEl);
    const timlon = readInput(timlonEl);
    let total = 0;
    let totalHours = 0;
    for (const c of CATS) {
      const hEl = $<HTMLInputElement>(`h-${c}`);
      const vEl = $<HTMLInputElement>(`v-${c}`);
      flagInvalid(hEl);
      flagInvalid(vEl);
      const hours = readInput(hEl);
      const level = readInput(vEl);
      const unit = $<HTMLSelectElement>(`u-${c}`).value as Unit;
      const perHour = unit === 'pct' ? (timlon * level) / 100 : level;
      const ob = perHour * hours;
      total += ob;
      totalHours += hours;
      out(c).textContent = kr(ob);
      detail(c).textContent = `${num(hours)} h × ${kr2(perHour)}/h`;
    }
    out('total').textContent = kr(total);
    out('totaldetail').textContent =
      totalHours > 0
        ? `${num(totalHours)} OB-timmar · i snitt ${kr2(total / totalHours)} extra per timme`
        : 'Fyll i antal timmar ovan';
  }

  presetEl.addEventListener('change', () => {
    applyPreset(presetEl.value);
    compute();
  });
  form.addEventListener('input', (e) => {
    // Editing a level by hand means it's no longer the preset.
    const t = e.target as HTMLElement;
    if (t.id.startsWith('v-') && presetEl.value !== 'eget') {
      presetEl.value = 'eget';
      showInfo(PRESETS.eget);
    }
    compute();
  });
  form.addEventListener('change', (e) => {
    const t = e.target as HTMLElement;
    if (t.id.startsWith('u-') && presetEl.value !== 'eget') {
      presetEl.value = 'eget';
      showInfo(PRESETS.eget);
    }
    compute();
  });
  compute();
</script>
