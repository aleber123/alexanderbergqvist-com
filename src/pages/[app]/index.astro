---
import { getCollection } from 'astro:content';
import { resolveOgImage } from '../../lib/og';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AppStoreQr from '../../components/AppStoreQr.astro';
import AppStoreBadge from '../../components/AppStoreBadge.astro';
import TidrapportLanding from '../../components/landing/TidrapportLanding.astro';
import SnusfriLanding from '../../components/landing/SnusfriLanding.astro';
import { AKTUELLT_AR } from '../../data/verktyg';
import {
  LOCALES,
  LOCALE_BCP47,
  LOCALE_LABELS,
  appSupportsLocale,
  articleUrl,
} from '../../i18n/locales';

export const getStaticPaths = (async () => {
  const apps = await getCollection('apps');
  return apps.map((app) => ({
    params: { app: app.id },
    props: { app },
  }));
}) satisfies GetStaticPaths;

const { app } = Astro.props;
const {
  name,
  seoTitle,
  metaDescription,
  h1,
  tagline,
  description,
  icon,
  accent,
  accentDark,
  status,
  appStoreUrl,
  features,
  keywords,
  category,
} = app.data;

const allArticles = await getCollection('articles', (a) => !a.data.draft);
// Default (sv) landing page only shows Swedish articles — the localized
// /<lang>/<app>/ pages handle the rest. Without this filter all language
// variants got mixed in one list, which is unreadable for any single user.
const appArticles = allArticles
  .filter((a) => a.data.app === app.id && a.data.lang === 'sv')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Articles in other languages for this app, grouped by language, so every
// article is linked from its app page (they used to be reachable only via
// /blog/ or the /<lang>/<app>/ pages, which Google rarely got to).
const foreignArticles = LOCALES.map((l) => ({
  lang: l,
  list: allArticles
    .filter((a) => a.data.app === app.id && a.data.lang === l)
    .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()),
})).filter((g) => g.list.length > 0);

// Reciprocal hreflang with /<lang>/<app>/ — those pages already point
// here as sv-SE, but this page never pointed back, so Google ignored
// the whole set.
let alternates: Record<string, string> | undefined;
if (LOCALES.some((l) => appSupportsLocale(app.id, l))) {
  alternates = { 'sv-SE': new URL(`/${app.id}/`, Astro.site).href };
  for (const l of LOCALES) {
    if (appSupportsLocale(app.id, l)) {
      alternates[LOCALE_BCP47[l]] = new URL(`/${l}/${app.id}/`, Astro.site).href;
    }
  }
}

// Hand-curated map of free tool slugs per app. Each entry shows up
// as a card on the landing page.
const toolsByApp: Record<
  string,
  { slug?: string; href?: string; title: string; description: string }[]
> = {
  'snusfri-resa': [
    {
      slug: 'sluta-snusa',
      title: 'Sluta snusa dag för dag',
      description:
        'Vad händer i kroppen när du slutar snusa? Tidslinje dag för dag – abstinens, sug och återhämtning.',
    },
    {
      slug: 'kalkylator',
      title: 'Snusfri-kalkylator',
      description:
        'Hur mycket sparar du på att sluta snusa? Räkna ut exakt belopp.',
    },
  ],
  fodelsedagar: [
    {
      slug: 'grattis',
      title: 'Grattis-hälsningar',
      description: 'Färdiga födelsedagshälsningar till mamma, pappa, vän och kollega – kopiera med ett klick.',
    },
    {
      href: '/namnsdag/',
      title: 'Dagens namnsdag',
      description:
        'Vem har namnsdag idag och imorgon? Sök ett namn eller bläddra månad för månad.',
    },
    {
      href: '/vecka/',
      title: 'Vilken vecka är det?',
      description: 'Dagens veckonummer, jämn eller udda vecka och alla veckor med datum.',
    },
    {
      slug: 'samma-fodelsedag',
      title: 'Vem delar du födelsedag med?',
      description:
        'Se vilka kändisar och historiska personer som fyller år samma dag som dig.',
    },
    {
      slug: 'aldersrakna',
      title: 'Hur gammal är jag?',
      description: 'Åldersräknare: exakt ålder i år, månader och dagar – och tabell för alla födelseår.',
    },
    {
      slug: 'stjarntecken',
      title: 'Vilket stjärntecken är jag?',
      description:
        'Skriv in födelsedatum — få ut tecken, element och datumintervall.',
    },
    {
      slug: 'kinesiskt-stjarntecken',
      title: 'Kinesiskt stjärntecken',
      description:
        'Drake? Tiger? Råtta? Ditt djur från födelseåret – med kinesiskt nyår för varje år.',
    },
    {
      slug: 'veckodag-fodelsedag',
      title: 'Vilken veckodag är jag född?',
      description:
        'Veckodagen du föddes på – och dina kommande tio födelsedagar.',
    },
    {
      slug: 'personnummer-alder',
      title: 'Räkna ut ålder från personnummer',
      description:
        'Skriv in svenskt personnummer (10/12 siffror) — ålder och födelsedatum direkt.',
    },
    {
      slug: 'present-ideer',
      title: 'Födelsedagspresent-idéer',
      description:
        'Välj ålder + relation — få 5–10 konkreta presenttips med prisspann.',
    },
  ],
  'vab-koll': [
    {
      href: '/verktyg/vab-ersattning/',
      title: 'VAB-ersättning 2026',
      description: 'Räkna ut vad du får per vab-dag från Försäkringskassan.',
    },
    {
      slug: 'dagar-rakna',
      title: 'Vab-dagar-räknare',
      description: 'Räkna ut hur många vab-dagar du har kvar för året.',
    },
  ],
  tidrapport: [
    {
      href: '/verktyg/ob-tillagg/',
      title: 'OB-tillägg räknare',
      description: 'Räkna OB för kväll, natt, helg och storhelg.',
    },
    {
      href: '/verktyg/timlon-efter-skatt/',
      title: 'Timlön efter skatt',
      description: 'Timlön × timmar, med semesterersättning och kommunalskatt.',
    },
    {
      href: '/verktyg/semesterersattning/',
      title: 'Semesterersättning',
      description: 'Räkna 12 % enligt semesterlagen – eller mer enligt avtal.',
    },
    {
      slug: 'timlone-rakna',
      title: 'Timlöne-räknare',
      description: 'Räkna ut din effektiva timlön som konsult eller anställd.',
    },
    {
      href: '/verktyg/turnusschema/',
      title: 'Turnusschema-generator',
      description: '2-2-3, 4 på/4 av eller 5-5-4 – se åtta veckor och timmar per vecka.',
    },
    {
      href: `/verktyg/roda-dagar-${AKTUELLT_AR}/`,
      title: `Röda dagar ${AKTUELLT_AR}`,
      description: 'Alla helgdagar och klämdagar – och vilka pass som kan ge storhelgs-OB.',
    },
    {
      href: `/verktyg/lonedag-${AKTUELLT_AR}/`,
      title: `Lönedag ${AKTUELLT_AR}`,
      description: 'När kommer lönen varje månad om lönedagen är den 25:e?',
    },
  ],
  renovera: [
    {
      slug: 'betongkalkylator',
      title: 'Betongkalkylator',
      description: 'Hur många säckar betong behöver du? Plintar, plattor och murar.',
    },
  ],
  somnkoll: [
    {
      slug: 'somncykelkalkylator',
      title: 'Sömncykelkalkylator',
      description: 'När ska du gå och lägga dig för att vakna mellan två sömncykler?',
    },
  ],
  plantera: [
    {
      slug: 'frostrisk-rakna',
      title: 'Frostrisk-räknare',
      description:
        'När är det säkert att plantera ut? Få första frostfria datum för din zon.',
    },
    {
      slug: 'odlingszon',
      title: 'Vilken odlingszon bor du i?',
      description:
        'Skriv in postnumret — få din SLU-odlingszon (1–8) och vad du kan odla där.',
    },
  ],
  surdeg: [
    {
      slug: 'recept',
      title: '33 surdegsrecept',
      description:
        'Komplett samling — vit limpa, råglimpa, ciabatta, kanelbullar och 29 till.',
    },
    {
      slug: 'hydration-rakna',
      title: 'Hydration-räknare',
      description:
        'Skriv in mjöl, vatten, surdeg — få exakt hydrationsprocent + bedömning.',
    },
    {
      slug: 'matningsschema',
      title: 'Matningsschema-räknare',
      description:
        'När ska din surdeg matas härnäst — och hur mycket mjöl behövs?',
    },
  ],
};
const tools = toolsByApp[app.id] ?? [];

// Direct-link every sourdough recipe from /surdeg/ so the 33 recipe
// pages aren't orphaned 2 levels deep. Without this, Google only
// reaches them via /surdeg/ → /surdeg/recept/ → /surdeg/recept/[slug]/
// and most stay in "Discovered – currently not indexed".
type RecipeLink = { id: string; title: string; subtitle: string };
let recipeLinks: RecipeLink[] = [];
if (app.id === 'surdeg') {
  const recipesModule = await import('../../data/recipes.json');
  const all = recipesModule.default as RecipeLink[];
  recipeLinks = all.map((r) => ({
    id: r.id,
    title: r.title,
    subtitle: r.subtitle,
  }));
}

// Map Swedish category labels to schema.org's canonical
// `applicationCategory` enum so Google can classify the app correctly
// in mobile-app rich results. Falls back to the raw value when no
// mapping matches.
const categoryMap: Record<string, string> = {
  'Hälsa och träning': 'HealthApplication',
  'Hälsa & form': 'HealthApplication',
  'Livsstil': 'LifestyleApplication',
  'Lifestyle': 'LifestyleApplication',
  'Verktyg': 'UtilitiesApplication',
  'Utilities': 'UtilitiesApplication',
  'Produktivitet': 'BusinessApplication',
  'Productivity': 'BusinessApplication',
  'Mat och dryck': 'LifestyleApplication',
  'Familj': 'LifestyleApplication',
  'Trädgård': 'LifestyleApplication',
};
const schemaCategory = categoryMap[category] ?? 'LifestyleApplication';

const pageUrl = new URL(`/${app.id}/`, Astro.site).href;
const iconAbsolute = new URL(icon, Astro.site).href;

const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name,
  description,
  applicationCategory: schemaCategory,
  operatingSystem: 'iOS',
  inLanguage: 'sv-SE',
  url: pageUrl,
  image: iconAbsolute,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'SEK',
    availability:
      status === 'live'
        ? 'https://schema.org/InStock'
        : 'https://schema.org/PreOrder',
  },
  author: {
    '@type': 'Person',
    name: 'Alexander Bergqvist',
    url: 'https://alexanderbergqvist.com/',
  },
  publisher: {
    '@type': 'Person',
    name: 'Alexander Bergqvist',
    url: 'https://alexanderbergqvist.com/',
  },
  ...(appStoreUrl && { downloadUrl: appStoreUrl }),
  ...(appStoreUrl && { installUrl: appStoreUrl }),
};

// Extract numeric App Store ID for the Apple Smart App Banner.
// URL format: .../app/<name>/id<digits>
const appStoreId = appStoreUrl
  ? appStoreUrl.match(/\/id(\d+)/)?.[1]
  : undefined;
---

<BaseLayout
  title={seoTitle ?? name}
  description={metaDescription ?? tagline}
  keywords={keywords}
  image={resolveOgImage(app.id, '')}
  appStoreId={appStoreId}
  hreflangAlternates={alternates}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(ldJson)}
  />

  <section
    class="relative overflow-hidden"
    style={`background: linear-gradient(135deg, ${accent}, ${accentDark ?? accent});`}
  >
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28 text-white relative">
      <div class="grid md:grid-cols-[200px_1fr] gap-8 md:gap-12 items-center">
        <div
          class="w-32 h-32 md:w-40 md:h-40 rounded-3xl shadow-2xl overflow-hidden bg-white/10 mx-auto md:mx-0"
        >
          <img
            src={icon}
            alt={`${name} app-ikon`}
            class="w-full h-full object-cover"
          />
        </div>
        <div class="text-center md:text-left">
          <span class="inline-block text-xs font-black uppercase tracking-widest opacity-80">
            {category}
          </span>
          <h1 class={`mt-2 font-black tracking-tight ${h1 ? 'text-3xl md:text-5xl' : 'text-4xl md:text-6xl'}`}>
            {h1 ?? name}
          </h1>
          <p class="mt-4 text-lg md:text-xl opacity-95 max-w-2xl">
            {tagline}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3 lg:gap-5 justify-center md:justify-start">
            <AppStoreBadge url={appStoreUrl} status={status} variant="light" position="hero" />
            {status === 'live' && <AppStoreQr url={appStoreUrl} lang={'sv'} />}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-6 pt-6">
    <Breadcrumbs
      trail={[
        { name: 'Hem', url: '/' },
        { name: 'Appar', url: '/appar/' },
        { name },
      ]}
    />
  </div>

  <section class="max-w-3xl mx-auto px-6 py-12">
    <p class="text-lg text-ink-2 leading-relaxed">{description}</p>
  </section>

  {app.id === 'fodelsedagar' && (
    <section class="max-w-3xl mx-auto px-6 pb-12">
      <figure
        class="rounded-3xl overflow-hidden border border-line shadow-xl"
      >
        <img
          src="/apps/fodelsedagar-mascot.webp"
          alt="Lama med partyhatt framför en födelsedagstårta — Födelsedagars maskot"
          width="853"
          height="1101"
          loading="lazy"
          class="w-full h-auto block"
        />
      </figure>
    </section>
  )}

  {features.length > 0 && (
    <section class="bg-surface-2 border-y border-line py-16">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-black mb-8">Vad kan {name}?</h2>
        <ul class="grid md:grid-cols-2 gap-4">
          {features.map((f) => (
            <li class="flex items-start gap-3 bg-surface rounded-xl p-5 border border-line">
              <span
                class="flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-white font-black text-sm"
                style={`background: ${accent};`}
              >
                ✓
              </span>
              <span class="text-ink-2 font-medium">{f}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {app.id === 'tidrapport' && <TidrapportLanding accent={accent} />}
  {app.id === 'snusfri-resa' && <SnusfriLanding />}

  {tools.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-16">
      <h2 class="text-2xl md:text-3xl font-black mb-3">Fria verktyg</h2>
      <p class="text-ink-2 mb-8 max-w-2xl">
        Räknare och kalkylatorer du kan använda direkt i webbläsaren —
        utan inloggning eller installation.
      </p>
      <div class="grid md:grid-cols-2 gap-4">
        {tools.map((t) => (
          <a
            href={t.href ?? `/${app.id}/${t.slug}/`}
            class="group block rounded-2xl border border-line p-6 hover:border-line-strong hover:shadow-md transition"
          >
            <div class="font-bold text-lg text-ink group-hover:text-ink-2">
              {t.title}
            </div>
            <p class="text-ink-2 mt-1">{t.description}</p>
            <span class="inline-block mt-4 text-sm font-bold" style={`color: ${accent};`}>
              Öppna verktyget →
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  {recipeLinks.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-16 border-t border-line">
      <h2 class="text-2xl md:text-3xl font-black mb-3">
        Alla {recipeLinks.length} surdegsrecept
      </h2>
      <p class="text-ink-2 mb-8 max-w-2xl">
        Klassiska bröd, söta bullar, knäckebröd, pizza och tunnbröd —
        steg-för-steg med hydration, jäsningstider och temperaturer.
      </p>
      <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-2">
        {recipeLinks.map((r) => (
          <li>
            <a
              href={`/surdeg/recept/${r.id}/`}
              class="block py-2 text-ink hover:text-ink-2 hover:underline"
            >
              <span class="font-semibold">{r.title}</span>
              <span class="text-ink-3"> — {r.subtitle}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {appArticles.length > 0 && (
    <section class="bg-surface-2 border-t border-line py-16">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-black mb-8">Läs mer</h2>
        <div class="grid md:grid-cols-2 gap-4">
          {appArticles.map((a) => {
            const slug = a.id.split('/').pop();
            return (
              <a
                href={`/${app.id}/${slug}/`}
                class="block bg-surface rounded-xl border border-line p-5 hover:border-line-strong hover:shadow-md transition"
              >
                <div class="font-bold text-ink">{a.data.title}</div>
                <p class="text-sm text-ink-2 mt-1 line-clamp-2">
                  {a.data.description}
                </p>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {foreignArticles.length > 0 && (
    <section class="border-t border-line py-12">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-xl md:text-2xl font-black mb-6">Artiklar på andra språk</h2>
        <div class="grid md:grid-cols-2 gap-x-10 gap-y-6">
          {foreignArticles.map((g) => (
            <div lang={LOCALE_BCP47[g.lang]}>
              <h3 class="font-bold text-ink">{LOCALE_LABELS[g.lang]}</h3>
              <ul class="mt-2 space-y-1 text-sm text-ink-2">
                {g.list.map((a) => (
                  <li>
                    <a href={articleUrl(a.id, a.data.app, a.data.lang)} class="underline">{a.data.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="max-w-3xl mx-auto px-6 py-20 text-center">
    <h2 class="text-2xl md:text-3xl font-black">Redo att testa {name}?</h2>
    <p class="mt-3 text-ink-2">Gratis att ladda ner. Premium är valfri.</p>
    <div class="mt-6 inline-flex">
      <AppStoreBadge url={appStoreUrl} status={status} />
    </div>
  </section>
</BaseLayout>
