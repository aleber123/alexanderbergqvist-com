---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../components/BaseLayout.astro';
import AppStoreBadge from '../../components/AppStoreBadge.astro';

export const getStaticPaths = (async () => {
  const apps = await getCollection('apps');
  return apps.map((app) => ({
    params: { app: app.id },
    props: { app },
  }));
}) satisfies GetStaticPaths;

const { app } = Astro.props;
const { name, tagline, description, icon, accent, accentDark, status,
        appStoreUrl, features, keywords, category } = app.data;

// Articles for this specific app — surfaced in the "Läs mer"-section.
const allArticles = await getCollection('articles', (a) => !a.data.draft);
const appArticles = allArticles
  .filter((a) => a.data.app === app.id)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// JSON-LD for SoftwareApplication — gives Google's rich snippet potential.
const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name,
  description,
  applicationCategory: category,
  operatingSystem: 'iOS',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'SEK' },
  ...(appStoreUrl && { downloadUrl: appStoreUrl }),
};
---

<BaseLayout
  title={name}
  description={tagline}
  keywords={keywords}
  image={icon}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(ldJson)}
    slot="head"
  />

  <section
    class="relative overflow-hidden"
    style={`background: linear-gradient(135deg, ${accent}, ${accentDark ?? accent});`}
  >
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28 text-white relative">
      <div class="grid md:grid-cols-[200px_1fr] gap-8 md:gap-12 items-center">
        <div class="w-32 h-32 md:w-40 md:h-40 rounded-3xl shadow-2xl overflow-hidden bg-white/10 mx-auto md:mx-0">
          <img
            src={icon}
            alt={`${name} app-ikon`}
            class="w-full h-full object-cover"
            onerror={`this.style.display='none'; this.parentElement.innerHTML='<div class=&quot;w-full h-full flex items-center justify-center text-6xl font-black&quot;>${name[0]}</div>'`}
          />
        </div>
        <div class="text-center md:text-left">
          <span class="inline-block text-xs font-black uppercase tracking-widest opacity-80">
            {category}
          </span>
          <h1 class="mt-2 text-4xl md:text-6xl font-black tracking-tight">
            {name}
          </h1>
          <p class="mt-4 text-lg md:text-xl opacity-95 max-w-2xl">
            {tagline}
          </p>
          <div class="mt-8 flex flex-wrap gap-3 justify-center md:justify-start">
            <AppStoreBadge url={appStoreUrl} status={status} variant="light" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-16">
    <p class="text-lg text-slate-700 leading-relaxed">{description}</p>
  </section>

  {features.length > 0 && (
    <section class="bg-slate-50 border-y border-slate-200 py-16">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-black mb-8">Vad kan {name}?</h2>
        <ul class="grid md:grid-cols-2 gap-4">
          {features.map((f) => (
            <li class="flex items-start gap-3 bg-white rounded-xl p-5 border border-slate-200">
              <span
                class="flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-white font-black text-sm"
                style={`background: ${accent};`}
              >
                ✓
              </span>
              <span class="text-slate-700 font-medium">{f}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {appArticles.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-16">
      <h2 class="text-2xl md:text-3xl font-black mb-8">Läs mer</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {appArticles.map((a) => (
          <a
            href={`/${app.id}/${a.id.split('/').pop()}/`}
            class="block rounded-xl border border-slate-200 p-5 hover:border-slate-300 hover:shadow-md transition"
          >
            <div class="font-bold text-slate-900">{a.data.title}</div>
            <p class="text-sm text-slate-600 mt-1">{a.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="max-w-3xl mx-auto px-6 py-20 text-center">
    <h2 class="text-2xl md:text-3xl font-black">Redo att testa {name}?</h2>
    <p class="mt-3 text-slate-600">Gratis att ladda ner. Premium är valfri.</p>
    <div class="mt-6 inline-flex">
      <AppStoreBadge url={appStoreUrl} status={status} />
    </div>
  </section>
</BaseLayout>
