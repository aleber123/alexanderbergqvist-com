---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AppStoreBadge from '../../components/AppStoreBadge.astro';

export const getStaticPaths = (async () => {
  const apps = await getCollection('apps');
  return apps.map((app) => ({
    params: { app: app.id },
    props: { app },
  }));
}) satisfies GetStaticPaths;

const { app } = Astro.props;
const {
  name,
  tagline,
  description,
  icon,
  accent,
  accentDark,
  status,
  appStoreUrl,
  features,
  keywords,
  category,
} = app.data;

const allArticles = await getCollection('articles', (a) => !a.data.draft);
const appArticles = allArticles
  .filter((a) => a.data.app === app.id)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Hand-curated map of free tool slugs per app. Each entry shows up
// as a card on the landing page.
const toolsByApp: Record<
  string,
  { slug: string; title: string; description: string }[]
> = {
  'snusfri-resa': [
    {
      slug: 'kalkylator',
      title: 'Snusfri-kalkylator',
      description:
        'Hur mycket sparar du på att sluta snusa? Räkna ut exakt belopp.',
    },
  ],
  fodelsedagar: [
    {
      slug: 'aldersrakna',
      title: 'Hur gammal är jag?',
      description: 'Räkna ut exakt ålder i år, månader, dagar och sekunder.',
    },
  ],
  'vab-koll': [
    {
      slug: 'dagar-rakna',
      title: 'Vab-dagar-räknare',
      description: 'Räkna ut hur många vab-dagar du har kvar för året.',
    },
  ],
  tidrapport: [
    {
      slug: 'timlone-rakna',
      title: 'Timlöne-räknare',
      description: 'Räkna ut din effektiva timlön som konsult eller anställd.',
    },
  ],
  plantera: [
    {
      slug: 'frostrisk-rakna',
      title: 'Frostrisk-räknare',
      description:
        'När är det säkert att plantera ut? Få första frostfria datum för din zon.',
    },
    {
      slug: 'odlingszon',
      title: 'Vilken odlingszon bor du i?',
      description:
        'Skriv in postnumret — få din SLU-odlingszon (1–8) och vad du kan odla där.',
    },
  ],
};
const tools = toolsByApp[app.id] ?? [];

const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name,
  description,
  applicationCategory: category,
  operatingSystem: 'iOS',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'SEK' },
  ...(appStoreUrl && { downloadUrl: appStoreUrl }),
};
---

<BaseLayout
  title={name}
  description={tagline}
  keywords={keywords}
  image={`/og/${app.id}.png`}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(ldJson)}
  />

  <section
    class="relative overflow-hidden"
    style={`background: linear-gradient(135deg, ${accent}, ${accentDark ?? accent});`}
  >
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28 text-white relative">
      <div class="grid md:grid-cols-[200px_1fr] gap-8 md:gap-12 items-center">
        <div
          class="w-32 h-32 md:w-40 md:h-40 rounded-3xl shadow-2xl overflow-hidden bg-white/10 mx-auto md:mx-0"
        >
          <img
            src={icon}
            alt={`${name} app-ikon`}
            class="w-full h-full object-cover"
          />
        </div>
        <div class="text-center md:text-left">
          <span class="inline-block text-xs font-black uppercase tracking-widest opacity-80">
            {category}
          </span>
          <h1 class="mt-2 text-4xl md:text-6xl font-black tracking-tight">
            {name}
          </h1>
          <p class="mt-4 text-lg md:text-xl opacity-95 max-w-2xl">
            {tagline}
          </p>
          <div class="mt-8 flex flex-wrap gap-3 justify-center md:justify-start">
            <AppStoreBadge url={appStoreUrl} status={status} variant="light" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-6 pt-6">
    <Breadcrumbs
      trail={[
        { name: 'Hem', url: '/' },
        { name: 'Appar', url: '/appar/' },
        { name },
      ]}
    />
  </div>

  <section class="max-w-3xl mx-auto px-6 py-12">
    <p class="text-lg text-slate-700 leading-relaxed">{description}</p>
  </section>

  {features.length > 0 && (
    <section class="bg-slate-50 border-y border-slate-200 py-16">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-black mb-8">Vad kan {name}?</h2>
        <ul class="grid md:grid-cols-2 gap-4">
          {features.map((f) => (
            <li class="flex items-start gap-3 bg-white rounded-xl p-5 border border-slate-200">
              <span
                class="flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-white font-black text-sm"
                style={`background: ${accent};`}
              >
                ✓
              </span>
              <span class="text-slate-700 font-medium">{f}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {tools.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-16">
      <h2 class="text-2xl md:text-3xl font-black mb-3">Fria verktyg</h2>
      <p class="text-slate-600 mb-8 max-w-2xl">
        Räknare och kalkylatorer du kan använda direkt i webbläsaren —
        utan inloggning eller installation.
      </p>
      <div class="grid md:grid-cols-2 gap-4">
        {tools.map((t) => (
          <a
            href={`/${app.id}/${t.slug}/`}
            class="group block rounded-2xl border border-slate-200 p-6 hover:border-slate-300 hover:shadow-md transition"
          >
            <div class="font-bold text-lg text-slate-900 group-hover:text-slate-700">
              {t.title}
            </div>
            <p class="text-slate-600 mt-1">{t.description}</p>
            <span class="inline-block mt-4 text-sm font-bold" style={`color: ${accent};`}>
              Öppna verktyget →
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  {appArticles.length > 0 && (
    <section class="bg-slate-50 border-t border-slate-200 py-16">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-black mb-8">Läs mer</h2>
        <div class="grid md:grid-cols-2 gap-4">
          {appArticles.map((a) => {
            const slug = a.id.split('/').pop();
            return (
              <a
                href={`/${app.id}/${slug}/`}
                class="block bg-white rounded-xl border border-slate-200 p-5 hover:border-slate-300 hover:shadow-md transition"
              >
                <div class="font-bold text-slate-900">{a.data.title}</div>
                <p class="text-sm text-slate-600 mt-1 line-clamp-2">
                  {a.data.description}
                </p>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="max-w-3xl mx-auto px-6 py-20 text-center">
    <h2 class="text-2xl md:text-3xl font-black">Redo att testa {name}?</h2>
    <p class="mt-3 text-slate-600">Gratis att ladda ner. Premium är valfri.</p>
    <div class="mt-6 inline-flex">
      <AppStoreBadge url={appStoreUrl} status={status} />
    </div>
  </section>
</BaseLayout>
