---
import { getEntry } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import AppStoreBadge from '../../components/AppStoreBadge.astro';

const app = await getEntry('apps', 'fodelsedagar');
const appStoreId = app?.data.appStoreUrl?.match(/\/id(\d+)/)?.[1];

const faq = [
  {
    q: 'Vilken är den vanligaste födelsedagspresenten?',
    a: 'Enligt återkommande svenska konsumentundersökningar är blommor, böcker, parfym och presentkort de fyra vanligaste kategorierna. Pengar i kuvert till barn och tonåringar har dock blivit normen — uppskattning skiftar med åldern.',
  },
  {
    q: 'Vad ger man en 50-åring?',
    a: 'Vid 50-årsdagar uppskattas oftast något personligt eller minnesvärt mer än en sak — t.ex. en upplevelse (vinprovning, helgresa, golfrunda), en bok inom personens intresse, ett kvalitets-hemtillbehör, eller fingerade bilder/inramad text från familjen. Räknaren ovan ger fler exempel per ålder.',
  },
  {
    q: 'Hur mycket är lämpligt att ge i pengar?',
    a: 'En tumregel i Sverige: 100–200 kr till bekanta barn, 300–500 kr till nära släktbarn, 500–1000 kr till vuxna nära släktingar/vänner, och högre belopp till partner. Det är dock totalt fritt och beror på relation, ekonomi och kultur.',
  },
  {
    q: 'Vad är skillnaden mellan vad man ger en kollega vs vän?',
    a: 'Kollegor: håll det enkelt och opersonligt — choklad, presentkort, blommor, eller en gemensam present från avdelningen (50–150 kr). Vänner: mer personligt — något som speglar gemensamma intressen, en bok inom deras nisch, eller en upplevelse ni delar.',
  },
  {
    q: 'När ska man köpa presenten?',
    a: 'Två veckor innan är optimalt. Då hinner du jämföra alternativ, beställa online, och har en buffert om det blir leveransfel. Sista-minuten-presenter blir oftare urvattnade. Födelsedagar-appen visar dig påminnelser 1 månad, 1 vecka och 1 dag innan — exakt för att ge dig planeringsutrymme.',
  },
];

interface Idea {
  title: string;
  price: string;
  emoji: string;
}

interface AgeBand {
  range: string;
  minAge: number;
  maxAge: number;
  closeFamily: Idea[];
  friend: Idea[];
  colleague: Idea[];
}

