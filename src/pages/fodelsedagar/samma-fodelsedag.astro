---
import { getEntry } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import AppStoreBadge from '../../components/AppStoreBadge.astro';

const app = await getEntry('apps', 'fodelsedagar');
const appStoreId = app?.data.appStoreUrl?.match(/\/id(\d+)/)?.[1];

const faq = [
  {
    q: 'Var kommer datan från?',
    a: 'Direkt från svenska Wikipedia via deras öppna API. Födelsedagar, dödsdatum och historiska händelser uppdateras kontinuerligt av Wikipedia-frivilliga. Allt körs i din webbläsare — vi sparar inga datum eller besöksdata om dig.',
  },
  {
    q: 'Varför saknas vissa kändisar?',
    a: 'Vi visar bara personer som har en Wikipedia-artikel på svenska. Om en person bara har engelsk artikel kanske de inte syns. Vi prioriterar personer med bilder eftersom det indikerar att de är välkända nog för redaktionsarbete.',
  },
  {
    q: 'Kan jag dela resultatet?',
    a: 'Ja. Tryck på "Skapa delningsbar bild" så genereras en 9:16-bild (Instagram Stories / WhatsApp Status-format) med din match. Du kan spara eller dela direkt till valfri app.',
  },
  {
    q: 'Funkar det för 29 februari?',
    a: 'Ja. Skottdagen har också Wikipedia-data. Bara att den är något kortare än andra datum eftersom färre personer fyller år just då.',
  },
  {
    q: 'Vad bygger appen Födelsedagar in?',
    a: 'Födelsedagar-appen visar både stjärntecken och milstolpe-flagga för alla i din lista. Med Premium kan du även se "vem delar födelsedag med vem" inom din krets — kul vid stora familjeträffar.',
  },
];

const today = new Date();
---

<BaseLayout
  title="Vem delar du födelsedag med? Hitta kändisar samma dag"
  description="Skriv in ditt födelsedatum så ser du vilka berömda svenskar och världen som fyller år samma dag som dig. Plus historiska händelser. Gratis verktyg."
  keywords={[
    'kändisar samma födelsedag',
    'vem delar jag födelsedag med',
    'vem fyller år 12 maj',
    'vad hände samma datum',
    'födelsedag kändisar',
    'historiska händelser datum',
  ]}
  appStoreId={appStoreId}
>
  <section class="max-w-3xl mx-auto px-6 py-8">
    <Breadcrumbs
      trail={[
        { name: 'Hem', url: '/' },
        { name: 'Födelsedagar', url: '/fodelsedagar/' },
        { name: 'Samma födelsedag' },
      ]}
    />
    <span class="inline-block mt-6 text-xs font-black uppercase tracking-widest text-slate-500">
      Fri kalkylator
    </span>
    <h1 class="mt-2 text-3xl md:text-5xl font-black tracking-tight">
      Vem delar du födelsedag med?
    </h1>
    <p class="mt-3 text-lg text-slate-600">
      Skriv in din födelsedag så ser du vilka kändisar — svenskar och andra
      — som fyller år samma dag, plus vilka historiska händelser som hänt
      genom åren. Data från Wikipedia, helt fri.
    </p>

    <div class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 md:p-8">
      <label class="block text-sm font-bold mb-2" for="bdate">
        Ditt födelsedatum (datum + månad räcker)
      </label>
      <input
        id="bdate"
        type="date"
        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-lg font-bold focus:border-pink-500 focus:outline-none"
      />

      <div id="loading" class="mt-6 hidden text-slate-500 text-sm">
        Hämtar från Wikipedia…
      </div>
      <div
        id="error"
        class="mt-6 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
      ></div>

      <section id="results" class="mt-8 hidden">
        <div class="rounded-2xl bg-gradient-to-br from-pink-500 to-pink-700 p-6 text-white mb-6">
          <div class="text-xs font-black uppercase tracking-widest opacity-80">
            Du delar födelsedag med
          </div>
          <div id="hero" class="mt-2">
            <div class="text-2xl md:text-3xl font-black" data-out="heroName">–</div>
            <div class="text-sm opacity-90 mt-1" data-out="heroDesc">–</div>
          </div>
        </div>

        <h2 class="text-xl font-black mb-3">🎂 Födda samma dag</h2>
        <ul id="births" class="space-y-2 mb-8"></ul>

        <h2 class="text-xl font-black mb-3">📜 Historiska händelser</h2>
        <ul id="events" class="space-y-2 mb-8"></ul>

        <div class="rounded-2xl border-2 border-pink-300 bg-pink-50 p-6">
          <h3 class="font-black text-lg mb-2">Dela bilden</h3>
          <p class="text-sm text-slate-700 mb-4">
            Välj format efter var du ska posta — Instagram Stories, Facebook
            eller WhatsApp Status — och om du vill ha en hjälte eller fem-i-rad.
          </p>

          <div class="grid sm:grid-cols-2 gap-3 mb-3">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1" for="fmt">
                Format
              </label>
              <select
                id="fmt"
                class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-bold bg-white"
              >
                <option value="story">📸 Instagram Stories (9:16)</option>
                <option value="square" selected>🟦 Facebook / Instagram-post (1:1)</option>
                <option value="landscape">📺 Facebook landskap (1.91:1)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1" for="layout">
                Layout
              </label>
              <select
                id="layout"
                class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm font-bold bg-white"
              >
                <option value="hero">⭐ Hjälte (1 person, stor bild)</option>
                <option value="grid" selected>👥 Topp 5 (rutnät, bra för FB)</option>
              </select>
            </div>
          </div>

          <button
            id="generateImage"
            class="w-full rounded-xl bg-pink-600 px-6 py-3 font-bold text-white hover:bg-pink-700 transition"
          >
            🎨 Skapa bild
          </button>
          <canvas
            id="shareCanvas"
            width="1080"
            height="1080"
            class="hidden mt-4 w-full rounded-xl border border-slate-300"
          ></canvas>
          <div id="shareActions" class="hidden mt-4 flex gap-2">
            <a
              id="downloadImage"
              class="flex-1 rounded-xl bg-slate-900 px-4 py-3 text-center font-bold text-white hover:bg-slate-800 transition"
              download="fodelsedag.png"
            >
              ⬇️ Ladda ner
            </a>
            <button
              id="shareImage"
              class="flex-1 rounded-xl bg-pink-600 px-4 py-3 font-bold text-white hover:bg-pink-700 transition"
            >
              📤 Dela
            </button>
          </div>

          <details
            id="postCopy"
            class="hidden mt-4 rounded-xl border border-slate-200 bg-white p-4"
          >
            <summary class="cursor-pointer text-sm font-bold text-slate-800">
              📋 Färdig text att kopiera till FB / IG
            </summary>
            <textarea
              id="postCopyText"
              readonly
              rows="6"
              class="mt-3 w-full rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm font-mono"
            ></textarea>
            <button
              id="copyText"
              class="mt-2 rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-200"
            >
              Kopiera text
            </button>
          </details>
        </div>
      </section>
    </div>

    <div class="mt-10 rounded-2xl border border-slate-200 bg-gradient-to-br from-pink-50 to-white p-6 md:p-8">
      <h2 class="text-xl font-black">Spåra alla födelsedagar i appen</h2>
      <p class="mt-2 text-slate-700">
        Födelsedagar-appen visar stjärntecken, milstolpar och påminner
        långt i förväg om alla i din lista. Importera direkt från Kontakter.
      </p>
      <div class="mt-6">
        <AppStoreBadge
          url="https://apps.apple.com/se/app/f%C3%B6delsedagar/id6758899294"
          status="live"
        />
      </div>
    </div>

    <div class="prose mt-12">
      <h2>Varför skapade vi det här verktyget?</h2>
      <p>
        Vi tror att födelsedagar är mer än bara ett datum. När du upptäcker
        att du delar födelsedag med Björn Borg, Greta Thunberg eller en
        viktig historisk person känns dagen lite mer speciell. Det är också
        ett trevligt samtalsämne — och hjälper barn att bli mer intresserade
        av historia när de hittar någon de delar datum med.
      </p>

      <h2>Hur Wikipedia-API:t fungerar</h2>
      <p>
        Wikipedia har ett öppet REST API som returnerar strukturerad data
        per datum: vilka som föddes, vilka som dog, vilka historiska
        händelser som inträffade. Det här verktyget gör en API-fråga direkt
        från din webbläsare — vi har ingen server i mellanlagret, så inget
        sparas om ditt sökande.
      </p>

      <h2>Vad gör en kändis "berömd nog" att visa?</h2>
      <p>
        Vi prioriterar personer med Wikipedia-artiklar som har bilder.
        Närvaron av en bild är en bra proxy för att personen är välkänd nog
        att vara editorialt intressant. Det betyder att lokala kommunpolitiker
        oftast inte syns — bara personer med bredare igenkänningsfaktor.
      </p>

      <h2>Tipsa Wikipedia om någon saknas</h2>
      <p>
        Wikipedia uppdateras kontinuerligt av frivilliga. Om en specifik
        svensk kändis saknas på din födelsedag kan du själv lägga till
        informationen i deras Wikipedia-artikel — det kommer att synas här
        nästa gång data uppdateras (vanligtvis inom en vecka).
      </p>
    </div>

    <FAQ items={faq} />
  </section>
</BaseLayout>

<script>
  const inp = document.getElementById('bdate') as HTMLInputElement;
  const loading = document.getElementById('loading')!;
  const errorBox = document.getElementById('error')!;
  const results = document.getElementById('results')!;
  const births = document.getElementById('births')!;
  const events = document.getElementById('events')!;
  const heroName = document.querySelector('[data-out="heroName"]')!;
  const heroDesc = document.querySelector('[data-out="heroDesc"]')!;
  const generateBtn = document.getElementById('generateImage')! as HTMLButtonElement;
  const canvas = document.getElementById('shareCanvas')! as HTMLCanvasElement;
  const shareActions = document.getElementById('shareActions')!;
  const downloadLink = document.getElementById('downloadImage')! as HTMLAnchorElement;
  const shareBtn = document.getElementById('shareImage')! as HTMLButtonElement;
  const fmtSel = document.getElementById('fmt')! as HTMLSelectElement;
  const layoutSel = document.getElementById('layout')! as HTMLSelectElement;
  const postCopy = document.getElementById('postCopy')! as HTMLDetailsElement;
  const postCopyText = document.getElementById('postCopyText')! as HTMLTextAreaElement;
  const copyTextBtn = document.getElementById('copyText')! as HTMLButtonElement;

  type WikiPage = {
    normalizedtitle?: string;
    extract?: string;
    thumbnail?: { source: string };
  };
  type WikiEntry = {
    text: string;
    year?: number;
    pages?: WikiPage[];
  };
  type Hero = {
    name: string;
    year?: number;
    desc?: string;
    thumb?: string;
  };

  let currentHero: Hero | null = null;
  let currentTop: Hero[] = [];
  let currentDate: Date | null = null;

  function showError(msg: string) {
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
    loading.classList.add('hidden');
    results.classList.add('hidden');
  }

  function clean(text: string): string {
    // Wikipedia returns "Björn Borg, svensk tennisspelare" — strip
    // anything after the first comma to get just the name for the hero.
    return text.split(',')[0].trim();
  }

  function describe(text: string): string {
    const parts = text.split(',');
    return parts.length > 1 ? parts.slice(1).join(',').trim() : '';
  }

  async function fetchOnThisDay(month: number, day: number) {
    const mm = String(month).padStart(2, '0');
    const dd = String(day).padStart(2, '0');
    const url = `https://sv.wikipedia.org/api/rest_v1/feed/onthisday/all/${mm}/${dd}`;
    const r = await fetch(url);
    if (!r.ok) throw new Error('Wikipedia svarade inte');
    return r.json();
  }

  function render(data: any) {
    const allBirths: WikiEntry[] = data.births || [];
    const allEvents: WikiEntry[] = data.events || [];

    // Sort by recency (most recent year first — younger celebrities)
    // and prioritise entries with thumbnails (= more notable).
    const scoredBirths = allBirths
      .map((b) => ({
        ...b,
        score:
          (b.pages?.[0]?.thumbnail ? 1000 : 0) +
          (b.year ?? 0) / 10,
      }))
      .sort((a, b) => b.score - a.score)
      .slice(0, 8);

    const scoredEvents = allEvents
      .map((e) => ({
        ...e,
        score:
          (e.pages?.[0]?.thumbnail ? 1000 : 0) + (e.year ?? 0) / 10,
      }))
      .sort((a, b) => b.score - a.score)
      .slice(0, 5);

    if (scoredBirths.length === 0) {
      showError('Wikipedia har ingen data för det datumet — ovanligt men händer.');
      return;
    }

    // Hero = first scored birth (highest-ranked notable)
    const top = scoredBirths[0];
    currentHero = {
      name: clean(top.text),
      year: top.year,
      desc: describe(top.text),
      thumb: top.pages?.[0]?.thumbnail?.source,
    };
    // Top-5 for grid layout (FB-friendly content).
    currentTop = scoredBirths.slice(0, 5).map((b) => ({
      name: clean(b.text),
      year: b.year,
      desc: describe(b.text),
      thumb: b.pages?.[0]?.thumbnail?.source,
    }));
    heroName.textContent =
      currentHero.name + (top.year ? ` (${top.year})` : '');
    heroDesc.textContent = currentHero.desc || '';

    births.innerHTML = scoredBirths
      .map((b) => {
        const name = clean(b.text);
        const desc = describe(b.text);
        const year = b.year ? `<span class="text-pink-700 font-bold">${b.year}</span>` : '';
        const img = b.pages?.[0]?.thumbnail?.source;
        return `
          <li class="flex gap-3 rounded-xl border border-slate-200 bg-white p-3">
            ${img
              ? `<img src="${img}" alt="" class="w-12 h-12 rounded-full object-cover flex-shrink-0" loading="lazy">`
              : `<div class="w-12 h-12 rounded-full bg-slate-200 flex-shrink-0 flex items-center justify-center text-slate-400">🎂</div>`}
            <div class="flex-1 min-w-0">
              <div class="font-bold text-sm">${name}</div>
              <div class="text-xs text-slate-600 truncate">${desc}</div>
              <div class="text-xs mt-1">${year}</div>
            </div>
          </li>`;
      })
      .join('');

    events.innerHTML = scoredEvents
      .map((e) => {
        const year = e.year ? `<span class="text-pink-700 font-bold">${e.year}</span>` : '';
        return `
          <li class="rounded-xl border border-slate-200 bg-white p-3">
            <div class="text-sm">${e.text}</div>
            <div class="text-xs mt-1">${year}</div>
          </li>`;
      })
      .join('');

    results.classList.remove('hidden');
    loading.classList.add('hidden');
    errorBox.classList.add('hidden');
  }

  async function loadFor(date: Date) {
    currentDate = date;
    loading.classList.remove('hidden');
    errorBox.classList.add('hidden');
    results.classList.add('hidden');
    canvas.classList.add('hidden');
    shareActions.classList.add('hidden');
    postCopy.classList.add('hidden');
    try {
      const data = await fetchOnThisDay(date.getMonth() + 1, date.getDate());
      render(data);
    } catch (e) {
      showError('Kunde inte hämta från Wikipedia. Försök igen om en stund.');
    }
  }

  // ── Share-image generation ─────────────────────────────────────
  async function loadImage(url: string): Promise<HTMLImageElement> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => resolve(img);
      img.onerror = reject;
      img.src = url;
    });
  }

  function wrap(
    ctx: CanvasRenderingContext2D,
    text: string,
    x: number,
    y: number,
    maxWidth: number,
    lineHeight: number,
  ): number {
    const words = text.split(' ');
    let line = '';
    let lines = 0;
    for (const w of words) {
      const testLine = line + w + ' ';
      const m = ctx.measureText(testLine);
      if (m.width > maxWidth && line !== '') {
        ctx.fillText(line.trim(), x, y);
        line = w + ' ';
        y += lineHeight;
        lines += 1;
      } else {
        line = testLine;
      }
    }
    if (line.trim()) {
      ctx.fillText(line.trim(), x, y);
      lines += 1;
    }
    return lines * lineHeight;
  }

  // ── Canvas size + layout dispatch ──────────────────────────────
  function canvasSize(fmt: string): { w: number; h: number } {
    if (fmt === 'story') return { w: 1080, h: 1920 };
    if (fmt === 'landscape') return { w: 1200, h: 628 };
    return { w: 1080, h: 1080 }; // square (default, FB-friendly)
  }

  function paintBackground(ctx: CanvasRenderingContext2D, W: number, H: number) {
    const grad = ctx.createLinearGradient(0, 0, 0, H);
    grad.addColorStop(0, '#E91E63');
    grad.addColorStop(1, '#7B1130');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);
  }

  function paintFooter(ctx: CanvasRenderingContext2D, W: number, H: number, small: boolean) {
    ctx.fillStyle = 'rgba(255,255,255,0.65)';
    ctx.font = `${small ? 22 : 32}px system-ui, sans-serif`;
    ctx.textAlign = 'center';
    ctx.fillText('alexanderbergqvist.com — Födelsedagar-appen', W / 2, H - (small ? 30 : 60));
  }

  async function drawCircleImage(
    ctx: CanvasRenderingContext2D,
    cx: number,
    cy: number,
    r: number,
    thumb: string | undefined,
    fallbackEmoji: string,
  ) {
    ctx.save();
    ctx.beginPath();
    ctx.arc(cx, cy, r, 0, Math.PI * 2);
    ctx.closePath();
    ctx.clip();
    let painted = false;
    if (thumb) {
      try {
        const img = await loadImage(thumb);
        const ratio = img.width / img.height;
        let drawW = r * 2;
        let drawH = r * 2;
        if (ratio > 1) drawW = drawH * ratio;
        else drawH = drawW / ratio;
        ctx.drawImage(img, cx - drawW / 2, cy - drawH / 2, drawW, drawH);
        painted = true;
      } catch {/* fall through */}
    }
    if (!painted) {
      ctx.fillStyle = 'rgba(255,255,255,0.2)';
      ctx.fillRect(cx - r, cy - r, r * 2, r * 2);
      ctx.fillStyle = 'white';
      ctx.font = `${r * 0.9}px system-ui, sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(fallbackEmoji, cx, cy);
      ctx.textBaseline = 'alphabetic';
    }
    ctx.restore();
    // White ring
    ctx.strokeStyle = 'white';
    ctx.lineWidth = Math.max(6, r * 0.05);
    ctx.beginPath();
    ctx.arc(cx, cy, r, 0, Math.PI * 2);
    ctx.stroke();
  }

  // ── Layout: HERO (single person, big) ──────────────────────────
  async function paintHero(ctx: CanvasRenderingContext2D, W: number, H: number, isLandscape: boolean) {
    if (!currentHero) return;
    paintBackground(ctx, W, H);

    if (isLandscape) {
      // Side-by-side: photo left, text right
      const photoR = H * 0.4;
      await drawCircleImage(ctx, photoR + 60, H / 2, photoR, currentHero.thumb, '🎂');

      ctx.textAlign = 'left';
      ctx.fillStyle = 'rgba(255,255,255,0.85)';
      ctx.font = 'bold 28px system-ui, sans-serif';
      ctx.fillText('DU DELAR FÖDELSEDAG MED', photoR * 2 + 120, H / 2 - 80);

      ctx.fillStyle = 'white';
      ctx.font = 'bold 56px system-ui, sans-serif';
      wrap(ctx, currentHero.name, photoR * 2 + 120, H / 2, W - photoR * 2 - 180, 64);

      if (currentHero.year) {
        ctx.fillStyle = 'rgba(255,255,255,0.8)';
        ctx.font = 'bold 32px system-ui, sans-serif';
        ctx.fillText(`Född ${currentHero.year}`, photoR * 2 + 120, H / 2 + 100);
      }
    } else {
      // Centered: confetti, label, big photo, big name
      const isStory = H > W;
      const topY = isStory ? 240 : 120;
      const photoY = isStory ? 580 : 220;
      const photoR = isStory ? 280 : 180;
      const nameY = photoY + photoR * 2 + (isStory ? 160 : 100);

      ctx.fillStyle = 'rgba(255,255,255,0.9)';
      ctx.font = `bold ${isStory ? 56 : 38}px system-ui, sans-serif`;
      ctx.textAlign = 'center';
      ctx.fillText('DU DELAR FÖDELSEDAG MED', W / 2, topY);

      ctx.font = `${isStory ? 80 : 56}px system-ui, sans-serif`;
      ctx.fillText('🎉 🎂 🎈', W / 2, topY + (isStory ? 140 : 90));

      await drawCircleImage(ctx, W / 2, photoY + photoR, photoR, currentHero.thumb, '🎂');

      ctx.fillStyle = 'white';
      ctx.font = `bold ${isStory ? 110 : 72}px system-ui, sans-serif`;
      ctx.textAlign = 'center';
      wrap(ctx, currentHero.name, W / 2, nameY, W - 160, isStory ? 130 : 84);

      if (currentHero.year) {
        ctx.fillStyle = 'rgba(255,255,255,0.85)';
        ctx.font = `bold ${isStory ? 64 : 44}px system-ui, sans-serif`;
        ctx.fillText(`Född ${currentHero.year}`, W / 2, nameY + (isStory ? 160 : 110));
      }
    }

    paintFooter(ctx, W, H, isLandscape);
  }

  // ── Layout: GRID (5 people in row/column) ──────────────────────
  async function paintGrid(ctx: CanvasRenderingContext2D, W: number, H: number, isLandscape: boolean) {
    if (currentTop.length === 0) return;
    paintBackground(ctx, W, H);

    const isStory = H > W;
    const dateStr = currentDate
      ? currentDate.toLocaleDateString('sv-SE', { day: 'numeric', month: 'long' })
      : '';

    // Title row
    ctx.fillStyle = 'white';
    ctx.font = `bold ${isStory ? 64 : isLandscape ? 38 : 56}px system-ui, sans-serif`;
    ctx.textAlign = 'center';
    ctx.fillText('FÖDELSEDAG IDAG', W / 2, isLandscape ? 70 : 110);

    ctx.fillStyle = 'rgba(255,255,255,0.85)';
    ctx.font = `bold ${isStory ? 44 : isLandscape ? 24 : 36}px system-ui, sans-serif`;
    ctx.fillText(dateStr, W / 2, isLandscape ? 110 : 170);

    // Grid: 5 people. Story = vertical column. Square = 2x2 + 1 hero. Landscape = horizontal row.
    const top5 = currentTop.slice(0, 5);

    if (isLandscape) {
      // 5 photos in a row across the bottom 3/4 of canvas
      const r = 90;
      const startX = (W - (r * 2 + 30) * 5 + 30) / 2;
      const photoY = H - r - 110;
      for (let i = 0; i < top5.length; i++) {
        const cx = startX + r + i * (r * 2 + 30);
        await drawCircleImage(ctx, cx, photoY, r, top5[i].thumb, '🎂');
        ctx.fillStyle = 'white';
        ctx.font = 'bold 22px system-ui, sans-serif';
        ctx.textAlign = 'center';
        const name = top5[i].name.length > 18 ? top5[i].name.slice(0, 16) + '…' : top5[i].name;
        ctx.fillText(name, cx, photoY + r + 35);
        if (top5[i].year) {
          ctx.fillStyle = 'rgba(255,255,255,0.7)';
          ctx.font = '20px system-ui, sans-serif';
          ctx.fillText(`(${top5[i].year})`, cx, photoY + r + 65);
        }
      }
    } else {
      // Story or square: 1 large hero + 4 below in 2x2 (square) or vertical column (story)
      const heroR = isStory ? 200 : 160;
      const heroY = isStory ? 360 : 290;
      await drawCircleImage(ctx, W / 2, heroY + heroR, heroR, top5[0].thumb, '🎂');

      ctx.fillStyle = 'white';
      ctx.font = `bold ${isStory ? 68 : 52}px system-ui, sans-serif`;
      ctx.textAlign = 'center';
      const heroName = top5[0].name.length > 22 ? top5[0].name.slice(0, 20) + '…' : top5[0].name;
      ctx.fillText(heroName, W / 2, heroY + heroR * 2 + 80);

      if (top5[0].year) {
        ctx.fillStyle = 'rgba(255,255,255,0.8)';
        ctx.font = `bold ${isStory ? 40 : 32}px system-ui, sans-serif`;
        ctx.fillText(`Född ${top5[0].year}`, W / 2, heroY + heroR * 2 + 130);
      }

      // 2x2 grid for the remaining 4
      const others = top5.slice(1, 5);
      const smallR = isStory ? 110 : 90;
      const gridTop = heroY + heroR * 2 + 230;
      const gridGap = isStory ? 320 : 240;
      const cellW = gridGap;
      const cellH = isStory ? 220 : 200;
      const cols = 2;
      for (let i = 0; i < others.length; i++) {
        const col = i % cols;
        const row = Math.floor(i / cols);
        const cx = W / 2 + (col === 0 ? -cellW / 2 : cellW / 2);
        const cy = gridTop + row * cellH + smallR;
        await drawCircleImage(ctx, cx, cy, smallR, others[i].thumb, '🎂');
        ctx.fillStyle = 'white';
        ctx.font = `bold ${isStory ? 30 : 26}px system-ui, sans-serif`;
        ctx.textAlign = 'center';
        const name = others[i].name.length > 18 ? others[i].name.slice(0, 16) + '…' : others[i].name;
        ctx.fillText(name, cx, cy + smallR + 36);
        if (others[i].year) {
          ctx.fillStyle = 'rgba(255,255,255,0.7)';
          ctx.font = `${isStory ? 26 : 22}px system-ui, sans-serif`;
          ctx.fillText(`(${others[i].year})`, cx, cy + smallR + 66);
        }
      }
    }

    paintFooter(ctx, W, H, isLandscape);
  }

  function buildPostCopy(): string {
    const dateStr = currentDate
      ? currentDate.toLocaleDateString('sv-SE', { day: 'numeric', month: 'long' })
      : 'idag';
    const lines: string[] = [];
    lines.push(`🎂 Födda ${dateStr}:`);
    lines.push('');
    for (const p of currentTop.slice(0, 5)) {
      const y = p.year ? ` (${p.year})` : '';
      lines.push(`• ${p.name}${y}`);
    }
    lines.push('');
    lines.push('Glöm aldrig en födelsedag igen — Födelsedagar-appen påminner dig 1 månad, 1 vecka och 1 dag innan.');
    lines.push('');
    lines.push('📲 https://apps.apple.com/se/app/födelsedagar/id6758899294');
    return lines.join('\n');
  }

  async function generateShareImage() {
    if (!currentHero) return;
    const fmt = fmtSel.value;
    const layout = layoutSel.value;
    const size = canvasSize(fmt);
    canvas.width = size.w;
    canvas.height = size.h;
    canvas.classList.remove('hidden');
    shareActions.classList.add('hidden');

    const ctx = canvas.getContext('2d')!;
    ctx.clearRect(0, 0, size.w, size.h);

    if (layout === 'grid') {
      await paintGrid(ctx, size.w, size.h, fmt === 'landscape');
    } else {
      await paintHero(ctx, size.w, size.h, fmt === 'landscape');
    }

    // Build post copy + show
    postCopyText.value = buildPostCopy();
    postCopy.classList.remove('hidden');

    // Show download/share buttons + set up Web Share
    canvas.toBlob((blob) => {
      if (!blob) return;
      const objUrl = URL.createObjectURL(blob);
      downloadLink.href = objUrl;
      const filename = `fodelsedag-${fmt}-${layout}.png`;
      downloadLink.download = filename;
      shareActions.classList.remove('hidden');

      shareBtn.onclick = async () => {
        const file = new File([blob], filename, { type: 'image/png' });
        if (navigator.share && navigator.canShare?.({ files: [file] })) {
          try {
            await navigator.share({
              files: [file],
              title: 'Födelsedagar',
              text: buildPostCopy(),
            });
          } catch {/* cancelled */}
        } else {
          downloadLink.click();
        }
      };
    }, 'image/png');
  }

  copyTextBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(postCopyText.value);
      copyTextBtn.textContent = '✓ Kopierat!';
      setTimeout(() => { copyTextBtn.textContent = 'Kopiera text'; }, 1500);
    } catch {/* clipboard blocked */}
  });

  generateBtn.addEventListener('click', generateShareImage);

  inp.addEventListener('change', () => {
    if (!inp.value) return;
    const d = new Date(inp.value);
    if (!isNaN(d.getTime())) loadFor(d);
  });

  // Default: today's date so visitors immediately see something.
  const t = new Date();
  inp.value = t.toISOString().slice(0, 10);
  loadFor(t);
</script>
