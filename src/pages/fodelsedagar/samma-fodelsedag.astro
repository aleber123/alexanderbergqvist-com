  function format(template: string, name: string, age: number | string): string {
    return template.replaceAll('{name}', name).replaceAll('{age}', String(age));
  }

  function currentAge(birthYear: number | undefined): number | null {
    if (!birthYear || !currentDate) return null;
    return currentDate.getFullYear() - birthYear;
  }

  type WikiPage = {
    normalizedtitle?: string;
    extract?: string;
    thumbnail?: { source: string };
  };
  type WikiEntry = {
    text: string;
    year?: number;
    pages?: WikiPage[];
  };
  type Hero = {
    name: string;
    year?: number;
    desc?: string;
    thumb?: string;
  };

  let currentHero: Hero | null = null;
  let currentTop: Hero[] = [];
  let currentDate: Date | null = null;

  function showError(msg: string) {
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
    loading.classList.add('hidden');
    results.classList.add('hidden');
  }

  function clean(text: string): string {
    // Wikipedia returns "Björn Borg, svensk tennisspelare" — strip
    // anything after the first comma to get just the name for the hero.
    return text.split(',')[0].trim();
  }

  function describe(text: string): string {
    const parts = text.split(',');
    return parts.length > 1 ? parts.slice(1).join(',').trim() : '';
  }

  async function fetchOnThisDay(month: number, day: number) {
    const mm = String(month).padStart(2, '0');
    const dd = String(day).padStart(2, '0');
    const url = `https://sv.wikipedia.org/api/rest_v1/feed/onthisday/all/${mm}/${dd}`;
    const r = await fetch(url);
    if (!r.ok) throw new Error('Wikipedia svarade inte');
    return r.json();
  }

  function render(data: any) {
    const allBirths: WikiEntry[] = data.births || [];
    const allEvents: WikiEntry[] = data.events || [];

    // Sort by recency (most recent year first — younger celebrities)
    // and prioritise entries with thumbnails (= more notable).
    const scoredBirths = allBirths
      .map((b) => ({
        ...b,
        score:
          (b.pages?.[0]?.thumbnail ? 1000 : 0) +
          (b.year ?? 0) / 10,
      }))
      .sort((a, b) => b.score - a.score)
      .slice(0, 8);

    const scoredEvents = allEvents
      .map((e) => ({
        ...e,
        score:
          (e.pages?.[0]?.thumbnail ? 1000 : 0) + (e.year ?? 0) / 10,
      }))
      .sort((a, b) => b.score - a.score)
      .slice(0, 5);

    if (scoredBirths.length === 0) {
      showError('Wikipedia har ingen data för det datumet — ovanligt men händer.');
      return;
    }

    // Hero = first scored birth (highest-ranked notable)
    const top = scoredBirths[0];
    currentHero = {
      name: clean(top.text),
      year: top.year,
      desc: describe(top.text),
      thumb: top.pages?.[0]?.thumbnail?.source,
    };
    // Keep top 10 in `currentTop` so the person-selector has plenty to
    // choose from while keeping the dropdown manageable.
    currentTop = scoredBirths.slice(0, 10).map((b) => ({
      name: clean(b.text),
      year: b.year,
      desc: describe(b.text),
      thumb: b.pages?.[0]?.thumbnail?.source,
    }));
    heroName.textContent =
      currentHero.name + (top.year ? ` (${top.year})` : '');
    heroDesc.textContent = currentHero.desc || '';

    // Populate person dropdown so the user can pick which celebrity
    // to feature in the social-media post.
    personSel.innerHTML = currentTop
      .map((p, i) => {
        const yr = p.year ? ` (${p.year})` : '';
        return `<option value="${i}">${p.name}${yr}</option>`;
      })
      .join('');
    personSel.value = '0';

    births.innerHTML = scoredBirths
      .map((b) => {
        const name = clean(b.text);
        const desc = describe(b.text);
        const year = b.year ? `<span class="text-pink-700 font-bold">${b.year}</span>` : '';
        const img = b.pages?.[0]?.thumbnail?.source;
        return `
          <li class="flex gap-3 rounded-xl border border-slate-200 bg-white p-3">
            ${img
              ? `<img src="${img}" alt="" class="w-12 h-12 rounded-full object-cover flex-shrink-0" loading="lazy">`
              : `<div class="w-12 h-12 rounded-full bg-slate-200 flex-shrink-0 flex items-center justify-center text-slate-400">🎂</div>`}
            <div class="flex-1 min-w-0">
              <div class="font-bold text-sm">${name}</div>
              <div class="text-xs text-slate-600 truncate">${desc}</div>
              <div class="text-xs mt-1">${year}</div>
            </div>
          </li>`;
      })
      .join('');

    events.innerHTML = scoredEvents
      .map((e) => {
        const year = e.year ? `<span class="text-pink-700 font-bold">${e.year}</span>` : '';
        return `
          <li class="rounded-xl border border-slate-200 bg-white p-3">
            <div class="text-sm">${e.text}</div>
            <div class="text-xs mt-1">${year}</div>
          </li>`;
      })
      .join('');

    results.classList.remove('hidden');
    loading.classList.add('hidden');
    errorBox.classList.add('hidden');
  }

  async function loadFor(date: Date) {
    currentDate = date;
    loading.classList.remove('hidden');
    errorBox.classList.add('hidden');
    results.classList.add('hidden');
    canvas.classList.add('hidden');
    shareActions.classList.add('hidden');
    postCopy.classList.add('hidden');
    try {
      const data = await fetchOnThisDay(date.getMonth() + 1, date.getDate());
      render(data);
    } catch (e) {
      showError('Kunde inte hämta från Wikipedia. Försök igen om en stund.');
    }
  }

  // ── Share-image generation ─────────────────────────────────────
  async function loadImage(url: string): Promise<HTMLImageElement> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => resolve(img);
      img.onerror = reject;
      img.src = url;
    });
  }

  function wrap(
    ctx: CanvasRenderingContext2D,
    text: string,
    x: number,
    y: number,
    maxWidth: number,
    lineHeight: number,
  ): number {
    const words = text.split(' ');
    let line = '';
    let lines = 0;
    for (const w of words) {
      const testLine = line + w + ' ';
      const m = ctx.measureText(testLine);
      if (m.width > maxWidth && line !== '') {
        ctx.fillText(line.trim(), x, y);
        line = w + ' ';
        y += lineHeight;
        lines += 1;
      } else {
        line = testLine;
      }
    }
    if (line.trim()) {
      ctx.fillText(line.trim(), x, y);
      lines += 1;
    }
    return lines * lineHeight;
  }

  // Always 1080×1080 — universal FB + IG feed format.
  const CANVAS_W = 1080;
  const CANVAS_H = 1080;

  // ── Design tokens (deep audience research drove these) ─────────
  // 50+ Swedish FB users respond to:
  //   - Warm cream + deep wine + muted gold (not pink, not stark white)
  //   - Serif typography (signals tradition + trust)
  //   - Polaroid / portrait frame (nostalgia trigger)
  //   - Question-prompt captions (drives comments → algo boost)
  const COLOR = {
    bgTop:      '#FBF3E1',   // warm cream top
    bgBottom:   '#F2E0BE',   // deeper parchment bottom
    ink:        '#2C1810',   // dark warm brown — readable, premium
    accent:     '#8B2635',   // deep wine red — birthday + elegance
    gold:       '#B8941F',   // subdued gold (frame, dividers)
    softInk:    '#6B5A4A',   // secondary text
    photoBg:    '#FFFCEF',   // photo card background
  };
  // Fonts — Georgia is universally available and renders beautifully
  // at large sizes. Loading a webfont via FontFace would be nicer but
  // adds async complexity + a network round-trip; Georgia is "good
  // enough beautiful" and works offline.
  const FONT_SERIF = 'Georgia, "Times New Roman", serif';
  const FONT_SANS = 'system-ui, -apple-system, "Segoe UI", sans-serif';

  function paintBackground(ctx: CanvasRenderingContext2D, W: number, H: number) {
    const grad = ctx.createLinearGradient(0, 0, 0, H);
    grad.addColorStop(0, COLOR.bgTop);
    grad.addColorStop(1, COLOR.bgBottom);
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);
  }

  /**
   * Photo in a Polaroid-style frame: cream card with soft drop shadow,
   * thin gold inner line, photo with a subtle 8px ivory padding. Gives
   * the "portrait" feeling that ages 50+ associate with treasured
   * family photos.
   */
  async function drawPolaroidImage(
    ctx: CanvasRenderingContext2D,
    cx: number,
    cy: number,
    w: number,
    h: number,
    thumb: string | undefined,
    fallback: string,
  ) {
    const x = cx - w / 2;
    const y = cy - h / 2;
    const r = 14;

    // Drop shadow (offset behind)
    ctx.save();
    ctx.shadowColor = 'rgba(44, 24, 16, 0.18)';
    ctx.shadowBlur = 32;
    ctx.shadowOffsetY = 12;

    // Card background (the "Polaroid" itself)
    ctx.fillStyle = COLOR.photoBg;
    ctx.beginPath();
    if (typeof (ctx as any).roundRect === 'function') {
      (ctx as any).roundRect(x, y, w, h, r);
    } else {
      ctx.rect(x, y, w, h);
    }
    ctx.fill();
    ctx.restore();

    // Thin gold inner line for elegance
    ctx.strokeStyle = COLOR.gold;
    ctx.lineWidth = 2;
    ctx.beginPath();
    if (typeof (ctx as any).roundRect === 'function') {
      (ctx as any).roundRect(x + 8, y + 8, w - 16, h - 16, r - 4);
    } else {
      ctx.rect(x + 8, y + 8, w - 16, h - 16);
    }
    ctx.stroke();

    // Photo area: 24px padding inside the gold line
    const inset = 24;
    const px = x + inset;
    const py = y + inset;
    const pw = w - inset * 2;
    const ph = h - inset * 2;

    ctx.save();
    ctx.beginPath();
    if (typeof (ctx as any).roundRect === 'function') {
      (ctx as any).roundRect(px, py, pw, ph, 6);
    } else {
      ctx.rect(px, py, pw, ph);
    }
    ctx.closePath();
    ctx.clip();

    let painted = false;
    if (thumb) {
      try {
        const img = await loadImage(thumb);
        const ratio = img.width / img.height;
        let drawW = pw;
        let drawH = ph;
        // Cover crop
        const targetRatio = pw / ph;
        if (ratio > targetRatio) {
          drawH = ph;
          drawW = ph * ratio;
        } else {
          drawW = pw;
          drawH = pw / ratio;
        }
        ctx.drawImage(img, px + (pw - drawW) / 2, py + (ph - drawH) / 2, drawW, drawH);
        painted = true;
      } catch {/* fall through */}
    }
    if (!painted) {
      ctx.fillStyle = '#E8DDC5';
      ctx.fillRect(px, py, pw, ph);
      ctx.fillStyle = COLOR.softInk;
      ctx.font = `${pw * 0.5}px ${FONT_SERIF}`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(fallback, cx, cy);
      ctx.textBaseline = 'alphabetic';
    }
    ctx.restore();
  }

  /** Decorative divider — three small diamonds in muted gold. */
  function paintDivider(ctx: CanvasRenderingContext2D, cx: number, y: number) {
    ctx.fillStyle = COLOR.gold;
    const gap = 16;
    const size = 5;
    for (let i = -1; i <= 1; i++) {
      ctx.save();
      ctx.translate(cx + i * gap * 4, y);
      ctx.rotate(Math.PI / 4);
      ctx.fillRect(-size / 2, -size / 2, size, size);
      ctx.restore();
    }
  }

  // ── Layout: ELEGANT PORTRAIT (Polaroid-style, 50+ optimized) ───
  // All Y positions are fixed and tuned so the bottom CTA block
  // never collides with the name/age area regardless of name length.
  // The Wikipedia description is intentionally NOT drawn on the card
  // — it pushes content into the CTA strip and made the bottom half
  // overlap. The description still lives in the post copy below.
  async function paintHero(ctx: CanvasRenderingContext2D, person: Hero, lang: string) {
    const W = CANVAS_W;
    const H = CANVAS_H;
    const t = i18n[lang] ?? i18n.sv;
    const age = currentAge(person.year);

    paintBackground(ctx, W, H);

    // ── 1. EYEBROW + DATE ────────────────────────────────────────
    ctx.fillStyle = COLOR.accent;
    ctx.font = `italic 30px ${FONT_SERIF}`;
    ctx.textAlign = 'center';
    ctx.fillText(t.eyebrow, W / 2, 92);

    if (currentDate) {
      const dateStr = currentDate.toLocaleDateString(t.dateFmt, {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      });
      ctx.fillStyle = COLOR.softInk;
      ctx.font = `400 26px ${FONT_SERIF}`;
      ctx.fillText(dateStr, W / 2, 134);
    }

    paintDivider(ctx, W / 2, 170);

    // ── 2. POLAROID PHOTO ───────────────────────────────────────
    // 420×400 fits a comfortable rectangle without crowding either
    // side of the card. Photo runs y=210 to y=610.
    const photoW = 420;
    const photoH = 400;
    const photoCY = 210 + photoH / 2;
    await drawPolaroidImage(
      ctx, W / 2, photoCY, photoW, photoH, person.thumb, '🎂',
    );

    // ── 3. NAME — auto-shrink to one line, fixed baseline ────────
    const NAME_Y = 695;
    const NAME_MAX_WIDTH = W - 140; // 940 px
    let nameFont = 64;
    ctx.font = `700 ${nameFont}px ${FONT_SERIF}`;
    while (ctx.measureText(person.name).width > NAME_MAX_WIDTH && nameFont > 36) {
      nameFont -= 4;
      ctx.font = `700 ${nameFont}px ${FONT_SERIF}`;
    }
    ctx.fillStyle = COLOR.ink;
    ctx.textAlign = 'center';
    ctx.fillText(person.name, W / 2, NAME_Y);

    // ── 4. AGE — italic serif, fixed baseline below name ──────────
    if (age !== null) {
      ctx.fillStyle = COLOR.accent;
      ctx.font = `italic 36px ${FONT_SERIF}`;
      ctx.fillText(format(t.ageSuffix, person.name, age), W / 2, 760);
    }

    // ── 5. THIN GOLD DIVIDER LINE ────────────────────────────────
    ctx.strokeStyle = COLOR.gold;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(W / 2 - 200, 815);
    ctx.lineTo(W / 2 + 200, 815);
    ctx.stroke();

    // ── 6. ENGAGEMENT PROMPT (algorithm-boost lever) ─────────────
    ctx.fillStyle = COLOR.accent;
    ctx.font = `bold 36px ${FONT_SERIF}`;
    ctx.textAlign = 'center';
    ctx.fillText(t.prompt, W / 2, 875);

    // ── 7. PITCH — one short emotional sales line ────────────────
    ctx.fillStyle = COLOR.ink;
    ctx.font = `400 26px ${FONT_SANS}`;
    ctx.fillText(t.pitch, W / 2, 935);

    // ── 8. APP BADGE — tasteful gold wordmark at bottom ──────────
    ctx.fillStyle = COLOR.gold;
    ctx.font = `bold 20px ${FONT_SANS}`;
    ctx.fillText(`🎂  ${t.appName.toUpperCase()}`, W / 2, 1000);
  }

  function buildPostCopy(person: Hero, lang: string): string {
    const t = i18n[lang] ?? i18n.sv;
    const age = currentAge(person.year);
    const lines: string[] = [];
    // Headline with 🎂 — emoji belongs in the caption (text), not on
    // the elegant image. FB feed scans benefit from a single emoji.
    lines.push(
      age !== null ? `🎂 ${format(t.line1, person.name, age)}` : person.name,
    );
    // Description is in Swedish (from sv.wikipedia.org). Only include
    // it if the post itself is Swedish — otherwise it sticks out as
    // foreign text in an otherwise-English/German/… caption.
    if (person.desc && lang === 'sv') {
      lines.push('');
      lines.push(person.desc);
    }
    // Engagement prompt — drives comments → algo boost.
    lines.push('');
    lines.push(t.prompt);
    // Pitch + App Store
    lines.push('');
    lines.push(t.cta);
    lines.push('');
    lines.push(`📲 ${t.storeUrl}`);
    return lines.join('\n');
  }

  async function generateShareImage() {
    if (currentTop.length === 0) return;
    const idx = parseInt(personSel.value, 10) || 0;
    const person = currentTop[idx];
    const lang = langSel.value;

    canvas.width = CANVAS_W;
    canvas.height = CANVAS_H;
    canvas.classList.remove('hidden');
    shareActions.classList.add('hidden');

    const ctx = canvas.getContext('2d')!;
    ctx.clearRect(0, 0, CANVAS_W, CANVAS_H);

    await paintHero(ctx, person, lang);

    // Build post copy + show
    postCopyText.value = buildPostCopy(person, lang);
    postCopy.classList.remove('hidden');

    // Wire up download + Web Share
    canvas.toBlob((blob) => {
      if (!blob) return;
      const objUrl = URL.createObjectURL(blob);
      downloadLink.href = objUrl;
      const safeName = person.name
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
      const filename = `fodelsedag-${safeName}-${lang}.png`;
      downloadLink.download = filename;
      shareActions.classList.remove('hidden');

      shareBtn.onclick = async () => {
        const file = new File([blob], filename, { type: 'image/png' });
        if (navigator.share && navigator.canShare?.({ files: [file] })) {
          try {
            await navigator.share({
              files: [file],
              title: 'Födelsedagar',
              text: buildPostCopy(person, lang),
            });
          } catch {/* cancelled */}
        } else {
          downloadLink.click();
        }
      };
    }, 'image/png');
  }

  copyTextBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(postCopyText.value);
      copyTextBtn.textContent = '✓ Kopierat!';
      setTimeout(() => { copyTextBtn.textContent = 'Kopiera text'; }, 1500);
    } catch {/* clipboard blocked */}
  });

  generateBtn.addEventListener('click', generateShareImage);

  inp.addEventListener('change', () => {
    if (!inp.value) return;
    const d = new Date(inp.value);
    if (!isNaN(d.getTime())) loadFor(d);
  });

  // Default: today's date so visitors immediately see something.
  const t = new Date();
  inp.value = t.toISOString().slice(0, 10);
  loadFor(t);
</script>
