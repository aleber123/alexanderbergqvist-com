---
import BaseLayout from '../../../components/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import recipes from '../../../data/recipes.json';

interface Recipe {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  difficulty: 'beginner' | 'intermediate' | 'advanced';
  yields_loaves: number;
  prep_minutes: number;
  total_minutes: number;
  ingredients: Array<{ name: string; grams: number; is_flour?: boolean; is_water?: boolean }>;
}

const list = recipes as unknown as Recipe[];

// Group by difficulty for visual hierarchy
const byDifficulty = {
  beginner: list.filter((r) => r.difficulty === 'beginner'),
  intermediate: list.filter((r) => r.difficulty === 'intermediate'),
  advanced: list.filter((r) => r.difficulty === 'advanced'),
};

const difficultyLabel = {
  beginner: 'Nybörjare',
  intermediate: 'Mellan',
  advanced: 'Avancerad',
};

function fmtTime(mins: number) {
  if (mins >= 60) {
    const h = Math.floor(mins / 60);
    const m = mins % 60;
    return m === 0 ? `${h}h` : `${h}h ${m}m`;
  }
  return `${mins}m`;
}

function hydration(r: Recipe) {
  const flour = r.ingredients.filter((i) => i.is_flour).reduce((s, i) => s + i.grams, 0);
  const water = r.ingredients.filter((i) => i.is_water).reduce((s, i) => s + i.grams, 0);
  return flour > 0 ? Math.round((water / flour) * 100) : null;
}
---

<BaseLayout
  title="33 surdegsrecept — från klassisk vit limpa till lussekatter"
  description="Komplett samling svenska och internationella surdegsrecept. Vit limpa, råglimpa, ciabatta, kanelbullar, lussekatter och 28 till — alla med exakt hydration och steg."
  keywords={[
    'surdegsrecept',
    'surdeg recept',
    'surdegslimpa',
    'svenska surdegsrecept',
    'surdeg från grunden',
  ]}
>
  <section class="max-w-5xl mx-auto px-6 py-8">
    <Breadcrumbs
      trail={[
        { name: 'Hem', url: '/' },
        { name: 'Surdeg', url: '/surdeg/' },
        { name: 'Recept' },
      ]}
    />

    <h1 class="mt-6 text-3xl md:text-5xl font-black tracking-tight">
      Surdegsrecept
    </h1>
    <p class="mt-3 text-lg text-slate-600 max-w-2xl">
      {list.length} sorter — svenska klassiker (limpa, lussekatter,
      vörtbröd) blandade med internationella favoriter (ciabatta,
      brioche, naan). Alla med exakt hydration, ingredienslista och
      steg-för-steg.
    </p>

    {(['beginner', 'intermediate', 'advanced'] as const).map((diff) => (
      <section class="mt-10">
        <h2 class="text-2xl font-black mb-4">
          {difficultyLabel[diff]}
          <span class="text-sm font-normal text-slate-500 ml-2">
            ({byDifficulty[diff].length})
          </span>
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-3">
          {byDifficulty[diff].map((r) => {
            const h = hydration(r);
            return (
              <a
                href={`/surdeg/recept/${r.id}/`}
                class="block rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300 hover:shadow-md transition"
              >
                <div class="font-bold text-slate-900 text-lg">{r.title}</div>
                <p class="text-sm text-slate-600 mt-1 line-clamp-2">
                  {r.subtitle}
                </p>
                <div class="mt-3 flex flex-wrap gap-2 text-xs">
                  <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 font-bold">
                    ⏱️ {fmtTime(r.total_minutes)}
                  </span>
                  <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 font-bold">
                    🍞 {r.yields_loaves}
                  </span>
                  {h && (
                    <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-900 font-bold">
                      💧 {h}%
                    </span>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>
