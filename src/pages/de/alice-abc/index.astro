---
/**
 * Alice ABC: Lesen lernen — German landing page. Twins: /alice-abc/ (sv)
 * and /en/alice-abc/ (en). Hand-written like the en page; the
 * [lang]/[app] template skips Alice via `customPage`.
 *
 * TODO when 1.0.2 (German edition) is on sale: set GERMAN_LIVE = true
 * (removes the "ab Version 1.0.2" notice).
 * TODO after 2026-11-24: remove the "zum Start 5,99 €" launch price lines.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../../../components/BaseLayout.astro';
import FAQ from '../../../components/FAQ.astro';
import { tagAppStoreUrl } from '../../../lib/appstore';

const GERMAN_LIVE = true;

const app = (await getEntry('apps', 'alice-abc'))!;
const { appStoreUrl, status, accent, accentDark } = app.data;
const live = status === 'live' && !!appStoreUrl;
// German storefront (DE); visitors from AT/CH are redirected by Apple.
const deStoreUrl = 'https://apps.apple.com/de/app/id6829534435';
const heroUrl = live ? tagAppStoreUrl(deStoreUrl, Astro.url.pathname, { position: 'hero' }) : undefined;
const footerUrl = live ? tagAppStoreUrl(deStoreUrl, Astro.url.pathname, { position: 'footer' }) : undefined;
const email = 'alexander.bergqvist@gmail.com';

const title = 'Alice ABC: Lesen lernen – mit Silben und deiner eigenen Stimme';
const description =
  'Alice ABC bringt Kindern von 4 bis 7 Jahren das Lesen bei wie in der Schule: Laute, Silben, Wörter, Sätze. Nimm deine eigene Stimme auf. Keine Werbung, keine Daten, offline.';

const alternates = {
  'sv-SE': new URL('/alice-abc/', Astro.site).href,
  'en-US': new URL('/en/alice-abc/', Astro.site).href,
  'de-DE': new URL('/de/alice-abc/', Astro.site).href,
};

const shots = [
  { src: '/apps/alice-abc/de_1.webp', alt: 'Dein Kind hört deine Stimme: Ein Elternteil nimmt den Laut i auf' },
  { src: '/apps/alice-abc/de_2.webp', alt: 'Lesen lernen mit Silben: Son–ne mit Silbenbögen' },
  { src: '/apps/alice-abc/de_3.webp', alt: 'Eine Karte, vier Stufen: Laute, Silben, Wörter und Sätze' },
  { src: '/apps/alice-abc/de_4.webp', alt: 'Der Silbenteppich: ha, hi, ho, he – erst Silben, dann Wörter' },
  { src: '/apps/alice-abc/de_5.webp', alt: 'Über zehn Lernspiele: Ballons, Memory und Wort bauen' },
  { src: '/apps/alice-abc/de_6.webp', alt: 'Dein Kind liest laut vor: das Wort Ohr, Spracherkennung auf dem Gerät' },
  { src: '/apps/alice-abc/de_7.webp', alt: 'Bereich für Erwachsene: Fortschritt, eigene Aufnahmen und Übungszeit' },
  { src: '/apps/alice-abc/de_8.webp', alt: 'Ein neuer Sticker – ohne Werbung, offline, keine Datenerhebung' },
];

const levels = [
  { t: 'Laute', d: 'Dein Kind lernt, was die Buchstaben sagen – „mmm“, nicht „em“. Buchstaben nachspuren und den Anlaut in Wörtern finden.' },
  { t: 'Silben', d: 'Laute werden zu Silben, Silben zu Wörtern: Son–ne, To–ma–te. Mit Silbenbögen wie in der Schule und dem Silbenteppich.' },
  { t: 'Wörter', d: 'Dein Kind liest ganze Wörter und ordnet sie Bildern zu. Neue Wörter kommen, wenn die bekannten sitzen.' },
  { t: 'Sätze', d: 'Kurze Sätze aus Wörtern, die dein Kind schon kennt – der letzte Schritt vom Erlesen zum Lesen.' },
];

const games = [
  'Laute mit Nachspuren',
  'Ballons',
  'Anlaut',
  'Silbenteppich',
  'Zusammenlesen',
  'Wort bauen',
  'Memo-Spiel',
  'Welches Wort fehlt?',
  'Laut lesen',
];

const faq = [
  {
    q: 'Für welches Alter ist Alice ABC?',
    a: 'Für Kinder von etwa 4 bis 7 Jahren – in der Vorschule, zum Schulanfang oder als Übung zu Hause neben der Fibel. Die App beginnt mit den Lauten und geht im Tempo deines Kindes bis zu ganzen Sätzen.',
  },
  {
    q: 'Wie stelle ich die Sprache auf Deutsch um?',
    a: 'Öffne den Bereich „Für Erwachsene“ (Schloss-Taste oben rechts auf der Karte, hinter einer Elternsperre) und wähle Einstellungen → Lesesprache → Deutsch. Deutsch ist ab Version 1.0.2 verfügbar; Englisch und Schwedisch sind ebenfalls enthalten.',
  },
  {
    q: 'Wie nehme ich meine eigene Stimme auf?',
    a: 'Im Bereich „Für Erwachsene“ → Aufnehmen. Du kannst jeden Laut, jedes Wort, jeden Satz, jede Anleitung und jedes Lob aufnehmen – zum Start reichen ein paar Laute, die App zeigt, was als Nächstes kommt. Was du aufgenommen hast, ersetzt die Stimme des Geräts. Einzelne Aufnahmen kannst du dort löschen und neu aufnehmen.',
  },
  {
    q: 'Wie stelle ich meinen Kauf wieder her?',
    a: 'Im Bereich „Für Erwachsene“ auf „Kauf wiederherstellen“ tippen und – falls gefragt – mit derselben Apple-ID anmelden, mit der gekauft wurde. Der Kauf ist über die Familienfreigabe teilbar: Hat jemand anderes in der Familie gekauft, schalte die Freigabe von Käufen ein und tippe dann auf diesem Gerät auf „Kauf wiederherstellen“.',
  },
  {
    q: 'Warum braucht die App das Mikrofon?',
    a: 'Nur für zwei Dinge: wenn ein Elternteil die eigene Stimme aufnimmt, und für die Übung „Laut lesen“, wenn ein Elternteil sie einschaltet. Die Spracherkennung läuft auf dem Gerät mit Apples Frameworks. Kein Ton und kein Text verlässt das Gerät, Aufnahmen werden nur dort gespeichert.',
  },
  {
    q: 'Braucht die App Internet?',
    a: 'Nein. Alice ABC funktioniert komplett offline, auch im Auto oder Flugzeug. Es gibt keine Server und kein Konto.',
  },
  {
    q: 'Was kostet die App?',
    a: 'Kostenlos starten: die ganze Stufe 1 (Laute) und ein erster Einblick in Stufe 2 (Silben). Alles freischalten mit einem Einmalkauf für 7,99 € (zum Start 5,99 € bis 24. November) – kein Abo. Mit Familienfreigabe reicht ein Kauf für die ganze Familie.',
  },
];

const ldJson = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Alice ABC: Lesen lernen',
  description,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'iOS, iPadOS',
  inLanguage: ['de', 'en', 'sv'],
  url: new URL('/de/alice-abc/', Astro.site).href,
  image: new URL('/apps/alice-abc/icon-256.webp', Astro.site).href,
  audience: { '@type': 'PeopleAudience', suggestedMinAge: 4, suggestedMaxAge: 7 },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    availability: live ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
  },
  author: { '@type': 'Person', name: 'Alexander Bergqvist', url: 'https://alexanderbergqvist.com/' },
  ...(live && { downloadUrl: deStoreUrl, installUrl: deStoreUrl }),
};

const appleSvg = 'M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z';
---

<BaseLayout title={title} description={description} htmlLang="de-DE" hreflangAlternates={alternates} keywords={['Lesen lernen App', 'Silbenmethode', 'Anlaute', 'Leseanfänger', 'Erstklässler', 'Vorschule']}>
  <script type="application/ld+json" set:html={JSON.stringify(ldJson)} />

  <section class="relative overflow-hidden" style={`background: linear-gradient(135deg, ${accent}, ${accentDark ?? accent});`}>
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-24 text-white">
      <div class="grid md:grid-cols-[180px_1fr] gap-8 md:gap-12 items-center">
        <img src="/apps/alice-abc/icon-256.webp" alt="App-Symbol von Alice ABC" width="160" height="160" class="w-32 h-32 md:w-40 md:h-40 rounded-3xl shadow-2xl mx-auto md:mx-0" />
        <div class="text-center md:text-left">
          <span class="inline-block text-xs font-black uppercase tracking-widest opacity-80">4–7 Jahre · iPhone &amp; iPad</span>
          <h1 class="mt-2 text-4xl md:text-6xl font-black tracking-tight">Dein Kind hört deine Stimme</h1>
          <p class="mt-3 text-xl md:text-2xl font-bold opacity-95">Alice ABC: Lesen lernen mit Silben – wie in der Schule</p>
          <p class="mt-4 text-lg opacity-90 max-w-2xl">
            Laute, Silben, Wörter, Sätze: Alice ABC bringt deinem Kind Schritt für Schritt das Lesen bei.
            Und die Stimme, die dein Kind hört, kann deine sein.
          </p>
          {!GERMAN_LIVE && (
            <p class="mt-4 inline-block rounded-lg bg-white/15 px-3 py-2 text-sm font-semibold">
              Deutsch ist ab Version 1.0.2 verfügbar, die in Kürze erscheint. Bis dahin enthält die App Englisch und Schwedisch.
            </p>
          )}
          <div class="mt-8 flex flex-wrap gap-3 justify-center md:justify-start">
            {live ? (
              <a href={heroUrl} data-cta-position="hero" class="inline-flex items-center gap-3 rounded-xl px-5 py-3 font-bold bg-white text-ink hover:scale-[1.02] transition">
                <svg viewBox="0 0 384 512" class="w-5 h-5 fill-current" aria-hidden="true"><path d={appleSvg} /></svg>
                <span class="flex flex-col items-start leading-tight">
                  <span class="text-[10px] font-medium opacity-80">Laden im</span>
                  <span class="text-base font-bold">App Store</span>
                </span>
              </a>
            ) : (
              <span class="inline-flex items-center rounded-xl px-5 py-3 font-bold text-sm bg-white/20 text-white">Demnächst im App Store</span>
            )}
            <a href="#preis" class="inline-flex items-center rounded-xl px-5 py-3 font-bold text-sm border border-white/50 hover:bg-white/10">Kostenlos starten</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-10">
    <ul class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-2 md:grid md:grid-cols-4 md:overflow-visible">
      {shots.map((s, i) => (
        <li class="snap-start flex-shrink-0 w-[62%] sm:w-[40%] md:w-auto">
          <img src={s.src} alt={s.alt} width="660" height="1434" loading={i < 2 ? 'eager' : 'lazy'} class="w-full h-auto block rounded-2xl border border-line shadow-md" />
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-surface-2 border-y border-line py-16">
    <div class="max-w-3xl mx-auto px-6">
      <span class="text-xs font-black uppercase tracking-widest" style={`color: ${accent};`}>Was Alice ABC besonders macht</span>
      <h2 class="mt-2 text-2xl md:text-4xl font-black">Deine Stimme statt einer Roboterstimme</h2>
      <p class="mt-4 text-lg text-ink-2">
        Im Bereich für Erwachsene kannst du jeden Laut, jedes Wort, jeden Satz, jede Anleitung und jedes Lob
        selbst aufnehmen. Dann hört dein Kind Mama oder Papa, wenn Alice „Super gemacht!“ sagt oder „mmm wie in
        Maus“. Zum Start nimmst du in zwei Minuten nur ein paar Laute auf – den Rest, wann immer du Zeit hast.
        Was noch nicht aufgenommen ist, liest eine Stimme auf dem Gerät vor.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-2xl md:text-3xl font-black mb-8">So funktioniert es: vier Stufen</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
      {levels.map((l, i) => (
        <div class="bg-surface rounded-xl p-6 border border-line">
          <span class="inline-flex w-8 h-8 rounded-full items-center justify-center text-white font-black text-sm" style={`background: ${accent};`}>{i + 1}</span>
          <h3 class="mt-3 font-bold text-lg text-ink">{l.t}</h3>
          <p class="mt-2 text-ink-2">{l.d}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 text-ink-2"><strong>43 Laute und Buchstaben</strong> (auch sch, ch, ei, au, eu, ie, ä, ö, ü, ß), <strong>134 Wörter</strong> und <strong>56 Sätze</strong> zum Lesen.</p>
  </section>

  <section class="bg-surface-2 border-y border-line py-16">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-10">
      <div>
        <h2 class="text-2xl md:text-3xl font-black">Über zehn Lernspiele</h2>
        <p class="mt-3 text-ink-2">Jede Übung ist ein kurzes Spiel. Alice feuert dein Kind an, und unterwegs gibt es Sticker zu sammeln. Die App passt sich an: Was schwerfällt, kommt öfter wieder.</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {games.map((g) => (
            <li class="rounded-full border border-line bg-surface px-3 py-1.5 text-sm font-semibold text-ink-2">{g}</li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-2xl md:text-3xl font-black">Die Silbenmethode – wie in der Schule</h2>
        <ul class="mt-3 space-y-2 text-ink-2 list-disc pl-5">
          <li>Laute statt Buchstabennamen: „mmm“, nicht „em“</li>
          <li>Silbenbögen unter jedem Wort: Son–ne, To–ma–te</li>
          <li>Groß- und Kleinbuchstaben von Anfang an, ẞ inklusive</li>
          <li>Lange und kurze Selbstlaute markiert wie im Duden: Strich für lang, Punkt für kurz</li>
          <li>Buchstaben nachspuren in Druckschrift mit der richtigen Schreibrichtung</li>
          <li><strong>Laut lesen:</strong> Dein Kind liest das Wort laut vor und die App hört zu – die Spracherkennung läuft nur auf dem Gerät</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-2xl md:text-3xl font-black mb-8">Sicher für Kinder</h2>
    <div class="grid md:grid-cols-3 gap-4">
      <div class="rounded-xl border border-line p-6"><h3 class="font-bold text-lg">Keine Werbung</h3><p class="mt-2 text-ink-2">Keine Werbung, keine Links nach draußen. Käufe und Einstellungen liegen hinter einer Elternsperre.</p></div>
      <div class="rounded-xl border border-line p-6"><h3 class="font-bold text-lg">Funktioniert offline</h3><p class="mt-2 text-ink-2">Kein Server, kein Konto, keine Anmeldung. Alles funktioniert ohne Internet.</p></div>
      <div class="rounded-xl border border-line p-6"><h3 class="font-bold text-lg">Keine Daten</h3><p class="mt-2 text-ink-2">Keine Analyse, kein Tracking, keine Drittanbieter-SDKs. Deine Aufnahmen verlassen das Gerät nie. <a class="underline" href="/alice-abc/integritet/#english">Datenschutzerklärung (Englisch)</a>.</p></div>
    </div>
  </section>

  <section id="preis" class="bg-surface-2 border-y border-line py-16 scroll-mt-20">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-2xl md:text-3xl font-black">Kostenlos starten, ein Kauf für die ganze Familie</h2>
      <div class="mt-8 grid md:grid-cols-2 gap-4">
        <div class="rounded-xl border border-line bg-surface p-6">
          <h3 class="font-black text-lg">Kostenlos</h3>
          <ul class="mt-3 space-y-2 text-ink-2">
            <li>Die ganze Stufe 1: alle Laute</li>
            <li>Ein erster Einblick in Stufe 2 (Silben) – dein Kind liest die ersten Wörter zusammen</li>
            <li>Eigene Stimme aufnehmen</li>
            <li>Fortschritt für Erwachsene</li>
          </ul>
        </div>
        <div class="rounded-xl border-2 bg-surface p-6" style={`border-color: ${accent};`}>
          <h3 class="font-black text-lg">Alles freischalten</h3>
          <p class="mt-1 font-bold text-ink">7,99 € einmalig <span class="font-semibold text-ink-2">(zum Start 5,99 € bis 24. November)</span></p>
          <ul class="mt-3 space-y-2 text-ink-2">
            <li>Der Rest von Stufe 2, Stufe 3 Wörter und Stufe 4 Sätze</li>
            <li>Alle Spiele und alle Sticker</li>
            <li><strong>Einmalkauf</strong> – kein Abo</li>
            <li><strong>Familienfreigabe</strong> inklusive</li>
          </ul>
        </div>
      </div>
      <p class="mt-4 text-sm text-ink-3">Schon gekauft? Tippe im Bereich für Erwachsene auf „Kauf wiederherstellen“ – siehe <a class="underline" href="/support/#alice-abc">Support</a>.</p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-8">
    <FAQ title="Häufige Fragen" items={faq} />
  </section>

  <section class="max-w-3xl mx-auto px-6 pb-20 text-center">
    <p class="text-ink-2">Gemacht von einem Vater für seine Tochter Alice.</p>
    <div class="mt-6 inline-flex">
      {live ? (
        <a href={footerUrl} data-cta-position="footer" class="inline-flex items-center gap-3 rounded-xl px-5 py-3 font-bold text-sm bg-ink text-white hover:bg-ink-2 transition">
          <svg viewBox="0 0 384 512" class="w-5 h-5 fill-current" aria-hidden="true"><path d={appleSvg} /></svg>
          <span class="flex flex-col items-start leading-tight">
            <span class="text-[10px] font-medium opacity-80">Laden im</span>
            <span class="text-base font-bold">App Store</span>
          </span>
        </a>
      ) : (
        <span class="inline-flex items-center rounded-xl px-5 py-3 font-bold text-sm bg-surface-2 text-ink-3">Demnächst im App Store</span>
      )}
    </div>
    <p class="mt-6 text-sm text-ink-3">
      Fragen? Schreib mir: <a class="underline" href={`mailto:${email}?subject=Alice%20ABC`}>{email}</a> ·
      <a class="underline" href="/alice-abc/integritet/#english">Datenschutz</a> ·
      <a class="underline" href="/support/#alice-abc">Support</a> ·
      <a class="underline" href="/en/alice-abc/" hreflang="en">In English</a> ·
      <a class="underline" href="/alice-abc/" hreflang="sv">På svenska</a>
    </p>
  </section>
</BaseLayout>
