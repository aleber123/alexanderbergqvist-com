---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../components/BaseLayout.astro';
import AppStoreBadge from '../../components/AppStoreBadge.astro';
import LangSwitcher from '../../components/LangSwitcher.astro';
import {
  LOCALES,
  LOCALE_BCP47,
  UNIVERSAL_APPS,
  appsForLocale,
  t,
  type Locale,
} from '../../i18n/locales';

export const getStaticPaths = (async () => {
  return LOCALES.map((lang) => ({ params: { lang } }));
}) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const strings = t(lang);

const allApps = await getCollection('apps');
// Only list apps whose App Store listing is available in this locale —
// avoids dead "Download" CTAs (e.g. Polish home page shouldn't promote
// Födelsedagar since its ASC listing has no Polish translation).
const universalApps = appsForLocale(lang)
  .map((slug) => allApps.find((a) => a.id === slug))
  .filter((a): a is NonNullable<typeof a> => !!a);

// hreflang alternates — every locale links to its own home; sv goes to root.
const alternates: Record<string, string> = {
  'sv-SE': new URL('/', Astro.site).href,
};
for (const otherLang of LOCALES) {
  alternates[LOCALE_BCP47[otherLang]] = new URL(`/${otherLang}/`, Astro.site).href;
}
const switcherAlternates = {
  sv: new URL('/', Astro.site).href,
  ...Object.fromEntries(
    LOCALES.map((l) => [l, new URL(`/${l}/`, Astro.site).href]),
  ),
};
---

<BaseLayout
  title={strings.ui.appsTitle + ' · Alexander Bergqvist'}
  description={strings.ui.homeSubhero}
  htmlLang={LOCALE_BCP47[lang]}
  hreflangAlternates={alternates}
>
  <section class="bg-gradient-to-b from-surface-2 to-surface border-b border-line">
    <div class="max-w-6xl mx-auto px-6 py-10 md:py-14">
      <div class="flex justify-end mb-6">
        <LangSwitcher current={lang} alternates={switcherAlternates} />
      </div>
      <h1 class="text-3xl md:text-5xl font-black tracking-tight max-w-3xl">
        {strings.ui.homeHero}
      </h1>
      <p class="mt-4 text-lg text-ink-2 max-w-2xl">
        {strings.ui.homeSubhero}
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-2xl md:text-3xl font-black mb-2">
      {strings.ui.appsTitle}
    </h2>
    <p class="text-ink-2 mb-8">{strings.ui.appsSubtitle}</p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {universalApps.map((app) => {
        const tr = strings.apps[app.id];
        if (!tr) return null;
        return (
          <a
            href={`/${lang}/${app.id}/`}
            class="group rounded-2xl border border-line bg-surface p-6 transition hover:border-line-strong hover:shadow-md"
          >
            <div class="flex items-start gap-4">
              <img
                src={app.data.icon}
                alt={`${tr.name} app icon`}
                width="64"
                height="64"
                class="w-16 h-16 rounded-2xl flex-shrink-0"
              />
              <div>
                <h3 class="text-xl font-black group-hover:underline">
                  {tr.name}
                </h3>
                <p class="mt-1 text-sm text-ink-2">{tr.tagline}</p>
              </div>
            </div>
            <p class="mt-4 text-sm text-ink-2">{tr.description}</p>
          </a>
        );
      })}
    </div>
  </section>

  <section class="bg-surface-2 border-t border-line py-12">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-ink-2">{strings.ui.aboutAuthor}</p>
    </div>
  </section>
</BaseLayout>
