---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../components/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FAQ from '../../../components/FAQ.astro';
import AppStoreBadge from '../../../components/AppStoreBadge.astro';
import AuthorBox from '../../../components/AuthorBox.astro';
import { tagAppStoreUrl } from '../../../lib/appstore';
import { resolveOgImage } from '../../../lib/og';
import {
  LOCALES,
  LOCALE_BCP47,
  appSupportsLocale,
  localizeAppStoreUrl,
  type Locale,
} from '../../../i18n/locales';
import { articleTranslations, hreflangMap } from '../../../lib/article-translations';

export const getStaticPaths = (async () => {
  const articles = await getCollection(
    'articles',
    (a) => !a.data.draft && a.data.lang !== 'sv',
  );
  return articles.map((article) => {
    const slug = article.id.split('/').pop()!;
    return {
      params: {
        lang: article.data.lang,
        app: article.data.app,
        slug,
      },
      props: { article },
    };
  });
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const lang = Astro.params.lang as Locale;
const { Content } = await render(article);

const apps = await getCollection('apps');
const app = apps.find((a) => a.id === article.data.app);

// Localized "Read more" headings + breadcrumb labels — keeps UI in the
// same language as the article instead of leaking Swedish into an
// otherwise English/German/French page.
const ARTICLE_UI: Record<
  Locale,
  { home: string; readMore: string; updated: string; inGuide: string; get: string; otherLangs: string }
> = {
  en: { home: 'Home', readMore: 'Read more', updated: 'Updated', inGuide: 'The app in this guide', get: 'Get', otherLangs: 'Also available in' },
  de: { home: 'Start', readMore: 'Mehr lesen', updated: 'Aktualisiert', inGuide: 'Die App in dieser Anleitung', get: 'Holen', otherLangs: 'Auch verfügbar auf' },
  no: { home: 'Hjem', readMore: 'Les mer', updated: 'Oppdatert', inGuide: 'Appen i denne guiden', get: 'Hent', otherLangs: 'Også tilgjengelig på' },
  da: { home: 'Hjem', readMore: 'Læs mere', updated: 'Opdateret', inGuide: 'Appen i denne guide', get: 'Hent', otherLangs: 'Også tilgængelig på' },
  es: { home: 'Inicio', readMore: 'Leer más', updated: 'Actualizado', inGuide: 'La app de esta guía', get: 'Obtener', otherLangs: 'También disponible en' },
  fr: { home: 'Accueil', readMore: 'Lire la suite', updated: 'Mis à jour', inGuide: 'L’app de ce guide', get: 'Obtenir', otherLangs: 'Également disponible en' },
  fi: { home: 'Etusivu', readMore: 'Lue lisää', updated: 'Päivitetty', inGuide: 'Tämän oppaan sovellus', get: 'Hae', otherLangs: 'Saatavilla myös kielellä' },
  is: { home: 'Heim', readMore: 'Lesa meira', updated: 'Uppfært', inGuide: 'Appið í þessari handbók', get: 'Sækja', otherLangs: 'Einnig á' },
  it: { home: 'Home', readMore: 'Leggi di più', updated: 'Aggiornato', inGuide: 'L’app di questa guida', get: 'Scarica', otherLangs: 'Disponibile anche in' },
  el: { home: 'Αρχική', readMore: 'Διαβάστε περισσότερα', updated: 'Ενημερώθηκε', inGuide: 'Η εφαρμογή αυτού του οδηγού', get: 'Λήψη', otherLangs: 'Διαθέσιμο επίσης στα' },
  nl: { home: 'Home', readMore: 'Lees meer', updated: 'Bijgewerkt', inGuide: 'De app in deze gids', get: 'Download', otherLangs: 'Ook beschikbaar in' },
  pl: { home: 'Strona główna', readMore: 'Czytaj więcej', updated: 'Zaktualizowano', inGuide: 'Aplikacja z tego poradnika', get: 'Pobierz', otherLangs: 'Dostępne także w języku' },
  pt: { home: 'Início', readMore: 'Ler mais', updated: 'Atualizado', inGuide: 'O app deste guia', get: 'Obter', otherLangs: 'Também disponível em' },
};
const ui = ARTICLE_UI[lang];

const allArticles = await getCollection('articles', (a) => !a.data.draft);
// See the Swedish twin: was raw collection order, i.e. effectively
// random internal linking.
const COMMERCIAL = /(basta|best|bester|meilleur|mejor|migliore|vs-|jamfor|compare|vergleich)/i;
const related = allArticles
  .filter(
    (a) =>
      a.data.app === article.data.app &&
      a.data.lang === lang &&
      a.id !== article.id,
  )
  .sort((a, b) => {
    const ca = COMMERCIAL.test(a.id) ? 0 : 1;
    const cb = COMMERCIAL.test(b.id) ? 0 : 1;
    if (ca !== cb) return ca - cb;
    return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
  })
  .slice(0, 3);

// Reciprocal hreflang between this article and its translations.
const versions = articleTranslations(article, allArticles);
const otherVersions = versions.filter((v) => v.lang !== lang);

// /<lang>/<app>/ only exists for apps with a listing in that locale
// (e.g. there is no /en/rita/ — the breadcrumb used to 404 there).
const appHomeUrl = app
  ? appSupportsLocale(app.id, lang) ? `/${lang}/${app.id}/` : `/${app.id}/`
  : undefined;

const appStoreId = app?.data.appStoreUrl
  ? app.data.appStoreUrl.match(/\/id(\d+)/)?.[1]
  : undefined;

// Point readers at THEIR storefront. Without this every translated article
// sent German/English/Spanish readers to the Swedish App Store, where the
// listing is in Swedish and the price is in SEK — the helper already exists
// and [lang]/[app]/index.astro has always used it.
const localizedAppStoreUrl = localizeAppStoreUrl(app?.data.appStoreUrl, lang);

// Highest-position CTA on the page — was linking raw, so ASC never saw it.
// Campaign carries the locale so the storefronts stay separable in ASC.
const articleSlug = article.id.split('/').pop()!;
const heroAppStoreUrl = tagAppStoreUrl(localizedAppStoreUrl, Astro.url.pathname, {
  campaign: `${lang}_${articleSlug}`,
  position: 'hero',
});
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  type="article"
  publishedAt={article.data.publishedAt}
  updatedAt={article.data.updatedAt}
  keywords={article.data.keywords}
  image={resolveOgImage(article.data.app, articleSlug)}
  appStoreId={appStoreId}
  htmlLang={LOCALE_BCP47[lang]}
  hreflangAlternates={hreflangMap(versions)}
>
  <article class="max-w-3xl mx-auto px-6 py-8 md:py-10">
    {app && (
      <Breadcrumbs
        trail={[
          { name: ui.home, url: `/${lang}/` },
          { name: app.data.name, url: appHomeUrl },
          { name: article.data.title },
        ]}
      />
    )}
    <h1 class="mt-6 font-display font-normal text-[clamp(2rem,5vw,3.25rem)] tracking-[-0.012em] leading-[1.08]">
      {article.data.title}
    </h1>
    <p class="mt-3 text-lg text-ink-2">{article.data.description}</p>
    {/* See the Swedish twin — named authorship, previously absent. */}
    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-3">
      <span class="font-semibold text-ink">Alexander Bergqvist</span>
      <span aria-hidden>·</span>
      <time datetime={article.data.publishedAt.toISOString()}>
        {article.data.publishedAt.toLocaleDateString(LOCALE_BCP47[lang], {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
      {article.data.updatedAt && (
        <span class="text-ink-3">
          · {ui.updated} {article.data.updatedAt.toLocaleDateString(LOCALE_BCP47[lang])}
        </span>
      )}
    </div>

    {app && app.data.status === 'live' && localizedAppStoreUrl && (
      <a
        href={heroAppStoreUrl}
        data-cta-position="hero"
        target="_blank"
        rel="noopener"
        class="mt-6 flex items-center gap-3 rounded-xl border border-line p-3 md:p-4 no-underline transition hover:shadow-md"
        style={`background: linear-gradient(135deg, ${app.data.accent}14, var(--surface)); border-left: 4px solid ${app.data.accent};`}
      >
        <img
          src={app.data.icon}
          alt={`${app.data.name} icon`}
          width="48" height="48"
          class="w-12 h-12 rounded-xl flex-shrink-0"
          style={`background: ${app.data.accent};`}
          loading="lazy"
        />
        <div class="min-w-0">
          <div class="text-xs font-semibold uppercase tracking-wide text-ink-3">
            {ui.inGuide}
          </div>
          <div class="font-black leading-tight">{app.data.name}</div>
          <div class="text-sm text-ink-2 truncate">{app.data.tagline}</div>
        </div>
        {/* See the Swedish twin: white-on-raw-accent measured 2.0–3.0:1
            for four of the twelve apps. */}
        <span
          class="ml-auto flex-shrink-0 rounded-full bg-ink px-4 py-2 text-sm font-bold text-on-ink"
        >
          {ui.get}&nbsp;↗
        </span>
      </a>
    )}

    <div class="prose mt-8">
      <Content />
    </div>

    {article.data.faq && article.data.faq.length > 0 && (
      <FAQ items={article.data.faq} />
    )}

    <AuthorBox appName={app?.data.name} lang={lang} />

    {app && (
      <aside
        class="mt-12 rounded-2xl border border-line p-6 md:p-8 bg-gradient-to-br from-surface to-surface-2"
      >
        <div class="flex items-start gap-4">
          <img
            src={app.data.icon}
            alt={`${app.data.name}`}
            width="64" height="64"
            class="w-16 h-16 rounded-xl flex-shrink-0"
            style={`background: ${app.data.accent};`}
            loading="lazy"
          />
          <div class="flex-1">
            <div class="font-black text-lg">{app.data.name}</div>
            <p class="text-ink-2 text-sm mt-1">{app.data.tagline}</p>
            <div class="mt-4">
              <AppStoreBadge
                url={localizedAppStoreUrl}
                status={app.data.status}
              />
            </div>
          </div>
        </div>
      </aside>
    )}

    {related.length > 0 && (
      <section class="mt-12">
        <h2 class="text-xl font-black mb-4">{ui.readMore}</h2>
        <div class="grid md:grid-cols-2 gap-3">
          {related.map((r) => {
            const slug = r.id.split('/').pop();
            return (
              <a
                href={`/${lang}/${r.data.app}/${slug}/`}
                class="block rounded-xl border border-line p-4 hover:border-line-strong hover:shadow-md transition"
              >
                <div class="font-bold text-ink">{r.data.title}</div>
                <p class="text-sm text-ink-2 mt-1 line-clamp-2">
                  {r.data.description}
                </p>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {otherVersions.length > 0 && (
      <p class="mt-10 text-sm text-ink-2">
        <span class="font-bold text-ink">{ui.otherLangs}:</span>{' '}
        {otherVersions.map((v, i) => (
          <Fragment>
            {i > 0 && ' · '}
            <a href={v.path} hreflang={LOCALE_BCP47[v.lang]} lang={LOCALE_BCP47[v.lang]} class="underline">{v.label}</a>
          </Fragment>
        ))}
      </p>
    )}
  </article>
</BaseLayout>
