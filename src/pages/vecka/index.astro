---
/**
 * /vecka/ — "Vilken vecka är det?". ISO 8601 week number for today in
 * Europe/Stockholm. The HTML is rendered for the build day; the inline
 * script recomputes everything on load, and re-renders the year table
 * if the visitor is already in a later week-year than the build.
 */
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import AppCta from '../../components/namnsdag/AppCta.astro';
import {
  addDays,
  formatDayMonth,
  isoWeek,
  isoWeek1Monday,
  isoWeeksInYear,
  stockholmToday,
  type YMD,
} from '../../lib/datum';

const today = stockholmToday();
const { year, week } = isoWeek(today);
const weeks = isoWeeksInYear(year);
const monday = addDays(isoWeek1Monday(year), (week - 1) * 7);
const sunday = addDays(monday, 6);

const range = (a: YMD, b: YMD) =>
  a.y === b.y
    ? `${formatDayMonth(a)} – ${formatDayMonth(b)} ${b.y}`
    : `${formatDayMonth(a)} ${a.y} – ${formatDayMonth(b)} ${b.y}`;

const rows = Array.from({ length: weeks }, (_, i) => {
  const mon = addDays(isoWeek1Monday(year), i * 7);
  return { w: i + 1, mon, sun: addDays(mon, 6) };
});

const faq = [
  {
    q: 'Hur räknas veckonummer i Sverige?',
    a: 'Sverige följer den internationella standarden ISO 8601. En vecka börjar på måndag och slutar på söndag. Vecka 1 är den vecka som innehåller årets första torsdag – vilket är samma sak som att den innehåller 4 januari. Därför kan de första dagarna i januari höra till förra årets sista vecka, och de sista dagarna i december till nästa års vecka 1.',
  },
  {
    q: 'Har 2026 vecka 53?',
    a: 'Ja. 2026 börjar på en torsdag och har därför 53 veckor. Vecka 53 är 28 december 2026 – 3 januari 2027, så 1–3 januari 2027 hör till vecka 53 av 2026. Vecka 1 2027 börjar måndag 4 januari.',
  },
  {
    q: 'När har ett år 53 veckor?',
    a: 'Ett år har 53 veckor om det börjar på en torsdag, eller om det är ett skottår som börjar på en onsdag. Det händer ungefär vart femte till sjätte år. Övriga år har 52 veckor.',
  },
  {
    q: 'Varför visar en amerikansk kalender ett annat veckonummer?',
    a: 'I bland annat USA börjar veckan på söndag och vecka 1 är den vecka som innehåller 1 januari. Då kan veckonumret skilja sig med en vecka från det svenska. Kontrollera att kalenderappen i telefonen eller datorn är inställd på ISO-veckor om numren inte stämmer.',
  },
  {
    q: 'Är det jämn eller udda vecka nu?',
    a: 'Det står direkt under veckonumret högst upp på sidan. Jämna och udda veckor används ofta för varannan-vecka-scheman, till exempel boende för barn, sophämtning eller skiftarbete. Tänk på att två udda veckor kan följa efter varandra vid årsskiftet efter ett år med 53 veckor.',
  },
];
---

<BaseLayout
  title={`Vilken vecka är det? Veckonummer idag och alla veckor ${year}`}
  description={`Vilken vecka är det idag? Se dagens veckonummer, om det är jämn eller udda vecka och alla veckonummer ${year} med datum – enligt svensk standard (ISO 8601).`}
  keywords={[
    'vilken vecka är det',
    'vilken vecka är det idag',
    'veckonummer',
    `veckonummer ${year}`,
    'vecka idag',
    'jämn vecka',
  ]}
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs trail={[{ name: 'Hem', url: '/' }, { name: 'Vilken vecka är det?' }]} />
    <h1 class="mt-6 text-3xl md:text-5xl font-black tracking-tight">Vilken vecka är det?</h1>

    <div class="mt-6 rounded-2xl border border-line bg-surface-2 p-6 sm:p-8 text-center">
      <div class="text-sm font-black uppercase tracking-widest text-ink-3">Idag är det</div>
      <div class="mt-1 text-6xl sm:text-8xl font-black tracking-tight tabular-nums">
        vecka <span data-v="week">{week}</span>
      </div>
      <p class="mt-3 text-lg text-ink-2" data-v="range">{range(monday, sunday)}</p>
      <p class="mt-1 text-ink-2">
        <span data-v="parity">{week % 2 === 0 ? 'Jämn vecka' : 'Udda vecka'}</span>
        · nästa vecka: vecka <span data-v="next">{week === weeks ? 1 : week + 1}</span>
      </p>
    </div>

    <AppCta
      heading="Se veckonumret direkt på hemskärmen"
      text="Nyhet i Födelsedagar: en widget som visar veckonummer och datum på hemskärmen och låsskärmen – utan att du öppnar någon app."
    />

    <h2 class="mt-12 text-2xl font-black">
      Alla veckor <span data-v="year">{year}</span>
      <span class="text-base font-bold text-ink-3">(<span data-v="count">{weeks}</span> veckor)</span>
    </h2>
    <table class="w-full mt-4 border-collapse text-left">
      <thead>
        <tr class="border-b-2 border-line-strong">
          <th class="py-2 pr-3">Vecka</th>
          <th class="py-2">Datum (måndag – söndag)</th>
        </tr>
      </thead>
      <tbody data-v="table">
        {rows.map((r) => (
          <tr class={`border-b border-line ${r.w === week ? 'bg-pink-50 font-bold' : ''}`} data-v-week={r.w}>
            <td class="py-2 pr-3 font-bold tabular-nums">{r.w}</td>
            <td class="py-2">{range(r.mon, r.sun)}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <div class="prose mt-12">
      <h2>Så fungerar veckonummer</h2>
      <p>
        Veckonummer är ett svenskt (och nordeuropeiskt) sätt att planera: "vi
        ses vecka 42" är tydligare än ett datumintervall. Numreringen följer
        ISO 8601, där veckan börjar på måndag och vecka 1 är den första veckan
        som har minst fyra dagar i det nya året. Det gör att nästan alla år
        har 52 veckor, medan vissa år – som 2026 – får en vecka 53.
      </p>
      <p>
        Veckonumret och datumen ovan räknas ut för svensk tid när du öppnar
        sidan, så de stämmer även om sidan ligger kvar i en flik över
        midnatt – ladda bara om. Behöver du fler datum? Se
        <a href="/namnsdag/">dagens namnsdag</a>,
        <a href="/fodelsedagar/aldersrakna/">räkna ut en ålder</a> eller
        <a href="/fodelsedagar/veckodag-fodelsedag/">vilken veckodag du fyller år</a>.
      </p>
    </div>

    <FAQ items={faq} />
  </section>
</BaseLayout>

<script>
  import {
    addDays,
    formatDayMonth,
    isoWeek,
    isoWeek1Monday,
    isoWeeksInYear,
    stockholmToday,
    type YMD,
  } from '../../lib/datum';

  const range = (a: YMD, b: YMD) =>
    a.y === b.y
      ? `${formatDayMonth(a)} – ${formatDayMonth(b)} ${b.y}`
      : `${formatDayMonth(a)} ${a.y} – ${formatDayMonth(b)} ${b.y}`;
  const set = (k: string, v: string | number) => {
    const el = document.querySelector(`[data-v="${k}"]`);
    if (el) el.textContent = String(v);
  };

  const today = stockholmToday();
  const { year, week } = isoWeek(today);
  const weeks = isoWeeksInYear(year);
  const w1 = isoWeek1Monday(year);
  const monday = addDays(w1, (week - 1) * 7);
  set('week', week);
  set('range', range(monday, addDays(monday, 6)));
  set('parity', week % 2 === 0 ? 'Jämn vecka' : 'Udda vecka');
  set('next', week === weeks ? 1 : week + 1);

  const tbody = document.querySelector('[data-v="table"]');
  if (tbody && document.querySelector('[data-v="year"]')?.textContent !== String(year)) {
    set('year', year);
    set('count', weeks);
    tbody.textContent = '';
    for (let w = 1; w <= weeks; w++) {
      const mon = addDays(w1, (w - 1) * 7);
      const tr = document.createElement('tr');
      tr.className = 'border-b border-line';
      tr.dataset.vWeek = String(w);
      const a = document.createElement('td');
      a.className = 'py-2 pr-3 font-bold tabular-nums';
      a.textContent = String(w);
      const b = document.createElement('td');
      b.className = 'py-2';
      b.textContent = range(mon, addDays(mon, 6));
      tr.append(a, b);
      tbody.append(tr);
    }
  }
  document.querySelectorAll<HTMLElement>('[data-v-week]').forEach((tr) => {
    const on = Number(tr.dataset.vWeek) === week;
    tr.classList.toggle('bg-pink-50', on);
    tr.classList.toggle('font-bold', on);
  });
</script>
