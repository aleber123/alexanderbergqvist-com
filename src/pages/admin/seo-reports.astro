---
/**
 * Admin SEO Reports dashboard for alexanderbergqvist.com.
 *
 * Renders an interactive UI that calls /api/admin/seo-report with the
 * stored admin password (kept in localStorage after first prompt). All
 * fetching happens client-side so the page itself doesn't need to know
 * any secrets at render time — Vercel ships the static HTML, and the
 * API does the auth check.
 *
 * Marked `prerender = false` so Astro doesn't try to statically build
 * this at build time (it'd fail because the API uses runtime env vars).
 */
export const prerender = false;

import BaseLayout from '../../components/BaseLayout.astro';
---

<BaseLayout
  title="SEO Reports — Admin"
  description="Internal SEO reporting dashboard"
  noindex={true}
>
  <section class="max-w-5xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-bold mb-2">SEO Reports</h1>
    <p class="text-sm text-gray-600 mb-8">
      Live data från Google Search Console + GA4 för
      alexanderbergqvist.com.
    </p>

    <div id="auth-gate" class="hidden">
      <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-6 max-w-md">
        <h2 class="font-bold mb-2">Admin-lösenord krävs</h2>
        <p class="text-sm mb-4">
          Skriv in lösenordet du satte i Vercel-miljövariabeln
          <code class="bg-yellow-100 px-1 rounded">ADMIN_PASSWORD</code>.
        </p>
        <input
          id="pwd-input"
          type="password"
          class="w-full px-3 py-2 border rounded mb-2"
          placeholder="Lösenord"
        />
        <button
          id="pwd-submit"
          class="bg-black text-white px-4 py-2 rounded font-semibold w-full"
        >
          Logga in
        </button>
        <p id="pwd-error" class="hidden text-red-600 text-sm mt-2"></p>
      </div>
    </div>

    <div id="dashboard" class="hidden">
      <div class="flex flex-wrap items-center gap-3 mb-6 border-b pb-4">
        <label class="text-sm font-semibold">Period:</label>
        <select id="days" class="border rounded px-2 py-1">
          <option value="7">7 dagar</option>
          <option value="28" selected>28 dagar</option>
          <option value="90">90 dagar</option>
        </select>
        <label class="text-sm font-semibold ml-4">Antal rader:</label>
        <select id="limit" class="border rounded px-2 py-1">
          <option value="10">10</option>
          <option value="25" selected>25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
        <button
          id="logout"
          class="ml-auto text-sm text-gray-500 underline"
        >
          Logga ut
        </button>
      </div>

      <div class="flex flex-wrap gap-2 mb-6">
        <button data-type="expert" class="report-btn">
          🧠 SEO Expert
        </button>
        <button data-type="queries" class="report-btn">
          🔎 Toppsökord
        </button>
        <button data-type="pages" class="report-btn">
          📄 Toppsidor
        </button>
        <button data-type="page-queries" class="report-btn">
          🎯 Sökord per sida
        </button>
        <button data-type="ga-channels" class="report-btn">
          📊 GA: Trafikkällor
        </button>
        <button data-type="ga-pages" class="report-btn">
          📈 GA: Toppsidor
        </button>
        <button data-type="index-status" class="report-btn">
          🔍 Indexerings-status
        </button>
      </div>

      <div id="page-filter" class="hidden mb-4">
        <label class="block text-sm font-semibold mb-1">URL att filtrera på:</label>
        <input
          id="page-input"
          type="text"
          placeholder="https://alexanderbergqvist.com/fodelsedagar/"
          class="w-full px-3 py-2 border rounded"
        />
        <button id="page-go" class="mt-2 bg-black text-white px-4 py-1 rounded">
          Hämta
        </button>
      </div>

      <div id="status" class="text-sm text-gray-500 mb-4"></div>

      <div id="insights" class="mb-8"></div>

      <div id="data-table" class="overflow-x-auto"></div>
    </div>
  </section>

  <style>
    .report-btn {
      padding: 0.5rem 1rem;
      background: #f3f4f6;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }
    .report-btn:hover {
      background: #e5e7eb;
    }
    .report-btn.active {
      background: #111;
      color: #fff;
      border-color: #111;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    th,
    td {
      padding: 8px 12px;
      text-align: left;
      border-bottom: 1px solid #e5e7eb;
    }
    th {
      background: #f9fafb;
      font-weight: 600;
      position: sticky;
      top: 0;
    }
    .num {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }
    .insight {
      padding: 12px 16px;
      border-radius: 10px;
      margin-bottom: 8px;
      font-size: 14px;
    }
    .insight.high {
      background: #fef2f2;
      border: 1px solid #fecaca;
    }
    .insight.med {
      background: #fff7ed;
      border: 1px solid #fed7aa;
    }
    .insight.low {
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
    }
    .insight-action {
      margin-top: 4px;
      font-size: 12px;
      color: #555;
      font-style: italic;
    }
  </style>

  <script is:inline>
    const STORAGE_KEY = 'alexbg_admin_pwd';

    const authGate = document.getElementById('auth-gate');
    const dashboard = document.getElementById('dashboard');
    const pwdInput = document.getElementById('pwd-input');
    const pwdSubmit = document.getElementById('pwd-submit');
    const pwdError = document.getElementById('pwd-error');
    const logout = document.getElementById('logout');
    const daysSelect = document.getElementById('days');
    const limitSelect = document.getElementById('limit');
    const pageFilter = document.getElementById('page-filter');
    const pageInput = document.getElementById('page-input');
    const pageGo = document.getElementById('page-go');
    const status = document.getElementById('status');
    const insightsDiv = document.getElementById('insights');
    const tableDiv = document.getElementById('data-table');

    let currentType = null;

    function show(el) { el.classList.remove('hidden'); }
    function hide(el) { el.classList.add('hidden'); }

    function showAuth() {
      show(authGate);
      hide(dashboard);
    }

    function showDashboard() {
      hide(authGate);
      show(dashboard);
    }

    function getPwd() {
      return localStorage.getItem(STORAGE_KEY) || '';
    }

    if (getPwd()) showDashboard();
    else showAuth();

    pwdSubmit.addEventListener('click', async () => {
      const pwd = pwdInput.value.trim();
      if (!pwd) return;
      // Try a cheap call to verify password
      const res = await fetch('/api/admin/seo-report', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-admin-password': pwd,
        },
        body: JSON.stringify({ type: 'queries', days: 7, limit: 1 }),
      });
      if (res.status === 401) {
        pwdError.textContent = 'Fel lösenord.';
        show(pwdError);
        return;
      }
      localStorage.setItem(STORAGE_KEY, pwd);
      showDashboard();
    });

    pwdInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') pwdSubmit.click();
    });

    logout.addEventListener('click', () => {
      localStorage.removeItem(STORAGE_KEY);
      showAuth();
    });

    document.querySelectorAll('.report-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.report-btn').forEach((b) =>
          b.classList.remove('active'),
        );
        btn.classList.add('active');
        currentType = btn.dataset.type;
        if (currentType === 'page-queries') {
          show(pageFilter);
          insightsDiv.innerHTML = '';
          tableDiv.innerHTML = '';
          status.textContent = 'Skriv in en URL ovan och tryck Hämta.';
        } else if (currentType === 'index-status') {
          hide(pageFilter);
          fetchIndexStatus();
        } else {
          hide(pageFilter);
          fetchReport();
        }
      });
    });

    daysSelect.addEventListener('change', () => {
      if (currentType) fetchReport();
    });
    limitSelect.addEventListener('change', () => {
      if (currentType) fetchReport();
    });
    pageGo.addEventListener('click', fetchReport);

    async function fetchReport() {
      const body = {
        type: currentType,
        days: Number(daysSelect.value),
        limit: Number(limitSelect.value),
      };
      if (currentType === 'page-queries') {
        body.page = pageInput.value.trim();
        if (!body.page) {
          status.textContent = 'Skriv in en URL först.';
          return;
        }
      }
      status.textContent = 'Hämtar...';
      insightsDiv.innerHTML = '';
      tableDiv.innerHTML = '';
      // Expert uses a different endpoint that joins GSC + GA4 + ASC
      const endpoint =
        currentType === 'expert'
          ? '/api/admin/seo-expert'
          : '/api/admin/seo-report';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-admin-password': getPwd(),
          },
          body: JSON.stringify(body),
        });
        if (res.status === 401) {
          localStorage.removeItem(STORAGE_KEY);
          showAuth();
          return;
        }
        const data = await res.json();
        if (!res.ok) {
          status.textContent = `Fel: ${data.error || 'okänt'}`;
          return;
        }
        if (currentType === 'expert') {
          renderExpertStatus(data);
          renderInsights(data.insights || []);
          renderExpertTable(data.apps || []);
        } else {
          status.textContent = `${data.rows.length} rader, ${data.range.days} dagar (${data.range.startDate} → ${data.range.endDate})`;
          renderInsights(data.insights || []);
          renderTable(currentType, data.rows);
        }
      } catch (e) {
        status.textContent = `Nätverksfel: ${e.message}`;
      }
    }

    function renderExpertStatus(data) {
      const src = data.sources;
      let ascStr;
      if (src.asc.ok) {
        const sr = src.asc.salesRange;
        const subs = src.asc.subscriptions;
        ascStr = '✓ ' + src.asc.appCount + ' appar';
        if (sr) {
          ascStr += `, ${sr.rowCount} sales-rader (${sr.daysFetched}/${sr.daysFetched + sr.daysSkipped} dagar)`;
        }
        if (subs && subs.date) {
          ascStr += `, subs-snapshot ${subs.date} (${subs.rowCount} rader)`;
        } else if (subs) {
          ascStr += ', subs: ingen data tillgänglig än';
        }
      } else {
        ascStr = '✗ ' + (src.asc.error || '');
      }
      const parts = [
        `${data.apps.length} appar`,
        `${data.range.days} dagar (${data.range.startDate} → ${data.range.endDate})`,
        `GSC: ${src.gsc.ok ? '✓ ' + src.gsc.rowCount + ' rader' : '✗ ' + (src.gsc.error || '')}`,
        `GA4: ${src.ga4.ok ? '✓ ' + src.ga4.rowCount + ' sidor' : '✗ ' + (src.ga4.error || '')}`,
        `ASC: ${ascStr}`,
      ];
      status.innerHTML = parts.join(' · ');
    }

    function renderExpertTable(apps) {
      if (!apps.length) {
        tableDiv.innerHTML = '<p>Ingen data.</p>';
        return;
      }
      const cols = [
        'App',
        'GSC klick',
        'GA sessions',
        'Bounce %',
        'Installs',
        'Trials',
        'Subs',
        'MRR',
        'Install→Sub %',
      ];
      const html =
        '<table><thead><tr>' +
        cols
          .map((c, i) => `<th${i > 0 ? ' class="num"' : ''}>${c}</th>`)
          .join('') +
        '</tr></thead><tbody>' +
        apps
          .map((a, appIdx) => {
            const mrrStr = a.ascMrr
              ? a.ascMrr.toFixed(0) + ' ' + a.ascMrrCurrency
              : '–';
            const convStr = a.ascUnits
              ? (a.installToSubConversion * 100).toFixed(2) + '%'
              : '–';
            const hasArticles = a.topArticles && a.topArticles.length > 0;
            const caret = hasArticles ? '▸' : '·';
            const cls = hasArticles ? 'cursor-pointer expert-row' : 'expert-row';
            return (
              `<tr class="${cls}" data-app-idx="${appIdx}" title="${hasArticles ? 'Klicka för per-artikel breakdown' : ''}">` +
              `<td><span class="caret">${caret}</span> ${escapeHtml(a.name)}</td>` +
              `<td class="num">${a.gscClicks}</td>` +
              `<td class="num">${a.gaSessions}</td>` +
              `<td class="num">${a.gaSessions ? (a.gaBounceRate * 100).toFixed(0) : '–'}</td>` +
              `<td class="num">${a.ascUnits}</td>` +
              `<td class="num">${a.ascFreeTrials || '–'}</td>` +
              `<td class="num"><strong>${a.ascActiveSubs || '–'}</strong></td>` +
              `<td class="num"><strong>${mrrStr}</strong></td>` +
              `<td class="num">${convStr}</td>` +
              '</tr>' +
              (hasArticles
                ? `<tr class="article-detail hidden" data-app-idx="${appIdx}"><td colspan="${cols.length}">${renderArticleBreakdown(a)}</td></tr>`
                : '')
            );
          })
          .join('') +
        '</tbody></table>';
      // Add MRR total row at the bottom
      const totalMrr = apps.reduce((s, a) => s + (a.ascMrr || 0), 0);
      const totalSubs = apps.reduce((s, a) => s + (a.ascActiveSubs || 0), 0);
      const totalInstalls = apps.reduce((s, a) => s + (a.ascUnits || 0), 0);
      const currency = apps.find((a) => a.ascMrr > 0)?.ascMrrCurrency || 'USD';
      const summary =
        '<div style="margin-top:12px;padding:12px;background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0;font-weight:600;">' +
        `Total portfolio: <strong>${totalMrr.toFixed(0)} ${currency}/mån</strong> MRR · ` +
        `${totalSubs} betalande prenumeranter · ` +
        `${totalInstalls} installs (28 dagar)` +
        '</div>';
      tableDiv.innerHTML = html + summary;
      // Wire up drill-down toggle for app rows that have per-article data
      tableDiv.querySelectorAll('tr.expert-row[title]').forEach((row) => {
        row.addEventListener('click', () => {
          const idx = row.getAttribute('data-app-idx');
          const detail = tableDiv.querySelector(
            `tr.article-detail[data-app-idx="${idx}"]`,
          );
          if (!detail) return;
          const isOpen = !detail.classList.contains('hidden');
          detail.classList.toggle('hidden', isOpen);
          const caret = row.querySelector('.caret');
          if (caret) caret.textContent = isOpen ? '▸' : '▾';
        });
      });
      // Wire up "copy URL" on individual article rows in the drill-down
      tableDiv.querySelectorAll('tr.article-row').forEach((row) => {
        row.addEventListener('click', (e) => {
          e.stopPropagation();
          const u = row.getAttribute('data-url');
          if (!u) return;
          navigator.clipboard?.writeText(u);
          const cells = row.querySelectorAll('td');
          cells.forEach((c) => (c.style.background = '#fef3c7'));
          setTimeout(
            () => cells.forEach((c) => (c.style.background = '')),
            600,
          );
        });
      });
    }

    function renderArticleBreakdown(app) {
      const arts = app.topArticles || [];
      if (!arts.length) return '<p class="text-sm text-gray-500">Ingen sökdata för denna app.</p>';
      const mrrCurrency = app.ascMrrCurrency || 'USD';
      const head = `
        <div style="padding:12px;background:#fafafa;border-radius:8px;border:1px solid #e5e7eb">
          <div style="font-size:12px;color:#666;margin-bottom:8px">
            ${arts.length} artiklar med sökdata. Klick → kopiera URL.
            <span style="margin-left:8px;color:#999">
              Uppskattat MRR-bidrag = artikelns andel av appens sökklick × appens totala MRR
              (${(app.ascMrr || 0).toFixed(0)} ${mrrCurrency}/mån)
            </span>
          </div>
          <table style="font-size:12px">
            <thead><tr>
              <th>Artikel</th>
              <th class="num">Klick</th>
              <th class="num">Exp</th>
              <th class="num">CTR %</th>
              <th class="num">Pos</th>
              <th class="num">GA sess.</th>
              <th class="num">Andel</th>
              <th class="num">~MRR-bidrag</th>
            </tr></thead><tbody>
            ${arts
              .map(
                (ar) => `
              <tr class="article-row" data-url="https://alexanderbergqvist.com${escapeHtml(ar.path)}" style="cursor:pointer" title="Klicka för att kopiera URL">
                <td>${escapeHtml(ar.path)}</td>
                <td class="num">${ar.gscClicks}</td>
                <td class="num">${ar.gscImpressions}</td>
                <td class="num">${(ar.gscCtr * 100).toFixed(1)}</td>
                <td class="num">${ar.gscAvgPosition.toFixed(1)}</td>
                <td class="num">${ar.gaSessions}</td>
                <td class="num">${(ar.shareOfAppClicks * 100).toFixed(0)}%</td>
                <td class="num">${ar.estimatedMrrContribution > 0 ? ar.estimatedMrrContribution.toFixed(1) + ' ' + mrrCurrency : '–'}</td>
              </tr>`,
              )
              .join('')}
          </tbody></table>
        </div>
      `;
      return head;
    }

    function renderInsights(insights) {
      if (!insights.length) return;
      insightsDiv.innerHTML =
        '<h3 class="font-bold mb-2 mt-4">Insikter</h3>' +
        insights
          .map(
            (i) => `
            <div class="insight ${i.severity}">
              <div><strong>${i.icon} ${escapeHtml(i.title)}</strong></div>
              <div>${escapeHtml(i.detail)}</div>
              ${i.action ? `<div class="insight-action">→ ${escapeHtml(i.action)}</div>` : ''}
            </div>
          `,
          )
          .join('');
    }

    function renderTable(type, rows) {
      if (!rows.length) {
        tableDiv.innerHTML = '<p>Ingen data.</p>';
        return;
      }
      let cols, mapRow;
      if (type === 'queries' || type === 'page-queries') {
        cols = ['Sökord', 'Klick', 'Exp', 'CTR %', 'Pos'];
        mapRow = (r) => [
          escapeHtml(r.keys[0]),
          r.clicks,
          r.impressions,
          (r.ctr * 100).toFixed(1),
          r.position.toFixed(1),
        ];
      } else if (type === 'pages') {
        cols = ['Sida', 'Klick', 'Exp', 'CTR %', 'Pos'];
        mapRow = (r) => [
          escapeHtml(r.keys[0].replace('https://alexanderbergqvist.com', '')),
          r.clicks,
          r.impressions,
          (r.ctr * 100).toFixed(1),
          r.position.toFixed(1),
        ];
      } else if (type === 'ga-channels') {
        cols = ['Kanal', 'Sessions', 'Användare', 'Sidvisn.', 'Bounce %', 'Engagemang %'];
        mapRow = (r) => [
          escapeHtml(r.channel),
          r.sessions,
          r.users,
          r.pageviews,
          (r.bounceRate * 100).toFixed(0),
          (r.engagementRate * 100).toFixed(0),
        ];
      } else if (type === 'ga-pages') {
        cols = ['Sida', 'Sidvisn.', 'Användare', 'Bounce %', 'Engagemang %'];
        mapRow = (r) => [
          escapeHtml(r.page),
          r.pageviews,
          r.users,
          (r.bounceRate * 100).toFixed(0),
          (r.engagementRate * 100).toFixed(0),
        ];
      }
      tableDiv.innerHTML =
        '<table><thead><tr>' +
        cols.map((c, i) => `<th${i > 0 ? ' class="num"' : ''}>${c}</th>`).join('') +
        '</tr></thead><tbody>' +
        rows
          .map((r) => {
            const cells = mapRow(r);
            return (
              '<tr>' +
              cells
                .map((c, i) => `<td${i > 0 ? ' class="num"' : ''}>${c}</td>`)
                .join('') +
              '</tr>'
            );
          })
          .join('') +
        '</tbody></table>';
    }

    // ─── Index Status (URL Inspection batch) ──────────────────────────
    // Fetches all URLs from sitemap, runs them in chunks of 30 against
    // the GSC URL Inspection API, then renders a filterable table that
    // makes it easy to see which pages aren't indexed yet (for "Request
    // Indexing" workflow).
    async function fetchIndexStatus() {
      insightsDiv.innerHTML = '';
      tableDiv.innerHTML = '';
      status.textContent = 'Hämtar sitemap…';

      let urls = [];
      try {
        const smRes = await fetch('/sitemap-0.xml');
        const xml = await smRes.text();
        urls = Array.from(xml.matchAll(/<loc>([^<]+)<\/loc>/g))
          .map((m) => m[1])
          .filter((u) => u.startsWith('https://alexanderbergqvist.com'));
        urls = Array.from(new Set(urls));
      } catch (e) {
        status.textContent = 'Kunde inte hämta sitemap: ' + e.message;
        return;
      }

      if (urls.length === 0) {
        status.textContent = 'Inga URLs i sitemap.';
        return;
      }

      const chunkSize = 30;
      const chunks = [];
      for (let i = 0; i < urls.length; i += chunkSize) {
        chunks.push(urls.slice(i, i + chunkSize));
      }

      const results = [];
      let done = 0;
      // Render filter UI first so user can see incremental progress
      renderIndexStatusShell();

      for (const chunk of chunks) {
        status.textContent =
          `Inspekterar ${done}/${urls.length} URLs (Google rate-limit ~4 URLs/sek)…`;
        try {
          const res = await fetch('/api/admin/seo-report', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'x-admin-password': getPwd(),
            },
            body: JSON.stringify({ type: 'index-status', urls: chunk }),
          });
          if (res.status === 401) {
            localStorage.removeItem(STORAGE_KEY);
            showAuth();
            return;
          }
          const data = await res.json();
          if (!res.ok) {
            status.textContent = `Fel: ${data.error || 'okänt'}`;
            return;
          }
          results.push(...data.results);
          done += chunk.length;
          renderIndexStatusTable(results);
        } catch (e) {
          status.textContent = `Nätverksfel: ${e.message}`;
          return;
        }
      }

      const notIndexed = results.filter(
        (r) => r.verdict !== 'PASS' && !r.error,
      ).length;
      const indexed = results.filter((r) => r.verdict === 'PASS').length;
      const errors = results.filter((r) => r.error).length;
      status.textContent =
        `Klart. ${indexed} indexerade · ${notIndexed} ej indexerade · ` +
        `${errors} fel · ${results.length} totalt`;
    }

    function renderIndexStatusShell() {
      insightsDiv.innerHTML = `
        <div class="flex gap-2 mb-3">
          <button id="filter-all" class="report-btn active">Alla</button>
          <button id="filter-not-indexed" class="report-btn">Ej indexerade</button>
          <button id="filter-indexed" class="report-btn">Indexerade</button>
        </div>
        <p class="text-xs text-gray-500 mb-2">
          Klick på rad kopierar URL till urklipp så du kan klistra in
          i GSC URL Inspection och "Begär indexering".
        </p>
      `;
      document.getElementById('filter-all').addEventListener('click', () => {
        setIndexFilter('all');
      });
      document.getElementById('filter-not-indexed').addEventListener('click', () => {
        setIndexFilter('not-indexed');
      });
      document.getElementById('filter-indexed').addEventListener('click', () => {
        setIndexFilter('indexed');
      });
    }

    let indexStatusResults = [];
    let indexStatusFilter = 'all';

    function setIndexFilter(f) {
      indexStatusFilter = f;
      ['all', 'not-indexed', 'indexed'].forEach((id) => {
        document
          .getElementById('filter-' + id)
          ?.classList.toggle('active', id === f);
      });
      renderIndexStatusTable(indexStatusResults);
    }

    function renderIndexStatusTable(results) {
      indexStatusResults = results;
      let filtered = results;
      if (indexStatusFilter === 'not-indexed') {
        filtered = results.filter(
          (r) => r.verdict !== 'PASS' && !r.error,
        );
      } else if (indexStatusFilter === 'indexed') {
        filtered = results.filter((r) => r.verdict === 'PASS');
      }
      if (!filtered.length) {
        tableDiv.innerHTML = '<p class="text-sm text-gray-500">Inga URLs i denna kategori.</p>';
        return;
      }
      const html =
        '<table><thead><tr>' +
        '<th>Status</th><th>URL</th><th>Coverage</th><th>Senast crawlad</th>' +
        '</tr></thead><tbody>' +
        filtered
          .map((r) => {
            const path = r.url.replace('https://alexanderbergqvist.com', '');
            const icon = r.error
              ? '⚠️'
              : r.verdict === 'PASS'
                ? '🟢'
                : r.verdict === 'PARTIAL'
                  ? '🟡'
                  : '🔴';
            const crawl = r.lastCrawlTime
              ? new Date(r.lastCrawlTime).toISOString().slice(0, 10)
              : '–';
            const cov = r.error
              ? r.error.slice(0, 80)
              : r.coverageState || '(ingen data)';
            return (
              `<tr style="cursor:pointer" data-url="${escapeHtml(r.url)}" title="Klicka för att kopiera URL">` +
              `<td>${icon}</td>` +
              `<td>${escapeHtml(path)}</td>` +
              `<td>${escapeHtml(cov)}</td>` +
              `<td>${crawl}</td>` +
              '</tr>'
            );
          })
          .join('') +
        '</tbody></table>';
      tableDiv.innerHTML = html;
      tableDiv.querySelectorAll('tr[data-url]').forEach((row) => {
        row.addEventListener('click', () => {
          const u = row.getAttribute('data-url');
          navigator.clipboard?.writeText(u);
          row.style.background = '#fef3c7';
          setTimeout(() => (row.style.background = ''), 600);
        });
      });
    }

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
  </script>
</BaseLayout>
