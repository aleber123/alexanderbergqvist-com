---
/**
 * /namnsdag/<månad>/ — every name day in one month. Weekdays are rendered
 * for the build year and recomputed client-side for the current year
 * (Europe/Stockholm); today's row is highlighted.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AppCta from '../../components/namnsdag/AppCta.astro';
import Kalla from '../../components/namnsdag/Kalla.astro';
import {
  MANADER,
  VECKODAGAR,
  isoWeekday,
  isLeapYear,
  mdKey,
  stockholmToday,
} from '../../lib/datum';
import { NAMNLOSA_DAGAR, monthUrl, nameUrl, namesForKey } from '../../lib/namnsdag';

export const getStaticPaths = (() =>
  MANADER.map((manad, i) => ({ params: { manad }, props: { m: i + 1 } }))) satisfies GetStaticPaths;

const { m } = Astro.props as { m: number };
const manad = MANADER[m - 1];
const Manad = manad.charAt(0).toUpperCase() + manad.slice(1);
const year = stockholmToday().y;
// Always list 29 February (it is a named-less day in every year), so the
// table does not change shape between leap and common years.
const daysInMonth = m === 2 ? 29 : new Date(Date.UTC(2024, m, 0)).getUTCDate();

const rows = Array.from({ length: daysInMonth }, (_, i) => {
  const d = i + 1;
  const key = mdKey({ m, d });
  return { d, key, names: namesForKey(key), reason: NAMNLOSA_DAGAR[key] };
});
const nameCount = rows.reduce((n, r) => n + r.names.length, 0);
const hasAdditions = rows.some((r) => r.names.some((x) => x.from2027));
const sample = rows
  .flatMap((r) => r.names.map((x) => x.name))
  .slice(0, 4)
  .join(', ');

const prev = m === 1 ? 12 : m - 1;
const next = m === 12 ? 1 : m + 1;
---

<BaseLayout
  title={`Namnsdagar i ${manad} ${year} – alla namn och datum`}
  description={`Alla namnsdagar i ${manad} ${year} dag för dag: ${sample} och ${nameCount - 4} namn till, med veckodag. Enligt den svenska almanackan.`}
  keywords={[`namnsdagar ${manad}`, `namnsdagar ${manad} ${year}`, `namnsdag ${manad}`, 'namnsdagar']}
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs
      trail={[
        { name: 'Hem', url: '/' },
        { name: 'Namnsdagar', url: '/namnsdag/' },
        { name: Manad },
      ]}
    />
    <h1 class="mt-6 text-3xl md:text-5xl font-black tracking-tight">
      Namnsdagar i {manad} <span data-nd-year>{year}</span>
    </h1>
    <p class="mt-3 text-lg text-ink-2">
      {nameCount} namn har namnsdag i {manad}. Tryck på ett namn för att se
      vilka som delar dagen och hur länge det är kvar.
      {hasAdditions && ' Namn märkta ”från 2027” är nya i almanackan och firas första gången 2027.'}
    </p>

    <table class="w-full mt-8 border-collapse text-left">
      <thead>
        <tr class="border-b-2 border-line-strong">
          <th class="py-2 pr-3">Datum</th>
          <th class="py-2 pr-3">Veckodag</th>
          <th class="py-2">Namn</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => {
          const leapOnly = m === 2 && r.d === 29;
          const wd = leapOnly && !isLeapYear(year) ? '–' : VECKODAGAR[isoWeekday({ y: year, m, d: r.d }) - 1];
          return (
            <tr class="border-b border-line align-top" data-nd-row={r.d}>
              <td class="py-2 pr-3 font-bold whitespace-nowrap">{r.d} {manad.slice(0, 3)}</td>
              <td class="py-2 pr-3 text-ink-3" data-nd-wd>{wd}</td>
              <td class="py-2">
                {r.names.length > 0
                  ? r.names.map((x, i) => (
                      <Fragment>
                        {i > 0 && ', '}
                        <a href={nameUrl(x.name)} class="font-bold underline">{x.name}</a>
                        {x.from2027 && <span class="text-xs text-ink-3"> (från 2027)</span>}
                      </Fragment>
                    ))
                  : <span class="text-ink-3">{r.reason}{leapOnly && ' – bara skottår'}</span>}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>

    <AppCta
      heading="Glöm aldrig en namnsdag"
      text="Födelsedagar (gratis) visar dagens namnsdagar och påminner dig när någon du bryr dig om har namnsdag."
    />

    <nav class="mt-10 flex justify-between gap-4 font-bold">
      <a href={monthUrl(prev)} class="underline text-ink-2">← {MANADER[prev - 1]}</a>
      <a href="/namnsdag/" class="underline text-ink-2">Dagens namnsdag</a>
      <a href={monthUrl(next)} class="underline text-ink-2">{MANADER[next - 1]} →</a>
    </nav>

    <Kalla />
  </section>
</BaseLayout>

<script>
  import { isLeapYear, isoWeekday, stockholmToday, VECKODAGAR } from '../../lib/datum';
  import { MANADER } from '../../lib/datum';

  const today = stockholmToday();
  const manad = location.pathname.split('/').filter(Boolean)[1];
  const m = MANADER.indexOf(manad as (typeof MANADER)[number]) + 1;
  if (m > 0) {
    const y = today.y;
    document.querySelectorAll<HTMLElement>('[data-nd-year]').forEach((el) => (el.textContent = String(y)));
    document.querySelectorAll<HTMLTableRowElement>('[data-nd-row]').forEach((row) => {
      const d = Number(row.dataset.ndRow);
      const wd = row.querySelector('[data-nd-wd]');
      if (wd) {
        wd.textContent = m === 2 && d === 29 && !isLeapYear(y) ? '–' : VECKODAGAR[isoWeekday({ y, m, d }) - 1];
      }
      if (m === today.m && d === today.d) {
        row.classList.add('bg-pink-50');
        wd?.append(' (idag)');
      }
    });
  }
</script>
